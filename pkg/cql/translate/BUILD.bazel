load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "translate",
    srcs = ["translate.go"],
    importpath = "github.com/cockroachdb/cockroach/pkg/cql/translate",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/cql/parser",
        "@com_github_cockroachdb_errors//:errors",
    ],
)

go_test(
    name = "translate_test",
    srcs = ["translate_test.go"],
    embed = [":translate"],
    deps = [
        "//pkg/cql/parser",
        "@com_github_stretchr_testify//require",
    ],
)
