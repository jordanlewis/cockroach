exec
USE defaultdb
----

# ---------------------------------------------------------------
# Setup: create table used by DELETE tests.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_del (k int PRIMARY KEY, v int, v1 int, v2 int)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (1, 10, 100, 200)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (2, 20, 300, 400)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (3, 30, 500, 600)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (4, 40, 700, 800)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (5, 50, 900, 1000)
----

exec
INSERT INTO jd_del (k, v, v1, v2) VALUES (6, 60, 1100, 1200)
----

# ---------------------------------------------------------------
# Basic DELETE FROM ... WHERE.
# ---------------------------------------------------------------

exec
DELETE FROM jd_del WHERE k = 1
----

query
SELECT * FROM jd_del WHERE k = 1
----
k v v1 v2

# ---------------------------------------------------------------
# DELETE with IF EXISTS.
# ---------------------------------------------------------------

exec
DELETE FROM jd_del WHERE k = 2 IF EXISTS
----

query
SELECT * FROM jd_del WHERE k = 2
----
k v v1 v2

# DELETE IF EXISTS on non-existent row (no-op).
exec
DELETE FROM jd_del WHERE k = 999 IF EXISTS
----

# ---------------------------------------------------------------
# DELETE with IF condition (lightweight transaction).
# ---------------------------------------------------------------

exec
DELETE FROM jd_del WHERE k = 3 IF v = 30
----

query
SELECT * FROM jd_del WHERE k = 3
----
k v v1 v2

exec
DELETE FROM jd_del WHERE k = 4 IF v1 = 700 AND v2 = 800
----

query
SELECT * FROM jd_del WHERE k = 4
----
k v v1 v2

# ---------------------------------------------------------------
# DELETE with USING TIMESTAMP (parsed but silently ignored).
# ---------------------------------------------------------------

exec
DELETE FROM jd_del USING TIMESTAMP 1 WHERE k = 5
----

query
SELECT * FROM jd_del WHERE k = 5
----
k v v1 v2

exec
DELETE FROM jd_del USING TIMESTAMP 3 WHERE k = 6
----

query
SELECT * FROM jd_del WHERE k = 6
----
k v v1 v2

# ---------------------------------------------------------------
# Column-level DELETE (tombstone semantics — sets column to NULL).
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_del_col (k int PRIMARY KEY, v text, m map<int, text>)
----

exec
INSERT INTO jd_del_col (k, v) VALUES (1, 'hello')
----

exec
DELETE v FROM jd_del_col WHERE k = 1
----

query
SELECT k, v FROM jd_del_col WHERE k = 1
----
k v
1 NULL

# ---------------------------------------------------------------
# Keyspace-qualified column deletion (from DeleteSelectorTest).
# ---------------------------------------------------------------

exec
INSERT INTO jd_del_col (k, v) VALUES (2, 'world')
----

exec
DELETE v FROM defaultdb.jd_del_col WHERE k = 2
----

query
SELECT k, v FROM jd_del_col WHERE k = 2
----
k v
2 NULL

# ---------------------------------------------------------------
# Field deletion — UDT field (from DeleteSelectorTest).
# Dot notation in DELETE selector is unsupported.
# ---------------------------------------------------------------

error
DELETE address.street FROM jd_del_col WHERE k = 1
----
at position 14: expected FROM, got "."

# ---------------------------------------------------------------
# Element deletion — subscript in DELETE selector (from DeleteSelectorTest).
# ---------------------------------------------------------------

error
DELETE m[1] FROM jd_del_col WHERE k = 1
----
at position 8: expected FROM, got "["

# ---------------------------------------------------------------
# DELETE column with USING TIMESTAMP (from DeleteTimestampTest).
# ---------------------------------------------------------------

exec
INSERT INTO jd_del_col (k, v) VALUES (3, 'test')
----

exec
DELETE v FROM jd_del_col USING TIMESTAMP 1 WHERE k = 3
----

query
SELECT k, v FROM jd_del_col WHERE k = 3
----
k v
3 NULL

# ---------------------------------------------------------------
# IF condition with field access (from DeleteFluentConditionTest).
# ---------------------------------------------------------------

error
DELETE FROM jd_del_col WHERE k = 1 IF v.f = 1
----
at position 39: expected comparison operator, got "."

# ---------------------------------------------------------------
# IF condition with element access (from DeleteFluentConditionTest).
# ---------------------------------------------------------------

error
DELETE FROM jd_del_col WHERE k = 1 IF v[1] = 1
----
at position 39: expected comparison operator, got "["

# ---------------------------------------------------------------
# DELETE with function in WHERE (from DeleteIdempotenceTest).
# ---------------------------------------------------------------

error
DELETE FROM jd_del_col WHERE k = non_idempotent_func()
----
translating WHERE value: unsupported CQL function "non_idempotent_func"

# ---------------------------------------------------------------
# DELETE element from collection (from DeleteIdempotenceTest).
# Element subscript in DELETE selector.
# ---------------------------------------------------------------

error
DELETE l[0] FROM jd_del_col WHERE k = 1
----
at position 8: expected FROM, got "["
