exec
USE defaultdb
----

# ---------------------------------------------------------------
# Setup: create tables used by UPDATE tests.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_upd (k int PRIMARY KEY, v int, v1 int, v2 int)
----

exec
CREATE TABLE IF NOT EXISTS jd_upd_counter (k int PRIMARY KEY, c counter)
----

exec
CREATE TABLE IF NOT EXISTS jd_upd_coll (k int PRIMARY KEY, l list<int>, s set<int>, m map<int, text>)
----

exec
INSERT INTO jd_upd (k, v, v1, v2) VALUES (1, 10, 100, 200)
----

# ---------------------------------------------------------------
# Basic UPDATE with SET.
# ---------------------------------------------------------------

exec
UPDATE jd_upd SET v = 42 WHERE k = 1
----

query
SELECT k, v FROM jd_upd WHERE k = 1
----
k v
1 42

# ---------------------------------------------------------------
# UPDATE with multiple SET assignments.
# ---------------------------------------------------------------

exec
UPDATE jd_upd SET v1 = 111, v2 = 222 WHERE k = 1
----

query
SELECT k, v1, v2 FROM jd_upd WHERE k = 1
----
k v1 v2
1 111 222

# ---------------------------------------------------------------
# Counter increment/decrement.
# Counter UPDATEs have upsert semantics: row is created if missing.
# ---------------------------------------------------------------

exec
UPDATE jd_upd_counter SET c = c + 1 WHERE k = 1
----

exec
UPDATE jd_upd_counter SET c = c + 2 WHERE k = 1
----

query
SELECT k, c FROM jd_upd_counter WHERE k = 1
----
k c
1 3

exec
UPDATE jd_upd_counter SET c = c - 1 WHERE k = 1
----

query
SELECT k, c FROM jd_upd_counter WHERE k = 1
----
k c
1 2

# ---------------------------------------------------------------
# Collection list append/prepend/remove.
# ---------------------------------------------------------------

exec
INSERT INTO jd_upd_coll (k, l, s, m) VALUES (1, '[1, 2, 3]', '[10, 20]', '{"1": "foo", "2": "bar"}')
----

exec
UPDATE jd_upd_coll SET l = l + [4, 5] WHERE k = 1
----

exec
UPDATE jd_upd_coll SET l = [0] + l WHERE k = 1
----

# List subtraction: removes matching values from the JSON array.
exec
UPDATE jd_upd_coll SET l = l - [3] WHERE k = 1
----

# ---------------------------------------------------------------
# Collection set add/remove.
# ---------------------------------------------------------------

exec
UPDATE jd_upd_coll SET s = s + {30, 40} WHERE k = 1
----

# Set subtraction works (translated to JSONB subtraction).
exec
UPDATE jd_upd_coll SET s = s - {10} WHERE k = 1
----

# ---------------------------------------------------------------
# Collection map merge/remove.
# ---------------------------------------------------------------

exec
UPDATE jd_upd_coll SET m = m + {3: 'baz'} WHERE k = 1
----

# Map subtraction with key-value pairs is not supported (JSONB - JSONB).
error
UPDATE jd_upd_coll SET m = m - {1: 'foo'} WHERE k = 1
----
cql-dml: unsupported binary operator: <jsonb> - <jsonb> (returning <jsonb>)

# ---------------------------------------------------------------
# UPDATE IF EXISTS (lightweight transaction).
# ---------------------------------------------------------------

exec
UPDATE jd_upd SET v = 99 WHERE k = 1 IF EXISTS
----

query
SELECT k, v FROM jd_upd WHERE k = 1
----
k v
1 99

# UPDATE IF EXISTS on non-existent row (no-op).
exec
UPDATE jd_upd SET v = 999 WHERE k = 9999 IF EXISTS
----

# ---------------------------------------------------------------
# UPDATE IF condition (lightweight transaction).
# ---------------------------------------------------------------

exec
UPDATE jd_upd SET v = 50 WHERE k = 1 IF v = 99
----

query
SELECT k, v FROM jd_upd WHERE k = 1
----
k v
1 50

exec
UPDATE jd_upd SET v = 60 WHERE k = 1 IF v1 = 111 AND v2 = 222
----

query
SELECT k, v FROM jd_upd WHERE k = 1
----
k v
1 60

