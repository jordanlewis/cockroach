exec
USE defaultdb
----

# ---------------------------------------------------------------
# DROP TABLE.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_drop_t (k int PRIMARY KEY, v text)
----

exec
DROP TABLE jd_drop_t
----

# DROP TABLE IF EXISTS (no-op on nonexistent).
exec
DROP TABLE IF EXISTS jd_drop_t
----

# ---------------------------------------------------------------
# DROP KEYSPACE.
# ---------------------------------------------------------------

exec
CREATE KEYSPACE IF NOT EXISTS jd_drop_ks WITH replication={'class':'SimpleStrategy','replication_factor':'1'}
----

exec
DROP KEYSPACE jd_drop_ks
----

# DROP KEYSPACE IF EXISTS (no-op on nonexistent).
exec
DROP KEYSPACE IF EXISTS jd_drop_ks
----

# ---------------------------------------------------------------
# DROP INDEX.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_drop_idx_t (k int PRIMARY KEY, v text)
----

exec
CREATE INDEX jd_drop_idx ON jd_drop_idx_t (v)
----

exec
DROP INDEX jd_drop_idx
----

# DROP INDEX IF EXISTS (no-op on nonexistent).
exec
DROP INDEX IF EXISTS jd_drop_idx
----

# ---------------------------------------------------------------
# DROP TABLE with keyspace qualifier (from DropTableTest).
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_drop_ks_t (k int PRIMARY KEY, v text)
----

exec
DROP TABLE IF EXISTS defaultdb.jd_drop_ks_t
----

# ---------------------------------------------------------------
# DROP INDEX with keyspace qualifier (from DropIndexTest).
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_drop_ks_idx_t (k int PRIMARY KEY, v text)
----

exec
CREATE INDEX jd_drop_ks_idx ON jd_drop_ks_idx_t (v)
----

exec
DROP INDEX IF EXISTS defaultdb.jd_drop_ks_idx
----

