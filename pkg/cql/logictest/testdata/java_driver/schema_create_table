# CQL test cases adapted from Apache Cassandra Java Driver (Apache 2.0).
# Source: https://github.com/apache/cassandra-java-driver
# Copyright DataStax, Inc. and/or The Apache Software Foundation.
#
# Tests derived from CreateTableTest and related test classes.
#
# Note: The Java driver query builder outputs numeric map values like
# 'chunk_length_in_kb':1024, but CockroachDB's CQL parser requires
# string values in maps: 'chunk_length_in_kb':'1024'. Tests below use
# the string form; the Java driver integer form is tested as error cases.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# Basic CREATE TABLE variants.
# ---------------------------------------------------------------

# Simple table with single primary key.
exec
CREATE TABLE IF NOT EXISTS jd_ct1 (k int PRIMARY KEY)
----

# Table with primary key and value column.
exec
CREATE TABLE IF NOT EXISTS jd_ct2 (k int PRIMARY KEY, v text)
----

# Table with composite partition key.
exec
CREATE TABLE IF NOT EXISTS jd_ct3 (kc int, ka timestamp, v text, PRIMARY KEY((kc, ka)))
----

# Table with partition key and clustering column.
exec
CREATE TABLE IF NOT EXISTS jd_ct4 (k int, c text, v frozen<val>, PRIMARY KEY(k, c))
----

# Table with STATIC column.
exec
CREATE TABLE IF NOT EXISTS jd_ct5 (k int, c text, s timeuuid STATIC, v frozen<val>, PRIMARY KEY(k, c))
----

# Table with composite partition key and multiple clustering columns.
exec
CREATE TABLE IF NOT EXISTS jd_ct6 (kc int, ka timestamp, c float, a uuid, v text, PRIMARY KEY((kc, ka), c, a))
----

# ---------------------------------------------------------------
# CREATE TABLE with CLUSTERING ORDER BY.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS jd_ct_co1 (k int, c text, v text, PRIMARY KEY(k, c)) WITH CLUSTERING ORDER BY (c ASC)
----

exec
CREATE TABLE IF NOT EXISTS jd_ct_co2 (k int, c0 text, c1 text, c2 text, v text, PRIMARY KEY(k, c0, c1, c2)) WITH CLUSTERING ORDER BY (c0 DESC, c1 ASC, c2 DESC)
----

# ---------------------------------------------------------------
# CREATE TABLE with WITH properties (parsed but ignored).
# ---------------------------------------------------------------

# Multiple table properties (non-map properties accept any literal).
exec
CREATE TABLE IF NOT EXISTS jd_ct_props (k int PRIMARY KEY, v text) WITH bloom_filter_fp_chance=0.42 AND cdc=false AND comment='Hello world' AND dclocal_read_repair_chance=0.54 AND default_time_to_live=86400 AND gc_grace_seconds=864000 AND memtable_flush_period_in_ms=10000 AND min_index_interval=1024 AND max_index_interval=4096 AND read_repair_chance=0.55 AND speculative_retry='99percentile'
----

