CREATE TABLE IF NOT EXISTS jd_ct_zstd (k int PRIMARY KEY, v text) WITH compression={'class':'ZstdCompressor'}
----

exec
CREATE TABLE IF NOT EXISTS jd_ct_zstd_opts (k int PRIMARY KEY, v text) WITH compression={'class':'ZstdCompressor','chunk_length_in_kb':'1024'}
----

exec
CREATE TABLE IF NOT EXISTS jd_ct_snappy (k int PRIMARY KEY, v text) WITH compression={'class':'SnappyCompressor'}
