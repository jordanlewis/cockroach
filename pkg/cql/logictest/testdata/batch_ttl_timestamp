# TTL and USING TIMESTAMP features.
#
# CQL supports per-row TTL (time-to-live) and explicit write
# timestamps. These are specified via USING TTL and USING TIMESTAMP
# clauses. The parser accepts these for compatibility but they are
# silently ignored during translation.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS ttl_test (id int PRIMARY KEY, val text)
----

# INSERT with USING TTL. Parsed but ignored.
exec
INSERT INTO ttl_test (id, val) VALUES (1, 'ephemeral') USING TTL 3600
----

# INSERT with USING TIMESTAMP for explicit write timestamp. Parsed but ignored.
exec
INSERT INTO ttl_test (id, val) VALUES (2, 'timed') USING TIMESTAMP 1234567890
----

# INSERT with both USING TTL and TIMESTAMP. Parsed but ignored.
exec
INSERT INTO ttl_test (id, val) VALUES (3, 'both') USING TTL 3600 AND TIMESTAMP 1234567890
----

# TTL() function in SELECT — Cassandra-specific, not supported.
error
SELECT TTL(val) FROM ttl_test
----
translating selector: unsupported CQL function "TTL"

# writetime() function in SELECT — Cassandra-specific, not supported.
error
SELECT writetime(val) FROM ttl_test
----
translating selector: unsupported CQL function "writetime"

# UPDATE with USING TTL to change TTL on existing rows. Parsed but ignored.
exec
UPDATE ttl_test USING TTL 7200 SET val = 'updated' WHERE id = 1
----
