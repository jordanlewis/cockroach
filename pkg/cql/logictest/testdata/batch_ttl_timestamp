# TTL and USING TIMESTAMP features.
#
# CQL supports per-row TTL (time-to-live) and explicit write
# timestamps. These are specified via USING TTL and USING TIMESTAMP
# clauses. Neither is supported by the parser.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS ttl_test (id int PRIMARY KEY, val text)
----

# INSERT with USING TTL. The parser finishes the INSERT and then
# encounters the unexpected USING token.
error
INSERT INTO ttl_test (id, val) VALUES (1, 'ephemeral') USING TTL 3600
----
at position 55: unexpected token "USING" after statement

# INSERT with USING TIMESTAMP for explicit write timestamp.
error
INSERT INTO ttl_test (id, val) VALUES (2, 'timed') USING TIMESTAMP 1234567890
----
at position 51: unexpected token "USING" after statement

# INSERT with both USING TTL and TIMESTAMP.
error
INSERT INTO ttl_test (id, val) VALUES (3, 'both') USING TTL 3600 AND TIMESTAMP 1234567890
----
at position 50: unexpected token "USING" after statement

# TTL() function in SELECT is not supported (function call syntax).
# The parser reads TTL as a column name and fails on the parenthesis.
error
SELECT TTL(val) FROM ttl_test
----
at position 10: expected FROM, got "("

# writetime() function in SELECT.
error
SELECT writetime(val) FROM ttl_test
----
at position 16: expected FROM, got "("

# UPDATE with USING TTL to change TTL on existing rows.
error
UPDATE ttl_test USING TTL 7200 SET val = 'updated' WHERE id = 1
----
at position 0: unsupported statement "UPDATE"
