# Primary key tests: range queries on clustering columns.
#
# CQL supports range predicates (>, <, >=, <=) on clustering columns.
# This file provides thorough coverage of range queries including
# single-column ranges, multi-column clustering ranges, combined
# range predicates (BETWEEN equivalent), and range queries on tables
# with composite partition keys.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# Basic range queries on a single clustering column
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_rq_basic (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_rq_basic (pk, ck, val) VALUES (1, 10, 'ten')
----

exec
INSERT INTO keys_rq_basic (pk, ck, val) VALUES (1, 20, 'twenty')
----

exec
INSERT INTO keys_rq_basic (pk, ck, val) VALUES (1, 30, 'thirty')
----

exec
INSERT INTO keys_rq_basic (pk, ck, val) VALUES (1, 40, 'forty')
----

exec
INSERT INTO keys_rq_basic (pk, ck, val) VALUES (1, 50, 'fifty')
----

# Greater-than.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 30
----
pk ck val
1 40 forty
1 50 fifty

# Greater-than-or-equal.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 30
----
pk ck val
1 30 thirty
1 40 forty
1 50 fifty

# Less-than.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck < 30
----
pk ck val
1 10 ten
1 20 twenty

# Less-than-or-equal.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck <= 30
----
pk ck val
1 10 ten
1 20 twenty
1 30 thirty

# BETWEEN equivalent: ck > low AND ck < high.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 10 AND ck < 50
----
pk ck val
1 20 twenty
1 30 thirty
1 40 forty

# BETWEEN equivalent: ck >= low AND ck <= high (inclusive).
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 20 AND ck <= 40
----
pk ck val
1 20 twenty
1 30 thirty
1 40 forty

# BETWEEN with exclusive low, inclusive high.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 10 AND ck <= 30
----
pk ck val
1 20 twenty
1 30 thirty

# BETWEEN with inclusive low, exclusive high.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 20 AND ck < 40
----
pk ck val
1 20 twenty
1 30 thirty

# Range returning a single row.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 40
----
pk ck val
1 50 fifty

# Range returning no rows.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 50
----
pk ck val

# Narrow BETWEEN returning no rows.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck > 20 AND ck < 30
----
pk ck val

# ---------------------------------------------------------------
# Range queries with ORDER BY
# ---------------------------------------------------------------

# Range query with ORDER BY ASC (default).
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 20 ORDER BY ck ASC
----
pk ck val
1 20 twenty
1 30 thirty
1 40 forty
1 50 fifty

# Range query with ORDER BY DESC.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 20 ORDER BY ck DESC
----
pk ck val
1 50 fifty
1 40 forty
1 30 thirty
1 20 twenty

# BETWEEN with ORDER BY DESC.
query
SELECT pk, ck, val FROM keys_rq_basic WHERE pk = 1 AND ck >= 20 AND ck <= 40 ORDER BY ck DESC
----
pk ck val
1 40 forty
1 30 thirty
1 20 twenty

# ---------------------------------------------------------------
# Range queries on text clustering columns
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_rq_text (pk int, ck text, val int, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_rq_text (pk, ck, val) VALUES (1, 'alpha', 1)
----

exec
INSERT INTO keys_rq_text (pk, ck, val) VALUES (1, 'bravo', 2)
----

exec
INSERT INTO keys_rq_text (pk, ck, val) VALUES (1, 'charlie', 3)
----

exec
INSERT INTO keys_rq_text (pk, ck, val) VALUES (1, 'delta', 4)
----

exec
INSERT INTO keys_rq_text (pk, ck, val) VALUES (1, 'echo', 5)
----

# Lexicographic greater-than on text.
query
SELECT pk, ck, val FROM keys_rq_text WHERE pk = 1 AND ck > 'bravo'
----
pk ck val
1 charlie 3
1 delta 4
1 echo 5

# Lexicographic less-than on text.
query
SELECT pk, ck, val FROM keys_rq_text WHERE pk = 1 AND ck < 'delta'
----
pk ck val
1 alpha 1
1 bravo 2
1 charlie 3

# Lexicographic BETWEEN on text.
query
SELECT pk, ck, val FROM keys_rq_text WHERE pk = 1 AND ck >= 'bravo' AND ck <= 'delta'
----
pk ck val
1 bravo 2
1 charlie 3
1 delta 4

