# Range queries with composite partition key
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_rq_cpk (pk1 text, pk2 int, ck int, val text, PRIMARY KEY ((pk1, pk2), ck))
----

exec
INSERT INTO keys_rq_cpk (pk1, pk2, ck, val) VALUES ('a', 1, 100, 'r1')
----

exec
INSERT INTO keys_rq_cpk (pk1, pk2, ck, val) VALUES ('a', 1, 200, 'r2')
----

exec
INSERT INTO keys_rq_cpk (pk1, pk2, ck, val) VALUES ('a', 1, 300, 'r3')
----

exec
INSERT INTO keys_rq_cpk (pk1, pk2, ck, val) VALUES ('a', 1, 400, 'r4')
----

exec
INSERT INTO keys_rq_cpk (pk1, pk2, ck, val) VALUES ('b', 1, 100, 'r5')
----

# Range on clustering column within a composite partition.
query
SELECT pk1, pk2, ck, val FROM keys_rq_cpk WHERE pk1 = 'a' AND pk2 = 1 AND ck > 100
----
pk1 pk2 ck val
a 1 200 r2
a 1 300 r3
a 1 400 r4

# BETWEEN on clustering column within a composite partition.
query
SELECT pk1, pk2, ck, val FROM keys_rq_cpk WHERE pk1 = 'a' AND pk2 = 1 AND ck >= 200 AND ck <= 300
----
pk1 pk2 ck val
a 1 200 r2
a 1 300 r3

# Less-than on clustering column within a composite partition.
query
SELECT pk1, pk2, ck, val FROM keys_rq_cpk WHERE pk1 = 'a' AND pk2 = 1 AND ck < 300
----
pk1 pk2 ck val
a 1 100 r1
a 1 200 r2

# Range with ORDER BY DESC on composite partition.
query
SELECT pk1, pk2, ck, val FROM keys_rq_cpk WHERE pk1 = 'a' AND pk2 = 1 AND ck >= 200 ORDER BY ck DESC
----
pk1 pk2 ck val
a 1 400 r4
a 1 300 r3
a 1 200 r2

# ---------------------------------------------------------------
# Range queries across partition boundaries
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_rq_partitions (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_rq_partitions (pk, ck, val) VALUES (1, 10, 'p1-10')
----

exec
INSERT INTO keys_rq_partitions (pk, ck, val) VALUES (1, 20, 'p1-20')
----

exec
INSERT INTO keys_rq_partitions (pk, ck, val) VALUES (1, 30, 'p1-30')
----

exec
INSERT INTO keys_rq_partitions (pk, ck, val) VALUES (2, 10, 'p2-10')
----

exec
INSERT INTO keys_rq_partitions (pk, ck, val) VALUES (2, 20, 'p2-20')
----

# Range scoped to partition 1.
query
SELECT pk, ck, val FROM keys_rq_partitions WHERE pk = 1 AND ck >= 20
----
pk ck val
1 20 p1-20
1 30 p1-30

# Range scoped to partition 2.
query
SELECT pk, ck, val FROM keys_rq_partitions WHERE pk = 2 AND ck < 20
----
pk ck val
2 10 p2-10

# Same range, different partitions yield different rows.
query
SELECT pk, ck, val FROM keys_rq_partitions WHERE pk = 1 AND ck = 10
----
pk ck val
1 10 p1-10

query
SELECT pk, ck, val FROM keys_rq_partitions WHERE pk = 2 AND ck = 10
----
pk ck val
2 10 p2-10
