exec
CREATE TABLE IF NOT EXISTS keys_rq_multi (pk int, ck1 int, ck2 int, val text, PRIMARY KEY (pk, ck1, ck2))
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 1, 1, 'a')
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 1, 2, 'b')
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 1, 3, 'c')
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 2, 1, 'd')
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 2, 2, 'e')
----

exec
INSERT INTO keys_rq_multi (pk, ck1, ck2, val) VALUES (1, 3, 1, 'f')
----

# Range on first clustering column.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 > 1
----
pk ck1 ck2 val
1 2 1 d
1 2 2 e
1 3 1 f

# Range on first clustering column with equality.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 >= 2
----
pk ck1 ck2 val
1 2 1 d
1 2 2 e
1 3 1 f

# Equality on first, range on second clustering column.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 = 1 AND ck2 > 1
----
pk ck1 ck2 val
1 1 2 b
1 1 3 c

# Equality on first, BETWEEN on second.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 = 1 AND ck2 >= 1 AND ck2 <= 2
----
pk ck1 ck2 val
1 1 1 a
1 1 2 b

# Less-than on first clustering column.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 < 2
----
pk ck1 ck2 val
1 1 1 a
1 1 2 b
1 1 3 c

# BETWEEN on first clustering column.
query
SELECT pk, ck1, ck2, val FROM keys_rq_multi WHERE pk = 1 AND ck1 >= 1 AND ck1 <= 2
----
pk ck1 ck2 val
1 1 1 a
1 1 2 b
1 1 3 c
1 2 1 d
1 2 2 e

