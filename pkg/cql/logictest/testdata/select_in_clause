# IN clause on partition key and clustering columns.
#
# CQL IN allows multi-value lookups on partition and clustering keys.
# The CQL layer translates IN directly to SQL IN.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS sel_in (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO sel_in (pk, ck, val) VALUES (1, 10, 'a')
----

exec
INSERT INTO sel_in (pk, ck, val) VALUES (2, 20, 'b')
----

exec
INSERT INTO sel_in (pk, ck, val) VALUES (3, 30, 'c')
----

exec
INSERT INTO sel_in (pk, ck, val) VALUES (1, 20, 'd')
----

# IN on partition key.
query rowsort
SELECT pk, ck, val FROM sel_in WHERE pk IN (1, 2)
----
pk ck val
1 10 a
1 20 d
2 20 b

# IN on clustering column.
query rowsort
SELECT pk, ck, val FROM sel_in WHERE pk = 1 AND ck IN (10, 20)
----
pk ck val
1 10 a
1 20 d

# IN on partition key with three values.
query rowsort
SELECT pk, ck, val FROM sel_in WHERE pk IN (1, 2, 3) AND ck = 10
----
pk ck val
1 10 a
