# Lightweight transactions: INSERT IF NOT EXISTS.
#
# CQL lightweight transactions (LWT) use IF clauses for conditional
# mutations. INSERT IF NOT EXISTS is the most common form: it inserts
# a row only if no row with the same primary key exists. The result
# always includes an [applied] boolean column. On success, [applied]
# is true. On failure (duplicate), [applied] is false and the existing
# row values are returned. This matches Cassandra's LWT semantics.
#
# Implementation: INSERT ... ON CONFLICT DO NOTHING, then check
# rows_affected. If 0, SELECT the existing row for the result set.

exec
USE defaultdb
----

# Set up a table for LWT insert tests.
exec
CREATE TABLE IF NOT EXISTS lwt_ins (id int, name text, val int, PRIMARY KEY (id))
----

# ---------------------------------------------------------------
# INSERT IF NOT EXISTS: row does not exist → succeeds.
# Returns [applied]=true result set.
# ---------------------------------------------------------------

query
INSERT INTO lwt_ins (id, name, val) VALUES (1, 'alice', 100) IF NOT EXISTS
----
[applied]
true

# Verify the row was inserted.
query
SELECT id, name, val FROM lwt_ins WHERE id = 1
----
id name val
1 alice 100

# ---------------------------------------------------------------
# INSERT IF NOT EXISTS: row already exists → [applied]=false.
# Returns the existing row along with [applied]=false, matching
# Cassandra's lightweight transaction semantics.
# ---------------------------------------------------------------

query
INSERT INTO lwt_ins (id, name, val) VALUES (1, 'bob', 200) IF NOT EXISTS
----
[applied] id name val
false 1 alice 100

# Verify the original row is unchanged.
query
SELECT id, name, val FROM lwt_ins WHERE id = 1
----
id name val
1 alice 100

# ---------------------------------------------------------------
# Plain INSERT (no IF clause) is an upsert in CQL semantics.
# It overwrites the existing row without error.
# ---------------------------------------------------------------

exec
INSERT INTO lwt_ins (id, name, val) VALUES (1, 'bob', 200)
----

# Verify the upsert replaced the row.
query
SELECT id, name, val FROM lwt_ins WHERE id = 1
----
id name val
1 bob 200

# ---------------------------------------------------------------
# INSERT IF NOT EXISTS with multiple rows: each conditional.
# ---------------------------------------------------------------

query
INSERT INTO lwt_ins (id, name, val) VALUES (2, 'carol', 300) IF NOT EXISTS
----
[applied]
true

query
INSERT INTO lwt_ins (id, name, val) VALUES (3, 'dave', 400) IF NOT EXISTS
----
[applied]
true

# Second insert of id=2 returns [applied]=false with existing row.
query
INSERT INTO lwt_ins (id, name, val) VALUES (2, 'eve', 500) IF NOT EXISTS
----
[applied] id name val
false 2 carol 300

# Verify only the first insert took effect for id=2.
query
SELECT id, name, val FROM lwt_ins WHERE id = 2
----
id name val
2 carol 300

# Verify all three rows.
query rowsort
SELECT id, name, val FROM lwt_ins
----
id name val
1 bob 200
2 carol 300
3 dave 400
