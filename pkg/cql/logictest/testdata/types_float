# Floating-point types: float (FLOAT4), double (FLOAT8).
#
# CQL float maps to CRDB FLOAT4 (32-bit IEEE 754).
# CQL double maps to CRDB FLOAT8 (64-bit IEEE 754).
# Values are formatted with %g (shortest representation).
# Tests use values exactly representable in float32 to avoid
# precision surprises.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS lt_float (id int, f float, d double, PRIMARY KEY (id))
----

# Basic positive values (exact in float32).
exec
INSERT INTO lt_float (id, f, d) VALUES (1, 1.5, 1.5)
----

query
SELECT id, f, d FROM lt_float WHERE id = 1
----
id f d
1 1.5 1.5

# Zero values.
exec
INSERT INTO lt_float (id, f, d) VALUES (2, 0, 0)
----

query
SELECT id, f, d FROM lt_float WHERE id = 2
----
id f d
2 0 0

# Negative values.
exec
INSERT INTO lt_float (id, f, d) VALUES (3, -2.5, -2.5)
----

query
SELECT id, f, d FROM lt_float WHERE id = 3
----
id f d
3 -2.5 -2.5

# Small fractional values (exact in float32).
exec
INSERT INTO lt_float (id, f, d) VALUES (4, 0.125, 0.125)
----

query
SELECT id, f, d FROM lt_float WHERE id = 4
----
id f d
4 0.125 0.125

# Larger integer values stored as float.
exec
INSERT INTO lt_float (id, f, d) VALUES (5, 1000, 1000000)
----

query
SELECT id, f, d FROM lt_float WHERE id = 5
----
id f d
5 1000 1e+06

# NULL values.
exec
INSERT INTO lt_float (id, f, d) VALUES (6, NULL, NULL)
----

query
SELECT id, f, d FROM lt_float WHERE id = 6
----
id f d
6 NULL NULL

# Mixed NULL and non-NULL.
exec
INSERT INTO lt_float (id, f, d) VALUES (7, 3.75, NULL)
----

query
SELECT id, f, d FROM lt_float WHERE id = 7
----
id f d
7 3.75 NULL

# Double precision: more digits preserved.
exec
INSERT INTO lt_float (id, f, d) VALUES (8, 1, 3.141592653589793)
----

query
SELECT id, d FROM lt_float WHERE id = 8
----
id d
8 3.141592653589793
