# ALLOW FILTERING clause.
#
# In Cassandra, queries that require a full table scan (e.g. WHERE on
# a non-indexed, non-key column) need ALLOW FILTERING to proceed.
# The parser accepts and ignores ALLOW FILTERING since CRDB performs
# full table scans as needed.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS sel_af (pk int, ck int, data text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO sel_af (pk, ck, data) VALUES (1, 10, 'hello')
----

exec
INSERT INTO sel_af (pk, ck, data) VALUES (2, 20, 'world')
----

exec
INSERT INTO sel_af (pk, ck, data) VALUES (3, 30, 'hello')
----

# ALLOW FILTERING is accepted and ignored by the parser.
query rowsort
SELECT pk, ck, data FROM sel_af WHERE data = 'hello' ALLOW FILTERING
----
pk ck data
1 10 hello
3 30 hello

# WHERE on a non-key column works with or without ALLOW FILTERING.
query rowsort
SELECT pk, ck, data FROM sel_af WHERE data = 'hello'
----
pk ck data
1 10 hello
3 30 hello
