# GROUP BY for aggregate queries.
#
# CQL GROUP BY is parsed and translated to SQL GROUP BY.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS grp_t (pk int, ck int, val int, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO grp_t (pk, ck, val) VALUES (1, 1, 10)
----

exec
INSERT INTO grp_t (pk, ck, val) VALUES (1, 2, 20)
----

exec
INSERT INTO grp_t (pk, ck, val) VALUES (2, 1, 30)
----

exec
INSERT INTO grp_t (pk, ck, val) VALUES (2, 2, 40)
----

# GROUP BY partition key.
exec
SELECT pk FROM grp_t GROUP BY pk
----

# GROUP BY with aggregate function.
exec
SELECT pk, COUNT(*) FROM grp_t GROUP BY pk
----

# GROUP BY clustering column.
exec
SELECT ck FROM grp_t GROUP BY ck
----

# GROUP BY with multiple columns.
exec
SELECT pk, ck FROM grp_t GROUP BY pk, ck
----

# GROUP BY with WHERE clause.
exec
SELECT pk FROM grp_t WHERE pk = 1 GROUP BY pk
----

# GROUP BY partition key with ORDER BY listed after GROUP BY.
exec
SELECT pk FROM grp_t GROUP BY pk ORDER BY pk
----

# GROUP BY with LIMIT.
exec
SELECT pk FROM grp_t GROUP BY pk LIMIT 10
----
