# User-Defined Types (UDTs): CREATE TYPE, ALTER TYPE, UDT columns,
# nested UDTs, and field access.
#
# CREATE TYPE maps to CockroachDB composite types. UDT column types
# and field access (addr.street → ("addr")."street") are supported.
# ALTER TYPE ADD/RENAME for composite types is not supported by CRDB.
# Nested UDTs (composite types referencing other UDTs) are not yet
# supported by CRDB.

exec
USE defaultdb
----

# CREATE TYPE — maps to CRDB composite type.
exec
CREATE TYPE address (street text, city text, zip text)
----

# ALTER TYPE ADD is not supported for composite types in CRDB.
error
ALTER TYPE address ADD state text
----
ALTER TYPE ADD field is not supported for composite types

# UDT as a column type — uses the composite type directly.
exec
CREATE TABLE udt_table (id int PRIMARY KEY, addr address)
----

# Frozen UDT column type — frozen<> maps to JSONB even for UDTs.
# Table creation succeeds but UDT data operations are not supported.
exec
CREATE TABLE frozen_udt_table (id int PRIMARY KEY, addr frozen<address>)
----

# Nested UDTs (a UDT containing another UDT). CRDB does not yet
# support composite types that reference other user-defined types.
error
CREATE TYPE full_address (base address, country text)
----
cql-ddl: unimplemented: composite types that reference user-defined types not yet supported

# UDT field access in SELECT (column.field syntax).
# For composite type columns, translates to ("addr")."street" in CRDB.
exec
SELECT addr.street FROM udt_table
----

# UDT field access on frozen<> (JSONB) columns uses ->> extraction.
exec
SELECT addr.street FROM frozen_udt_table
----

# UDT literal syntax: {field: val, ...} with unquoted identifier keys.
# Parsed as a map literal and translated to jsonb_build_object().
exec
INSERT INTO frozen_udt_table (id, addr) VALUES (1, {street: '123 Main', city: 'Anytown', zip: '12345'})
----
