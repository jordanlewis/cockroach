# User-Defined Types (UDTs): CREATE TYPE, ALTER TYPE, UDT columns,
# nested UDTs, and field access.
#
# The parser accepts CREATE TYPE syntax and recognizes unknown type
# names as potential UDTs. ALTER TYPE and field access (addr.street)
# remain unsupported at the parser level. The translator does not
# yet handle UDT operations. These tests document the expected errors.

exec
USE defaultdb
----

# CREATE TYPE — parsed but translator rejects.
error
CREATE TYPE address (street text, city text, zip text)
----
unsupported CQL statement type: *parser.CreateTypeStatement

# ALTER TYPE is not yet supported (ALTER handles TABLE and KEYSPACE).
error
ALTER TYPE address ADD state text
----
at position 6: expected TABLE or KEYSPACE after ALTER, got "TYPE"

# UDT as a column type — parsed as unknown type, translator rejects.
error
CREATE TABLE udt_table (id int PRIMARY KEY, addr address)
----
unsupported CQL type "address" for column "addr"

# Frozen UDT column type.
error
CREATE TABLE frozen_udt_table (id int PRIMARY KEY, addr frozen<address>)
----
unsupported CQL type "frozen" for column "addr"

# Nested UDTs (a UDT containing another UDT).
error
CREATE TYPE full_address (base address, country text)
----
unsupported CQL statement type: *parser.CreateTypeStatement

# UDT field access in SELECT (column.field syntax).
# The parser reads "addr" as a column, then fails on "." when
# expecting FROM.
error
SELECT addr.street FROM udt_table
----
at position 11: expected FROM, got "."
