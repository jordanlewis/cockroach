# DDL tests for CQL keyspace (CREATE, DROP, ALTER).
#
# CQL keyspaces map to CockroachDB databases. CREATE KEYSPACE maps
# to CREATE DATABASE. ALTER KEYSPACE is parsed but returns a
# translation error — CRDB handles replication via zone configs.

# ---------------------------------------------------------------
# CREATE KEYSPACE
# ---------------------------------------------------------------

# Basic CREATE KEYSPACE with SimpleStrategy replication.
exec
CREATE KEYSPACE test_ks_simple WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

# USE the newly created keyspace.
exec
USE test_ks_simple
----

# CREATE KEYSPACE IF NOT EXISTS for an already existing keyspace.
exec
CREATE KEYSPACE IF NOT EXISTS test_ks_simple WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

# CREATE KEYSPACE with NetworkTopologyStrategy.
exec
CREATE KEYSPACE test_ks_nts WITH replication = {'class': 'NetworkTopologyStrategy', 'datacenter1': '3'}
----

# CREATE KEYSPACE with durable_writes option.
exec
CREATE KEYSPACE test_ks_durable WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'} AND durable_writes = true
----

# CREATE KEYSPACE with durable_writes = false.
exec
CREATE KEYSPACE test_ks_nodurable WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'} AND durable_writes = false
----

# Verify keyspaces exist by querying system_schema.keyspaces.
# The catalog returns all columns (keyspace_name, durable_writes,
# replication) regardless of the SELECT list, and includes synthetic
# system keyspaces alongside real CRDB databases.
query rowsort
SELECT * FROM system_schema.keyspaces
----
keyspace_name durable_writes replication
defaultdb true {'class': 'SimpleStrategy'}
postgres true {'class': 'SimpleStrategy'}
system true {'class': 'SimpleStrategy'}
system_schema true {'class': 'SimpleStrategy'}
system_virtual_schema true {'class': 'SimpleStrategy'}
test_ks_durable true {'class': 'SimpleStrategy'}
test_ks_nodurable true {'class': 'SimpleStrategy'}
test_ks_nts true {'class': 'SimpleStrategy'}
test_ks_simple true {'class': 'SimpleStrategy'}

# ---------------------------------------------------------------
# Error: duplicate keyspace without IF NOT EXISTS
# ---------------------------------------------------------------

# Creating a keyspace that already exists without IF NOT EXISTS
# should produce an error.
error
CREATE KEYSPACE test_ks_simple WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----
cql-ddl: database "test_ks_simple" already exists

# ---------------------------------------------------------------
# Error: CREATE KEYSPACE with missing WITH clause
# ---------------------------------------------------------------

error
CREATE KEYSPACE test_ks_bad
----
at position 27: expected WITH, got ""

# ---------------------------------------------------------------
# DROP KEYSPACE
# ---------------------------------------------------------------

exec
DROP KEYSPACE test_ks_simple
----

# Drop again with IF EXISTS — no error.
exec
DROP KEYSPACE IF EXISTS test_ks_simple
----

# ---------------------------------------------------------------
# ALTER KEYSPACE — silently accepted for compatibility.
#
# CQL keyspace properties (replication strategy, durable_writes)
# have no CRDB equivalent. CRDB uses zone configs instead.
# ---------------------------------------------------------------

exec
ALTER KEYSPACE test_ks_nts WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '3'}
----

exec
ALTER KEYSPACE test_ks_nts WITH durable_writes = false
----

exec
ALTER KEYSPACE test_ks_nts WITH replication = {'class': 'NetworkTopologyStrategy', 'dc1': '3'} AND durable_writes = true
----
