# DML tests for CQL UPDATE statements.
#
# CQL UPDATE modifies existing rows in place. Unlike SQL UPDATE, CQL
# UPDATE is also an upsert in some interpretations, but CockroachDB's
# CQL layer translates it to a standard SQL UPDATE which only modifies
# existing rows. UPDATE IF EXISTS and UPDATE IF <conds> return a rows
# result set with an [applied] column, matching Cassandra's lightweight
# transaction semantics.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS dml_upd (pk int, ck int, name text, val int, active boolean, PRIMARY KEY (pk, ck))
----

# Seed data.
exec
INSERT INTO dml_upd (pk, ck, name, val, active) VALUES (1, 10, 'alice', 100, true)
----

exec
INSERT INTO dml_upd (pk, ck, name, val, active) VALUES (1, 20, 'bob', 200, true)
----

exec
INSERT INTO dml_upd (pk, ck, name, val, active) VALUES (2, 10, 'carol', 300, false)
----

# ---------------------------------------------------------------
# UPDATE single column.
# ---------------------------------------------------------------

exec
UPDATE dml_upd SET name = 'ALICE' WHERE pk = 1 AND ck = 10
----

query
SELECT pk, ck, name, val, active FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck name val active
1 10 ALICE 100 true

# ---------------------------------------------------------------
# UPDATE multiple columns.
# ---------------------------------------------------------------

exec
UPDATE dml_upd SET name = 'BOB', val = 250, active = false WHERE pk = 1 AND ck = 20
----

query
SELECT pk, ck, name, val, active FROM dml_upd WHERE pk = 1 AND ck = 20
----
pk ck name val active
1 20 BOB 250 false

# ---------------------------------------------------------------
# UPDATE setting a column to NULL.
# ---------------------------------------------------------------

exec
UPDATE dml_upd SET name = null WHERE pk = 2 AND ck = 10
----

query
SELECT pk, ck, name, val, active FROM dml_upd WHERE pk = 2 AND ck = 10
----
pk ck name val active
2 10 NULL 300 false

# ---------------------------------------------------------------
# UPDATE non-existent row → no-op (SQL UPDATE WHERE is a no-op).
# ---------------------------------------------------------------

exec
UPDATE dml_upd SET name = 'ghost' WHERE pk = 999 AND ck = 1
----

# Verify no row was created.
query
SELECT pk, ck, name FROM dml_upd WHERE pk = 999
----
pk ck name

# ---------------------------------------------------------------
# UPDATE IF EXISTS: row exists → [applied]=true.
# ---------------------------------------------------------------

query
UPDATE dml_upd SET val = 999 WHERE pk = 1 AND ck = 10 IF EXISTS
----
[applied]
true

query
SELECT pk, ck, name, val FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 ALICE 999

# UPDATE IF EXISTS on a non-existent row → [applied]=false.
query
UPDATE dml_upd SET val = 1 WHERE pk = 888 AND ck = 1 IF EXISTS
----
[applied]
false

query
SELECT pk, ck, name FROM dml_upd WHERE pk = 888
----
pk ck name

# ---------------------------------------------------------------
# UPDATE with IF conditions (lightweight transactions).
#
# CQL UPDATE with IF <col> = <val> performs a conditional update.
# The result includes [applied] and (on failure) the existing row.
# ---------------------------------------------------------------

# IF condition matches → [applied]=true.
query
UPDATE dml_upd SET name = 'new' WHERE pk = 1 AND ck = 10 IF name = 'ALICE'
----
[applied]
true

query
Select pk, ck, name, val FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 new 999

# IF condition does not match → [applied]=false with existing row.
query
UPDATE dml_upd SET name = 'nope' WHERE pk = 1 AND ck = 10 IF name = 'ALICE'
----
[applied] pk ck name val active
false 1 10 new 999 true

query
SELECT pk, ck, name FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck name
1 10 new

# IF val != condition matches → [applied]=true.
query
UPDATE dml_upd SET val = 0 WHERE pk = 1 AND ck = 10 IF val != 100
----
[applied]
true

query
SELECT pk, ck, val FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck val
1 10 0

# Multiple IF conditions: all must match → [applied]=true.
query
UPDATE dml_upd SET active = true WHERE pk = 1 AND ck = 10 IF name = 'new' AND val = 0
----
[applied]
true

query
SELECT pk, ck, name, val, active FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck name val active
1 10 new 0 true

# Multiple IF conditions: one doesn't match → [applied]=false
# with existing row.
query
UPDATE dml_upd SET active = false WHERE pk = 1 AND ck = 10 IF active = true AND val = 999
----
[applied] pk ck name val active
false 1 10 new 0 true

query
SELECT pk, ck, active FROM dml_upd WHERE pk = 1 AND ck = 10
----
pk ck active
1 10 true

# ---------------------------------------------------------------
# UPDATE counter columns.
#
# Counter columns in Cassandra support atomic increment/decrement
# via UPDATE SET c = c + N. Counter UPDATEs have upsert semantics:
# the row is created if it doesn't exist (starting from 0).
# Translated to INSERT ON CONFLICT DO UPDATE.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS dml_upd_counter (id int PRIMARY KEY, c counter)
----

# Counter increment on non-existent row creates it (upsert).
exec
UPDATE dml_upd_counter SET c = c + 1 WHERE id = 1
----

query
SELECT id, c FROM dml_upd_counter WHERE id = 1
----
id c
1 1

# Counter decrement on existing row.
exec
UPDATE dml_upd_counter SET c = c - 1 WHERE id = 1
----

query
SELECT id, c FROM dml_upd_counter WHERE id = 1
----
id c
1 0

# ---------------------------------------------------------------
# UPDATE with USING TTL (parsed but silently ignored).
# ---------------------------------------------------------------

exec
UPDATE dml_upd USING TTL 7200 SET val = 1 WHERE pk = 1 AND ck = 10
----

# ---------------------------------------------------------------
# UPDATE with USING TIMESTAMP (parsed but silently ignored).
# ---------------------------------------------------------------

exec
UPDATE dml_upd USING TIMESTAMP 1234567890 SET val = 1 WHERE pk = 1 AND ck = 10
----
