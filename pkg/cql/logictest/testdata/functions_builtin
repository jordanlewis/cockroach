translating selector: unsupported CQL function "textAsBlob"

# -- CAST function --

# CAST(column AS type) — maps to SQL CAST.
exec
SELECT CAST(pk AS bigint) FROM fn_t
----

# -- Function in WHERE clause (non-token) --

# minTimeuuid() in WHERE clause — not supported.
error
SELECT * FROM fn_t WHERE uid > minTimeuuid('2024-01-01')
----
translating WHERE value: unsupported CQL function "minTimeuuid"

# now() in WHERE clause — supported, maps to CRDB now().
exec
SELECT * FROM fn_t WHERE ts > now()
----

# -- Functions with no arguments in INSERT --

# now() and uuid() in INSERT VALUES — supported.
exec
INSERT INTO fn_t (pk, ts, uid, val) VALUES (2, now(), uuid(), 'test')
----
