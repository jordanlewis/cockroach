# -- token() function --
# (Also tested in select_token_function; included here for
# completeness of the built-in function catalog.)

# token() in SELECT list.
# "token" (5 chars) starts at 7; "(" is at 12.
error
SELECT token(pk) FROM fn_t
----
at position 12: expected FROM, got "("

# token() in WHERE clause: parser reads "token" as a column name,
# then expects a comparison operator but finds "(". "token" starts
# at offset 25, "(" is at offset 30.
error
SELECT * FROM fn_t WHERE token(pk) > 0
----
at position 30: expected comparison operator, got "("

