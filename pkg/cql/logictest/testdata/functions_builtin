----
at position 11: expected FROM, got "("

# -- Function in WHERE clause (non-token) --

# minTimeuuid() in WHERE clause for time range queries.
# After "uid > ", parseExpr sees "minTimeuuid" (an identifier at
# offset 31) which it cannot handle as an expression.
error
SELECT * FROM fn_t WHERE uid > minTimeuuid('2024-01-01')
----
at position 31: expected expression, got identifier "minTimeuuid"

# now() in WHERE clause.
# After "ts > ", parseExpr sees "now" (an identifier at offset 30).
error
SELECT * FROM fn_t WHERE ts > now()
----
at position 30: expected expression, got identifier "now"

# -- Functions with no arguments in INSERT --

# now() in INSERT VALUES. The parser reads "now" as an identifier
# and cannot parse it as an expression. "now" is at offset 47.
error
INSERT INTO fn_t (pk, ts, uid, val) VALUES (2, now(), uuid(), 'test')
----
at position 47: expected expression, got identifier "now"
