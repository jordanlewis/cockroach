# Primary key tests: clustering order.
#
# In Cassandra, WITH CLUSTERING ORDER BY controls the default sort order
# of rows within a partition. The parser accepts this clause for
# compatibility but it is silently ignored — CockroachDB uses the
# column order in the PRIMARY KEY definition. This file tests:
#   1. WITH CLUSTERING ORDER BY (parsed, silently ignored)
#   2. Default clustering order (ASC) behavior
#   3. Explicit ORDER BY to reverse clustering order
#   4. Multi-column clustering order verification

exec
USE defaultdb
----

# ---------------------------------------------------------------
# WITH CLUSTERING ORDER BY (parsed, silently ignored)
# ---------------------------------------------------------------

# Single clustering column, DESC.
exec
CREATE TABLE keys_co_desc (pk int, ck int, val text, PRIMARY KEY (pk, ck)) WITH CLUSTERING ORDER BY (ck DESC)
----

# Single clustering column, ASC (explicit, same as default).
exec
CREATE TABLE keys_co_asc (pk int, ck int, val text, PRIMARY KEY (pk, ck)) WITH CLUSTERING ORDER BY (ck ASC)
----

# Multiple clustering columns with mixed order.
exec
CREATE TABLE keys_co_mixed (pk int, ck1 int, ck2 text, val text, PRIMARY KEY (pk, ck1, ck2)) WITH CLUSTERING ORDER BY (ck1 ASC, ck2 DESC)
----

# WITH CLUSTERING ORDER BY combined with other table options.
exec
CREATE TABLE keys_co_opts (pk int, ck int, val text, PRIMARY KEY (pk, ck)) WITH CLUSTERING ORDER BY (ck DESC) AND gc_grace_seconds = 86400
----

# ---------------------------------------------------------------
# Default clustering order: ASC on integers
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_co_int (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_co_int (pk, ck, val) VALUES (1, 50, 'fifty')
----

exec
INSERT INTO keys_co_int (pk, ck, val) VALUES (1, 10, 'ten')
----

exec
INSERT INTO keys_co_int (pk, ck, val) VALUES (1, 30, 'thirty')
----

exec
INSERT INTO keys_co_int (pk, ck, val) VALUES (1, 40, 'forty')
----

exec
INSERT INTO keys_co_int (pk, ck, val) VALUES (1, 20, 'twenty')
----

# Default order is ASC regardless of insertion order.
query
SELECT pk, ck, val FROM keys_co_int WHERE pk = 1
----
pk ck val
1 10 ten
1 20 twenty
1 30 thirty
1 40 forty
1 50 fifty

# Explicit ORDER BY ASC matches default.
query
SELECT pk, ck, val FROM keys_co_int WHERE pk = 1 ORDER BY ck ASC
----
pk ck val
1 10 ten
1 20 twenty
1 30 thirty
1 40 forty
1 50 fifty

# ORDER BY DESC reverses clustering order.
query
SELECT pk, ck, val FROM keys_co_int WHERE pk = 1 ORDER BY ck DESC
----
pk ck val
1 50 fifty
1 40 forty
1 30 thirty
1 20 twenty
1 10 ten

