# ---------------------------------------------------------------
# Clustering order across partitions
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_co_cross (pk text, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_co_cross (pk, ck, val) VALUES ('p1', 3, 'p1-three')
----

exec
INSERT INTO keys_co_cross (pk, ck, val) VALUES ('p1', 1, 'p1-one')
----

exec
INSERT INTO keys_co_cross (pk, ck, val) VALUES ('p1', 2, 'p1-two')
----

exec
INSERT INTO keys_co_cross (pk, ck, val) VALUES ('p2', 2, 'p2-two')
----

exec
INSERT INTO keys_co_cross (pk, ck, val) VALUES ('p2', 1, 'p2-one')
----

# Each partition maintains its own clustering order.
query
SELECT pk, ck, val FROM keys_co_cross WHERE pk = 'p1'
----
pk ck val
p1 1 p1-one
p1 2 p1-two
p1 3 p1-three

query
SELECT pk, ck, val FROM keys_co_cross WHERE pk = 'p2'
----
pk ck val
p2 1 p2-one
p2 2 p2-two

# DESC within a single partition.
query
SELECT pk, ck, val FROM keys_co_cross WHERE pk = 'p1' ORDER BY ck DESC
----
pk ck val
p1 3 p1-three
p1 2 p1-two
p1 1 p1-one
