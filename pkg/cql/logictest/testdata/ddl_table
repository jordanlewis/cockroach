# DDL tests for CQL tables (CREATE, DROP, ALTER).
#
# CREATE TABLE is supported with column definitions and PRIMARY KEY.
# DROP TABLE and ALTER TABLE are not yet implemented in the parser.

exec
CREATE KEYSPACE IF NOT EXISTS test_ddl_ks WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

exec
USE test_ddl_ks
----

# ---------------------------------------------------------------
# CREATE TABLE: basic forms
# ---------------------------------------------------------------

# Simple table with a single partition key.
exec
CREATE TABLE lt_ddl_basic (id int, name text, PRIMARY KEY (id))
----

# Insert and query to verify the table exists.
exec
INSERT INTO lt_ddl_basic (id, name) VALUES (1, 'alice')
----

query
SELECT id, name FROM lt_ddl_basic WHERE id = 1
----
id name
1 alice

# CREATE TABLE IF NOT EXISTS on an existing table.
exec
CREATE TABLE IF NOT EXISTS lt_ddl_basic (id int, name text, PRIMARY KEY (id))
----

# Table with inline PRIMARY KEY syntax.
exec
CREATE TABLE lt_ddl_inline_pk (id uuid PRIMARY KEY, value text)
----

# ---------------------------------------------------------------
# CREATE TABLE: composite and clustering keys
# ---------------------------------------------------------------

# Table with composite partition key.
exec
CREATE TABLE lt_ddl_composite_pk (region text, user_id int, data text, PRIMARY KEY ((region, user_id)))
----

# Insert and verify composite partition key table.
exec
INSERT INTO lt_ddl_composite_pk (region, user_id, data) VALUES ('us-east', 1, 'hello')
----

query
SELECT region, user_id, data FROM lt_ddl_composite_pk WHERE region = 'us-east' AND user_id = 1
----
region user_id data
us-east 1 hello

# Table with clustering keys.
exec
CREATE TABLE lt_ddl_clustering (tenant text, ts timestamp, event text, PRIMARY KEY ((tenant), ts))
----

# Table with multiple clustering keys.
exec
CREATE TABLE lt_ddl_multi_ck (app text, env text, ts bigint, msg text, PRIMARY KEY ((app), env, ts))
----

# ---------------------------------------------------------------
# CREATE TABLE: various data types
# ---------------------------------------------------------------

exec
CREATE TABLE lt_ddl_types (pk int, col_text text, col_varchar varchar, col_ascii ascii, col_int int, col_bigint bigint, col_float float, col_double double, col_boolean boolean, col_timestamp timestamp, col_uuid uuid, col_blob blob, col_inet inet, col_decimal decimal, PRIMARY KEY (pk))
----

exec
INSERT INTO lt_ddl_types (pk, col_text, col_int, col_boolean) VALUES (1, 'hello', 42, true)
----

query
SELECT pk, col_text, col_int, col_boolean FROM lt_ddl_types WHERE pk = 1
----
pk col_text col_int col_boolean
1 hello 42 true

# ---------------------------------------------------------------
# CREATE TABLE: qualified name (keyspace.table)
# ---------------------------------------------------------------

exec
CREATE TABLE test_ddl_ks.lt_ddl_qualified (id int, val text, PRIMARY KEY (id))
----

exec
INSERT INTO test_ddl_ks.lt_ddl_qualified (id, val) VALUES (1, 'qualified')
----

query
SELECT id, val FROM test_ddl_ks.lt_ddl_qualified WHERE id = 1
----
id val
1 qualified

