# ---------------------------------------------------------------
# DROP TABLE
# ---------------------------------------------------------------

exec
DROP TABLE lt_ddl_basic
----

# Drop already-dropped table with IF EXISTS — no error.
exec
DROP TABLE IF EXISTS lt_ddl_basic
----

# Re-create for ALTER TABLE tests below.
exec
CREATE TABLE lt_ddl_basic (id int, name text, PRIMARY KEY (id))
----

# ---------------------------------------------------------------
# ALTER TABLE
# ---------------------------------------------------------------

# Add column.
exec
ALTER TABLE lt_ddl_basic ADD email text
----

# Drop column.
exec
ALTER TABLE lt_ddl_basic DROP email
----

# Rename column.
exec
ALTER TABLE lt_ddl_basic RENAME name TO full_name
----

# Rename back for consistency.
exec
ALTER TABLE lt_ddl_basic RENAME full_name TO name
----

# Alter column type (text to varchar — both map to STRING).
exec
ALTER TABLE lt_ddl_basic ALTER name TYPE varchar
----

# ---------------------------------------------------------------
# Table options (parsed but silently ignored)
# ---------------------------------------------------------------

# Table with compaction option.
exec
CREATE TABLE lt_ddl_compact (id int PRIMARY KEY, val text) WITH compaction = {'class': 'LeveledCompactionStrategy'}
----

# Table with gc_grace_seconds.
exec
CREATE TABLE lt_ddl_gc (id int PRIMARY KEY, val text) WITH gc_grace_seconds = 86400
----

# Table with comment.
exec
CREATE TABLE lt_ddl_comment (id int PRIMARY KEY, val text) WITH comment = 'A test table'
----

# Table with default_time_to_live.
exec
CREATE TABLE lt_ddl_ttl (id int PRIMARY KEY, val text) WITH default_time_to_live = 3600
----

# Table with multiple options combined with AND.
exec
CREATE TABLE lt_ddl_multi_opts (id int PRIMARY KEY, val text) WITH gc_grace_seconds = 86400 AND compaction = {'class': 'SizeTieredCompactionStrategy'}
----

