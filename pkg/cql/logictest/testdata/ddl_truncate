# DDL tests for TRUNCATE TABLE and IF EXISTS / IF NOT EXISTS.
#
# TRUNCATE TABLE removes all rows from a table without dropping it.
# DROP TABLE/KEYSPACE removes the object entirely.
# ALTER TABLE is tested in ddl_alter_table.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# TRUNCATE TABLE
#
# TRUNCATE is now parsed and translated to CRDB TRUNCATE TABLE.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS ddl_trunc_t (id int PRIMARY KEY, val text)
----

exec
INSERT INTO ddl_trunc_t (id, val) VALUES (1, 'hello')
----

exec
INSERT INTO ddl_trunc_t (id, val) VALUES (2, 'world')
----

query rowsort
SELECT id, val FROM ddl_trunc_t
----
id val
1 hello
2 world

exec
TRUNCATE TABLE ddl_trunc_t
----

# Table is empty after truncation.
query
SELECT id, val FROM ddl_trunc_t
----
id val

# Re-insert to verify table is still usable.
exec
INSERT INTO ddl_trunc_t (id, val) VALUES (3, 'new')
----

query
SELECT id, val FROM ddl_trunc_t WHERE id = 3
----
id val
3 new

# TRUNCATE without TABLE keyword (also valid in CQL).
exec
TRUNCATE ddl_trunc_t
----

query
SELECT id, val FROM ddl_trunc_t
----
id val

# TRUNCATE with qualified table name.
exec
INSERT INTO ddl_trunc_t (id, val) VALUES (4, 'qualified')
----

exec
TRUNCATE TABLE defaultdb.ddl_trunc_t
----

query
SELECT id, val FROM ddl_trunc_t
----
id val

# ---------------------------------------------------------------
# CREATE TABLE IF NOT EXISTS (supported)
#
# Verifies that IF NOT EXISTS works on both new and existing tables.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS ddl_ine_t (id int PRIMARY KEY, val text)
----

# Repeat CREATE with IF NOT EXISTS — no error on existing table.
exec
CREATE TABLE IF NOT EXISTS ddl_ine_t (id int PRIMARY KEY, val text)
----

# Insert and verify table is usable.
exec
INSERT INTO ddl_ine_t (id, val) VALUES (1, 'exists')
----

query
SELECT id, val FROM ddl_ine_t WHERE id = 1
----
id val
1 exists

# ---------------------------------------------------------------
# CREATE TABLE without IF NOT EXISTS — duplicate table error.
# ---------------------------------------------------------------

error
CREATE TABLE ddl_ine_t (id int PRIMARY KEY, val text)
----
cql-ddl: relation "defaultdb.public.ddl_ine_t" already exists

# ---------------------------------------------------------------
# CREATE KEYSPACE IF NOT EXISTS (supported)
# ---------------------------------------------------------------

exec
CREATE KEYSPACE IF NOT EXISTS ddl_trunc_ks WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

# Repeat — no error on existing keyspace.
exec
CREATE KEYSPACE IF NOT EXISTS ddl_trunc_ks WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

# ---------------------------------------------------------------
# DROP TABLE
#
# DROP TABLE is now parsed and translated to CRDB DROP TABLE.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS ddl_drop_t (id int PRIMARY KEY, val text)
----

exec
DROP TABLE ddl_drop_t
----

exec
DROP TABLE IF EXISTS ddl_drop_t
----

# DROP with qualified name.
exec
CREATE TABLE IF NOT EXISTS ddl_drop_t2 (id int PRIMARY KEY, val text)
----

exec
DROP TABLE defaultdb.ddl_drop_t2
----

# ---------------------------------------------------------------
# DROP KEYSPACE
# ---------------------------------------------------------------

exec
CREATE KEYSPACE IF NOT EXISTS ddl_drop_ks WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

exec
DROP KEYSPACE ddl_drop_ks
----

exec
CREATE KEYSPACE IF NOT EXISTS ddl_drop_ks2 WITH replication = {'class': 'SimpleStrategy', 'replication_factor': '1'}
----

exec
DROP KEYSPACE IF EXISTS ddl_drop_ks2
----

# Drop non-existent keyspace with IF EXISTS — no error.
exec
DROP KEYSPACE IF EXISTS ddl_nonexistent_ks
----

# ---------------------------------------------------------------
# ALTER TABLE (tested in ddl_alter_table)
#
# Basic smoke test to confirm ALTER TABLE is recognized.
# ---------------------------------------------------------------

exec
ALTER TABLE ddl_ine_t ADD email text
----

exec
ALTER TABLE ddl_ine_t DROP email
----

# ALTER TABLE IF EXISTS is parsed but IF EXISTS is not used in
# the CRDB translation (CRDB ALTER TABLE does not support IF EXISTS).
# The statement succeeds because the table exists.
exec
ALTER TABLE ddl_ine_t ADD email text
----

exec
ALTER TABLE ddl_ine_t DROP email
----

# ---------------------------------------------------------------
# CREATE INDEX IF NOT EXISTS (unsupported)
#
# The parser dispatches CREATE to parseCreate, which only handles
# KEYSPACE and TABLE — not INDEX.
# ---------------------------------------------------------------

error
CREATE INDEX ddl_ine_idx ON ddl_ine_t (val)
----
at position 7: expected KEYSPACE or TABLE after CREATE, got "INDEX"

error
CREATE INDEX IF NOT EXISTS ddl_ine_idx ON ddl_ine_t (val)
----
at position 7: expected KEYSPACE or TABLE after CREATE, got "INDEX"
