# ORDER BY clause.
#
# CQL ORDER BY is limited to clustering columns and only reverses the
# clustering order (ASC/DESC). Since the CQL layer translates ORDER BY
# directly to SQL, CRDB handles ordering on any column.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS sel_ob (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO sel_ob (pk, ck, val) VALUES (1, 10, 'alpha')
----

exec
INSERT INTO sel_ob (pk, ck, val) VALUES (1, 30, 'gamma')
----

exec
INSERT INTO sel_ob (pk, ck, val) VALUES (1, 20, 'beta')
----

# ORDER BY on clustering column (default ASC).
query
SELECT pk, ck, val FROM sel_ob WHERE pk = 1 ORDER BY ck
----
pk ck val
1 10 alpha
1 20 beta
1 30 gamma

# ORDER BY with ASC.
query
SELECT pk, ck, val FROM sel_ob WHERE pk = 1 ORDER BY ck ASC
----
pk ck val
1 10 alpha
1 20 beta
1 30 gamma

# ORDER BY with DESC.
query
SELECT pk, ck, val FROM sel_ob WHERE pk = 1 ORDER BY ck DESC
----
pk ck val
1 30 gamma
1 20 beta
1 10 alpha

# ORDER BY on non-clustering column (valid in CRDB, not in Cassandra).
query
SELECT pk, ck, val FROM sel_ob WHERE pk = 1 ORDER BY val
----
pk ck val
1 10 alpha
1 20 beta
1 30 gamma
