# LIMIT and PER PARTITION LIMIT.
#
# LIMIT restricts the total number of rows returned. PER PARTITION
# LIMIT restricts rows per partition. LIMIT is translated to SQL
# LIMIT; PER PARTITION LIMIT is translated to a ROW_NUMBER() window
# function subquery.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS sel_lim (pk int, val text, PRIMARY KEY (pk))
----

exec
INSERT INTO sel_lim (pk, val) VALUES (1, 'one')
----

exec
INSERT INTO sel_lim (pk, val) VALUES (2, 'two')
----

exec
INSERT INTO sel_lim (pk, val) VALUES (3, 'three')
----

exec
INSERT INTO sel_lim (pk, val) VALUES (4, 'four')
----

# LIMIT 1 returns a single row.
query
SELECT pk, val FROM sel_lim WHERE pk = 1 LIMIT 1
----
pk val
1 one

# LIMIT 2 returns up to two rows.
query rowsort
SELECT pk, val FROM sel_lim LIMIT 2
----
pk val
1 one
2 two

# LIMIT larger than row count returns all rows.
query rowsort
SELECT pk, val FROM sel_lim LIMIT 100
----
pk val
1 one
2 two
3 three
4 four

# LIMIT with WHERE clause.
query rowsort
SELECT pk, val FROM sel_lim WHERE pk > 1 LIMIT 2
----
pk val
2 two
3 three

# PER PARTITION LIMIT 1: each partition has exactly 1 row (pk is
# the partition key and is unique), so all rows are returned.
query rowsort
SELECT * FROM sel_lim PER PARTITION LIMIT 1
----
pk val
1 one
2 two
3 three
4 four

# PER PARTITION LIMIT combined with regular LIMIT. PPL 2 keeps
# all rows (each partition has at most 1), then LIMIT 10 caps
# the total (only 4 rows exist).
query rowsort
SELECT * FROM sel_lim PER PARTITION LIMIT 2 LIMIT 10
----
pk val
1 one
2 two
3 three
4 four

# ---------------------------------------------------------------
# PER PARTITION LIMIT with clustering order
# ---------------------------------------------------------------

# Table with default (ASC) clustering order.
exec
CREATE TABLE IF NOT EXISTS sel_lim_ck (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO sel_lim_ck (pk, ck, val) VALUES (1, 30, 'thirty')
----

exec
INSERT INTO sel_lim_ck (pk, ck, val) VALUES (1, 10, 'ten')
----

exec
INSERT INTO sel_lim_ck (pk, ck, val) VALUES (1, 20, 'twenty')
----

exec
INSERT INTO sel_lim_ck (pk, ck, val) VALUES (2, 200, 'two hundred')
----

exec
INSERT INTO sel_lim_ck (pk, ck, val) VALUES (2, 100, 'one hundred')
----

# PER PARTITION LIMIT 2 with default ASC clustering: returns the
# two lowest ck values per partition.
query rowsort
SELECT * FROM sel_lim_ck PER PARTITION LIMIT 2
----
pk ck val
1 10 ten
1 20 twenty
2 100 one hundred
2 200 two hundred

# Table with DESC clustering order.
exec
CREATE TABLE IF NOT EXISTS sel_lim_ck_desc (pk int, ck int, val text, PRIMARY KEY (pk, ck)) WITH CLUSTERING ORDER BY (ck DESC)
----

exec
INSERT INTO sel_lim_ck_desc (pk, ck, val) VALUES (1, 30, 'thirty')
----

exec
INSERT INTO sel_lim_ck_desc (pk, ck, val) VALUES (1, 10, 'ten')
----

exec
INSERT INTO sel_lim_ck_desc (pk, ck, val) VALUES (1, 20, 'twenty')
----

exec
INSERT INTO sel_lim_ck_desc (pk, ck, val) VALUES (2, 200, 'two hundred')
----

exec
INSERT INTO sel_lim_ck_desc (pk, ck, val) VALUES (2, 100, 'one hundred')
----

# PER PARTITION LIMIT 2 with DESC clustering: returns the two
# highest ck values per partition.
query rowsort
SELECT * FROM sel_lim_ck_desc PER PARTITION LIMIT 2
----
pk ck val
1 20 twenty
1 30 thirty
2 100 one hundred
2 200 two hundred

# PER PARTITION LIMIT 1 with DESC clustering: returns only the
# highest ck value per partition.
query rowsort
SELECT * FROM sel_lim_ck_desc PER PARTITION LIMIT 1
----
pk ck val
1 30 thirty
2 200 two hundred
