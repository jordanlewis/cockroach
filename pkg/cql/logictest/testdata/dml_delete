# DML tests for CQL DELETE statements.
#
# CQL DELETE removes entire rows by primary key. Column-level DELETE
# (DELETE col1, col2 FROM table WHERE ...) is a Cassandra feature that
# sets individual columns to null (tombstones); this syntax is not yet
# supported by the parser. DELETE IF EXISTS is accepted (SQL DELETE
# WHERE is already a no-op for missing rows). DELETE with IF conditions
# translates IF predicates to additional WHERE clauses so the delete
# only applies when conditions match.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS dml_del (pk int, ck int, name text, val int, PRIMARY KEY (pk, ck))
----

# Seed data.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 10, 'alice', 100)
----

exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 20, 'bob', 200)
----

exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 30, 'carol', 300)
----

exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (2, 10, 'dave', 400)
----

exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (2, 20, 'eve', 500)
----

# Verify seed data.
query rowsort
SELECT pk, ck, name, val FROM dml_del
----
pk ck name val
1 10 alice 100
1 20 bob 200
1 30 carol 300
2 10 dave 400
2 20 eve 500

# ---------------------------------------------------------------
# DELETE entire row by full primary key.
# ---------------------------------------------------------------

exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 30
----

query rowsort
SELECT pk, ck, name FROM dml_del WHERE pk = 1
----
pk ck name
1 10 alice
1 20 bob

# ---------------------------------------------------------------
# DELETE with only partition key (deletes all rows in partition).
# ---------------------------------------------------------------

# Re-seed pk=1, ck=30 for this test.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 30, 'carol', 300)
----

exec
DELETE FROM dml_del WHERE pk = 2
----

# Verify all pk=2 rows are gone.
query
SELECT pk, ck, name FROM dml_del WHERE pk = 2
----
pk ck name

# Verify pk=1 rows are still present.
query rowsort
SELECT pk, ck, name FROM dml_del WHERE pk = 1
----
pk ck name
1 10 alice
1 20 bob
1 30 carol

# ---------------------------------------------------------------
# DELETE non-existent row → no-op.
# ---------------------------------------------------------------

exec
DELETE FROM dml_del WHERE pk = 999 AND ck = 1
----

# ---------------------------------------------------------------
# DELETE IF EXISTS: row exists → row is deleted.
#
# IF EXISTS is accepted by the parser. SQL DELETE WHERE is already
# a no-op for missing rows, so this is semantically equivalent.
# ---------------------------------------------------------------

exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 30 IF EXISTS
----

query rowsort
SELECT pk, ck, name FROM dml_del WHERE pk = 1
----
pk ck name
1 10 alice
1 20 bob

# DELETE IF EXISTS on missing row → no-op.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 30 IF EXISTS
----

# ---------------------------------------------------------------
# DELETE with IN clause.
# ---------------------------------------------------------------

exec
DELETE FROM dml_del WHERE pk IN (10, 11)
----

# ---------------------------------------------------------------
# DELETE specific columns (tombstones) — unsupported.
#
# In Cassandra, DELETE col1, col2 FROM table WHERE ... sets those
# columns to null (tombstones) rather than removing the entire row.
# The parser expects FROM immediately after DELETE, so column names
# are interpreted as the expected FROM keyword.
# ---------------------------------------------------------------

error
DELETE name FROM dml_del WHERE pk = 1 AND ck = 10
----
at position 7: expected FROM, got "name"

error
DELETE name, val FROM dml_del WHERE pk = 1 AND ck = 10
----
at position 7: expected FROM, got "name"

# ---------------------------------------------------------------
# DELETE with IF conditions (lightweight transactions).
#
# CQL DELETE with IF col = val performs a conditional delete. IF
# conditions are translated to additional WHERE predicates.
# ---------------------------------------------------------------

# IF condition does not match → no-op. (pk=1,ck=10 has alice/100)
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10 IF name = 'wrong'
----

# Row is still present.
query
SELECT pk, ck, name, val FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 alice 100

# IF condition matches → row is deleted.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10 IF name = 'alice'
----

query
SELECT pk, ck, name FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name

# Re-insert for further tests.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 10, 'alice', 100)
----

# IF != condition matches → row is deleted.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10 IF name != 'bob'
----

query
SELECT pk, ck, name FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name

# Re-insert for multiple conditions test.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 10, 'alice', 100)
----

# Multiple IF conditions: all match → row is deleted.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10 IF name = 'alice' AND val = 100
----

query
SELECT pk, ck, name FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name

# Re-insert for partial match test.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 10, 'alice', 100)
----

# Multiple IF conditions: one doesn't match → no-op.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10 IF name = 'alice' AND val = 999
----

query
SELECT pk, ck, name, val FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 alice 100

# ---------------------------------------------------------------
# Tombstone behavior: INSERT after DELETE restores the row.
#
# In Cassandra, a DELETE creates a tombstone marker. A subsequent
# INSERT for the same primary key overwrites the tombstone and
# restores the row. CockroachDB achieves the same effect through
# standard SQL DELETE + UPSERT semantics.
# ---------------------------------------------------------------

# Verify the row exists.
query
SELECT pk, ck, name, val FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 alice 100

# Delete it.
exec
DELETE FROM dml_del WHERE pk = 1 AND ck = 10
----

# Verify it's gone.
query
SELECT pk, ck, name FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name

# Re-insert with different values — the "tombstone" is overwritten.
exec
INSERT INTO dml_del (pk, ck, name, val) VALUES (1, 10, 'revived', 777)
----

query
SELECT pk, ck, name, val FROM dml_del WHERE pk = 1 AND ck = 10
----
pk ck name val
1 10 revived 777
