# Collection type: map.
#
# CQL maps are key-value collections (e.g., map<text, int>). They
# support element insertion, update by key, and element removal.
# The parser accepts map<K,V> type syntax and map literal syntax
# ({key: val, ...}), but the translator does not yet map these to
# CRDB SQL types. These tests document the expected errors.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with map column — unsupported type.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_map (id int PRIMARY KEY, attrs map<text, text>)
----
unsupported CQL type "map" for column "attrs"

# Bare map type (without angle brackets).
error
CREATE TABLE lt_coll_map2 (id int, data map, PRIMARY KEY (id))
----
at position 40: map type requires type parameters (e.g. map<text, int>)

# Map with int values.
error
CREATE TABLE lt_coll_map3 (id int PRIMARY KEY, scores map<text, int>)
----
unsupported CQL type "map" for column "scores"

# Map with boolean values.
error
CREATE TABLE lt_coll_map4 (id int PRIMARY KEY, flags map<text, boolean>)
----
unsupported CQL type "map" for column "flags"

# ---------------------------------------------------------------
# Frozen map column — unsupported frozen modifier.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_fmap (id int PRIMARY KEY, data frozen<map<text, text>>)
----
unsupported CQL type "frozen" for column "data"

# ---------------------------------------------------------------
# INSERT with map literal — translator rejects map expression.
#
# CQL map literals use braces with colon-separated entries:
# {'key1': 'val1', 'key2': 'val2'}. The parser accepts this
# syntax but the translator cannot convert it to SQL.
# ---------------------------------------------------------------

error
INSERT INTO lt_coll_map (id, attrs) VALUES (1, {'color': 'red', 'size': 'large'})
----
translating INSERT value: unsupported expression type: *parser.MapExprLiteral

# ---------------------------------------------------------------
# UPDATE with map literal — translator rejects map expression.
# ---------------------------------------------------------------

error
UPDATE lt_coll_map SET attrs = {'key': 'val'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.MapExprLiteral

# ---------------------------------------------------------------
# Map element insertion (SET col[key] = val) — subscript
# assignment unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_map SET attrs['newkey'] = 'newval' WHERE id = 1
----
at position 28: expected '=', got "["

# ---------------------------------------------------------------
# Map append (SET col = col + {...}) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_map SET attrs = attrs + {'extra': 'val'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.MapExprLiteral

# ---------------------------------------------------------------
# Map key removal (SET col = col - {...}) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_map SET attrs = attrs - {'unwanted'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.SetLiteral

# ---------------------------------------------------------------
# Nested map (map<text, map<text, int>>) — unsupported.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_nested_map (id int PRIMARY KEY, nested map<text, map<text, int>>)
----
unsupported CQL type "map" for column "nested"

# ---------------------------------------------------------------
# Map used as clustering key — unsupported type.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_map_ck (pk int, ck map<text, int>, val text, PRIMARY KEY (pk, ck))
----
unsupported CQL type "map" for column "ck"
