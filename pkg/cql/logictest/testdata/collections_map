# Collection type: map.
#
# CQL maps are key-value collections (e.g., map<text, int>). They
# are stored as JSONB objects in CockroachDB. Map literals
# ({key: val, ...}) translate to jsonb_build_object() calls; merge
# and key removal use JSONB || and - operators.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with map columns — maps map<K,V> to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_map (id int PRIMARY KEY, attrs map<text, text>)
----

# Bare map type (without angle brackets) is still a parser error.
error
CREATE TABLE lt_coll_map2 (id int, data map, PRIMARY KEY (id))
----
at position 40: map type requires type parameters (e.g. map<text, int>)

# Map with int values.
exec
CREATE TABLE lt_coll_map3 (id int PRIMARY KEY, scores map<text, int>)
----

# Map with boolean values.
exec
CREATE TABLE lt_coll_map4 (id int PRIMARY KEY, flags map<text, boolean>)
----

# ---------------------------------------------------------------
# Frozen map column — frozen<T> also maps to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_fmap (id int PRIMARY KEY, data frozen<map<text, text>>)
----

# ---------------------------------------------------------------
# INSERT with map literal — translates to jsonb_build_object().
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_map (id, attrs) VALUES (1, {'color': 'red', 'size': 'large'})
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 1
----
id attrs
1 {"color": "red", "size": "large"}

# ---------------------------------------------------------------
# UPDATE with map literal — full replacement.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_map SET attrs = {'key': 'val'} WHERE id = 1
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 1
----
id attrs
1 {"key": "val"}

# ---------------------------------------------------------------
# Map element insertion (SET col[key] = val) — jsonb_set.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_map SET attrs['newkey'] = 'newval' WHERE id = 1
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 1
----
id attrs
1 {"key": "val", "newkey": "newval"}

# ---------------------------------------------------------------
# Map append (SET col = col + {...}) — JSONB merge via ||.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_map SET attrs = attrs + {'extra': 'val2'} WHERE id = 1
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 1
----
id attrs
1 {"extra": "val2", "key": "val", "newkey": "newval"}

# ---------------------------------------------------------------
# Map key removal (SET col = col - {...}) — JSONB key removal.
# CQL syntax: col = col - {'key'} removes the key from the map.
# Translates to JSONB subtraction: "col" - jsonb_build_array('key').
# ---------------------------------------------------------------

exec
UPDATE lt_coll_map SET attrs = attrs - {'extra'} WHERE id = 1
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 1
----
id attrs
1 {"key": "val", "newkey": "newval"}

# ---------------------------------------------------------------
# Nested map (map<text, map<text, int>>) — works via JSONB nesting.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_nested_map (id int PRIMARY KEY, nested map<text, map<text, int>>)
----

exec
INSERT INTO lt_coll_nested_map (id, nested) VALUES (1, {'outer': {'inner': 42}})
----

query
SELECT id, nested FROM lt_coll_nested_map WHERE id = 1
----
id nested
1 {"outer": {"inner": 42}}

# ---------------------------------------------------------------
# Map used as clustering key — CRDB accepts JSONB in PK but it
# is generally not recommended for collections.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_map_ck (pk int, ck map<text, int>, val text, PRIMARY KEY (pk, ck))
----

# ---------------------------------------------------------------
# Empty map literal.
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_map (id, attrs) VALUES (2, {})
----

query
SELECT id, attrs FROM lt_coll_map WHERE id = 2
----
id attrs
2 {}
