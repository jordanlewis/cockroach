# Collection type: list.
#
# CQL lists are ordered collections of elements (e.g., list<text>).
# They are stored as JSONB arrays in CockroachDB. List literals
# ([...]) translate to jsonb_build_array() calls; append/prepend
# use JSONB concatenation (||).

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with list columns — maps list<T> to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_list (id int PRIMARY KEY, tags list<text>)
----

# Bare list type (without angle brackets) is still a parser error.
error
CREATE TABLE lt_coll_list2 (id int, data list, PRIMARY KEY (id))
----
at position 41: list type requires type parameters (e.g. list<text>)

# List of integers.
exec
CREATE TABLE lt_coll_list3 (id int PRIMARY KEY, nums list<int>)
----

# List of UUIDs.
exec
CREATE TABLE lt_coll_list4 (id int PRIMARY KEY, ids list<uuid>)
----

# ---------------------------------------------------------------
# Frozen list column — frozen<T> also maps to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_flist (id int PRIMARY KEY, items frozen<list<int>>)
----

# ---------------------------------------------------------------
# INSERT with list literal — translates to jsonb_build_array().
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_list (id, tags) VALUES (1, ['hello', 'world'])
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 1
----
id tags
1 ['hello', 'world']

# ---------------------------------------------------------------
# UPDATE with list literal — full replacement.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_list SET tags = ['a', 'b'] WHERE id = 1
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 1
----
id tags
1 ['a', 'b']

# ---------------------------------------------------------------
# List append (SET col = col + [...]) — JSONB concatenation.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_list SET tags = tags + ['c'] WHERE id = 1
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 1
----
id tags
1 ['a', 'b', 'c']

# ---------------------------------------------------------------
# List prepend (SET col = [...] + col) — JSONB concatenation.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_list SET tags = ['z'] + tags WHERE id = 1
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 1
----
id tags
1 ['z', 'a', 'b', 'c']

# ---------------------------------------------------------------
# List removal (SET col = col - [...]) — JSONB subtraction.
# Note: JSONB - array removes by value for objects (keys), but
# for arrays it only works with integer index removal. CQL list
# removal by value is approximated here.
# ---------------------------------------------------------------

# Removal by index (CRDB JSONB supports integer index removal).
exec
UPDATE lt_coll_list SET tags = tags - 0 WHERE id = 1
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 1
----
id tags
1 ['a', 'b', 'c']

# ---------------------------------------------------------------
# Nested list (list<list<int>>) — works via JSONB nesting.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_nested_list (id int PRIMARY KEY, matrix list<list<int>>)
----

exec
INSERT INTO lt_coll_nested_list (id, matrix) VALUES (1, [[1, 2], [3, 4]])
----

query
SELECT id, matrix FROM lt_coll_nested_list WHERE id = 1
----
id matrix
1 [[1, 2], [3, 4]]

# ---------------------------------------------------------------
# Empty list literal.
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_list (id, tags) VALUES (2, [])
----

query
SELECT id, tags FROM lt_coll_list WHERE id = 2
----
id tags
2 NULL
