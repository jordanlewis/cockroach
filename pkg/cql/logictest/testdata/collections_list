# Collection type: list.
#
# CQL lists are ordered collections of elements (e.g., list<text>).
# They support positional access, append, prepend, and removal.
# The parser accepts list<T> type syntax and list literal syntax ([...]),
# but the translator does not yet map these to CRDB SQL types.
# These tests document the expected errors.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with list column — unsupported type.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_list (id int PRIMARY KEY, tags list<text>)
----
unsupported CQL type "list" for column "tags"

# Bare list type (without angle brackets).
error
CREATE TABLE lt_coll_list2 (id int, data list, PRIMARY KEY (id))
----
at position 41: list type requires type parameters (e.g. list<text>)

# List of integers.
error
CREATE TABLE lt_coll_list3 (id int PRIMARY KEY, nums list<int>)
----
unsupported CQL type "list" for column "nums"

# List of UUIDs.
error
CREATE TABLE lt_coll_list4 (id int PRIMARY KEY, ids list<uuid>)
----
unsupported CQL type "list" for column "ids"

# ---------------------------------------------------------------
# Frozen list column — unsupported frozen modifier.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_flist (id int PRIMARY KEY, items frozen<list<int>>)
----
unsupported CQL type "frozen" for column "items"

# ---------------------------------------------------------------
# INSERT with list literal — translator rejects list expression.
#
# CQL list literals use square brackets: [1, 2, 3]. The parser
# accepts this syntax but the translator cannot convert it to SQL.
# ---------------------------------------------------------------

error
INSERT INTO lt_coll_list (id, tags) VALUES (1, ['hello', 'world'])
----
translating INSERT value: unsupported expression type: *parser.ListLiteral

# ---------------------------------------------------------------
# UPDATE with list literal — translator rejects list expression.
# ---------------------------------------------------------------

error
UPDATE lt_coll_list SET tags = ['a', 'b'] WHERE id = 1
----
translating SET value: unsupported expression type: *parser.ListLiteral

# ---------------------------------------------------------------
# List append (SET col = col + [...]) — binary expressions unsupported.
# ---------------------------------------------------------------

error
INSERT INTO lt_coll_list (id, tags) VALUES (1, ['a'] + ['b'])
----
at position 53: expected ')', got "+"

# ---------------------------------------------------------------
# List prepend (SET col = [...] + col) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_list SET tags = ['prepend'] + tags WHERE id = 1
----
at position 43: expected WHERE, got "+"

# ---------------------------------------------------------------
# List removal (SET col = col - [...]) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_list SET tags = tags - ['remove'] WHERE id = 1
----
translating SET value: unsupported expression type: *parser.ListLiteral

# ---------------------------------------------------------------
# Nested list (list<list<int>>) — unsupported.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_nested_list (id int PRIMARY KEY, matrix list<list<int>>)
----
unsupported CQL type "list" for column "matrix"
