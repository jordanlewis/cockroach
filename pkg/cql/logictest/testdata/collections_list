# ---------------------------------------------------------------
# INSERT with list literal — lexer rejects square brackets.
#
# CQL list literals use square brackets: [1, 2, 3]. The lexer
# does not recognize '[' and produces an unexpected character error.
# ---------------------------------------------------------------

error
INSERT INTO lt_coll_list (id, tags) VALUES (1, ['hello', 'world'])
