# DDL tests for CQL ALTER TABLE operations.
#
# CQL ALTER TABLE supports ADD, DROP, RENAME, and ALTER (type change)
# on columns, as well as table-level property changes via WITH. ADD,
# DROP, and RENAME are translated to CRDB equivalents. ALTER TYPE
# is translated but may fail at execution. WITH properties produce
# a translation error.

exec
USE defaultdb
----

# Create tables to use as targets for ALTER TABLE operations.
exec
CREATE TABLE IF NOT EXISTS lt_alt_basic (id int, name text, PRIMARY KEY (id))
----

exec
INSERT INTO lt_alt_basic (id, name) VALUES (1, 'alice')
----

exec
INSERT INTO lt_alt_basic (id, name) VALUES (2, 'bob')
----

# Verify the base table.
query rowsort
SELECT id, name FROM lt_alt_basic
----
id name
1 alice
2 bob

exec
CREATE TABLE IF NOT EXISTS lt_alt_compound (tenant text, user_id int, email text, age int, PRIMARY KEY ((tenant), user_id))
----

exec
INSERT INTO lt_alt_compound (tenant, user_id, email, age) VALUES ('acme', 1, 'alice@acme.com', 30)
----

# ---------------------------------------------------------------
# ALTER TABLE ADD column
#
# In Cassandra, ALTER TABLE t ADD col type adds a new column. This
# is now translated to ALTER TABLE ... ADD COLUMN ... in CRDB.
# ---------------------------------------------------------------

# Add a single text column.
exec
ALTER TABLE lt_alt_basic ADD email text
----

# Add a single integer column.
exec
ALTER TABLE lt_alt_basic ADD age int
----

# Add a column with a different type (boolean).
exec
ALTER TABLE lt_alt_basic ADD active boolean
----

# Add a column with type uuid.
exec
ALTER TABLE lt_alt_basic ADD ref_id uuid
----

# Add a column with type timestamp.
exec
ALTER TABLE lt_alt_basic ADD created_at timestamp
----

# Add a column with type blob.
exec
ALTER TABLE lt_alt_basic ADD data blob
----

# Add to a table with compound primary key.
exec
ALTER TABLE lt_alt_compound ADD phone text
----

# Add with qualified table name (keyspace.table).
exec
ALTER TABLE defaultdb.lt_alt_basic ADD extra text
----

# ---------------------------------------------------------------
# ALTER TABLE DROP column
#
# In Cassandra, ALTER TABLE t DROP col removes a non-key column.
# Dropping primary key columns is not allowed in Cassandra.
# ---------------------------------------------------------------

# Drop a non-key column (we added 'extra' above).
exec
ALTER TABLE lt_alt_basic DROP extra
----

# Drop from a table with clustering keys.
exec
ALTER TABLE lt_alt_compound DROP phone
----

# Drop the email column from compound table.
exec
ALTER TABLE lt_alt_compound DROP email
----

# Drop with qualified table name.
exec
ALTER TABLE defaultdb.lt_alt_basic DROP data
----

# ---------------------------------------------------------------
# ALTER TABLE RENAME column
#
# In Cassandra, RENAME is restricted to primary key columns. The
# syntax is: ALTER TABLE t RENAME old_name TO new_name. CRDB
# supports renaming any column.
# ---------------------------------------------------------------

# Rename a non-key column.
exec
ALTER TABLE lt_alt_basic RENAME active TO is_active
----

# Rename back.
exec
ALTER TABLE lt_alt_basic RENAME is_active TO active
----

# Rename with qualified table name.
exec
ALTER TABLE defaultdb.lt_alt_basic RENAME active TO is_active
----

# Rename back again for consistency.
exec
ALTER TABLE defaultdb.lt_alt_basic RENAME is_active TO active
----

# ---------------------------------------------------------------
# ALTER TABLE ALTER column type
#
# In Cassandra, ALTER TABLE t ALTER col TYPE new_type changes a
# column's data type. Only compatible type changes are allowed.
# CRDB supports some type changes via ALTER COLUMN SET DATA TYPE.
# ---------------------------------------------------------------

# Change text to varchar (both map to STRING in CRDB, so this
# is a no-op type change that CRDB accepts).
exec
ALTER TABLE lt_alt_basic ALTER name TYPE varchar
----

# Change int to bigint (widening INT4 to INT8 — CRDB supports this).
exec
ALTER TABLE lt_alt_compound ALTER age TYPE bigint
----

# Change int to text — PK column type change requires rewrite, CRDB rejects.
error
ALTER TABLE lt_alt_basic ALTER id TYPE text
----
cql-ddl: unimplemented: ALTER COLUMN TYPE requiring rewrite of on-disk data is currently not supported for columns that are part of an index

# Change text to blob — incompatible, CRDB rejects.
error
ALTER TABLE lt_alt_compound ALTER age TYPE blob
----
cql-ddl: column "age" cannot be cast automatically to type BYTES

# ---------------------------------------------------------------
# ALTER TABLE WITH properties
#
# In Cassandra, ALTER TABLE ... WITH allows changing table-level
# options like compaction, gc_grace_seconds, and comments. These
# have no CRDB equivalent and are silently accepted for
# compatibility.
# ---------------------------------------------------------------

# Change compaction strategy — silently accepted.
exec
ALTER TABLE lt_alt_basic WITH compaction = {'class': 'LeveledCompactionStrategy'}
----

# Change gc_grace_seconds — silently accepted.
exec
ALTER TABLE lt_alt_basic WITH gc_grace_seconds = 86400
----

# Change default_time_to_live — silently accepted.
exec
ALTER TABLE lt_alt_basic WITH default_time_to_live = 3600
----

# Add a comment to the table — silently accepted.
exec
ALTER TABLE lt_alt_basic WITH comment = 'A test table with metadata'
----

# Multiple property changes with AND — silently accepted.
exec
ALTER TABLE lt_alt_basic WITH gc_grace_seconds = 86400 AND compaction = {'class': 'SizeTieredCompactionStrategy'}
----

# ---------------------------------------------------------------
# Verify base tables have been modified by successful operations.
# ---------------------------------------------------------------

query rowsort
SELECT id, name FROM lt_alt_basic
----
id name
1 alice
2 bob

query
SELECT tenant, user_id, age FROM lt_alt_compound WHERE tenant = 'acme' AND user_id = 1
----
tenant user_id age
acme 1 30
