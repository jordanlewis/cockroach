# Lightweight transactions: UPDATE IF conditions.
#
# CQL UPDATE with IF clause performs a conditional update: the
# mutation only applies if the condition evaluates to true against
# the current row. UPDATE IF conditions (IF col = val) are not yet
# supported by the translator and produce errors. Plain UPDATE and
# UPDATE IF EXISTS work.

exec
USE defaultdb
----

# Create a table (shared across tests in this file).
exec
CREATE TABLE IF NOT EXISTS lwt_upd (id int, name text, val int, PRIMARY KEY (id))
----

# ---------------------------------------------------------------
# Plain UPDATE (without IF) is now supported.
# ---------------------------------------------------------------

exec
INSERT INTO lwt_upd (id, name, val) VALUES (1, 'alice', 100)
----

exec
UPDATE lwt_upd SET name = 'bob' WHERE id = 1
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 bob 100

# ---------------------------------------------------------------
# UPDATE multiple columns.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'carol', val = 200 WHERE id = 1
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 carol 200

# ---------------------------------------------------------------
# UPDATE IF EXISTS: row exists → update succeeds.
# (IF EXISTS is accepted but treated as a plain UPDATE since SQL
# UPDATE WHERE already handles the non-existence case as a no-op.)
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET val = 300 WHERE id = 1 IF EXISTS
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 carol 300

# ---------------------------------------------------------------
# UPDATE IF column = value (conditional) is not yet supported.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'bob' WHERE id = 1 IF name = 'alice'
----
UPDATE with IF conditions is not yet supported

# ---------------------------------------------------------------
# UPDATE IF column != value is not yet supported.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET val = 200 WHERE id = 1 IF val != 100
----
UPDATE with IF conditions is not yet supported

# ---------------------------------------------------------------
# UPDATE with multiple IF conditions is not yet supported.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'both' WHERE id = 1 IF name = 'alice' AND val = 100
----
UPDATE with IF conditions is not yet supported
