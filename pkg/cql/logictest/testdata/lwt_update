# Lightweight transactions: UPDATE IF conditions.
#
# CQL UPDATE with IF clause performs a conditional update: the
# mutation only applies if the condition evaluates to true against
# the current row. Supported conditions in Cassandra include
# IF col = val, IF col != val, IF col IN (...), and IF col IS NOT
# NULL. The result always includes an [applied] boolean column.
#
# UPDATE is not yet supported by the CQL parser. All forms produce
# a parse error.

exec
USE defaultdb
----

# Create a table (shared across tests in this file).
exec
CREATE TABLE IF NOT EXISTS lwt_upd (id int, name text, val int, PRIMARY KEY (id))
----

# ---------------------------------------------------------------
# UPDATE IF column = value.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'bob' WHERE id = 1 IF name = 'alice'
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# UPDATE IF column != value.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET val = 200 WHERE id = 1 IF val != 100
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# UPDATE IF column IN (...).
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'updated' WHERE id = 1 IF name IN ('alice', 'bob')
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# UPDATE IF column IS NOT NULL.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET val = 999 WHERE id = 1 IF val IS NOT NULL
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# UPDATE with multiple conditions: IF a = 1 AND b = 2.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'both' WHERE id = 1 IF name = 'alice' AND val = 100
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# Plain UPDATE (without IF) is also unsupported.
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'plain' WHERE id = 1
----
at position 0: unsupported statement "UPDATE"

# ---------------------------------------------------------------
# UPDATE IF EXISTS (applies only if row exists).
# ---------------------------------------------------------------

error
UPDATE lwt_upd SET name = 'exists' WHERE id = 1 IF EXISTS
----
at position 0: unsupported statement "UPDATE"
