# Lightweight transactions: UPDATE IF conditions.
#
# CQL UPDATE with IF clause performs a conditional update: the
# mutation only applies if the condition evaluates to true against
# the current row. IF conditions are translated to additional WHERE
# predicates in the SQL UPDATE.

exec
USE defaultdb
----

# Create a table (shared across tests in this file).
exec
CREATE TABLE IF NOT EXISTS lwt_upd (id int, name text, val int, PRIMARY KEY (id))
----

# ---------------------------------------------------------------
# Plain UPDATE (without IF) is supported.
# ---------------------------------------------------------------

exec
INSERT INTO lwt_upd (id, name, val) VALUES (1, 'alice', 100)
----

exec
UPDATE lwt_upd SET name = 'bob' WHERE id = 1
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 bob 100

# ---------------------------------------------------------------
# UPDATE multiple columns.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'carol', val = 200 WHERE id = 1
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 carol 200

# ---------------------------------------------------------------
# UPDATE IF EXISTS: row exists → update succeeds.
# (IF EXISTS is accepted but treated as a plain UPDATE since SQL
# UPDATE WHERE already handles the non-existence case as a no-op.)
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET val = 300 WHERE id = 1 IF EXISTS
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 carol 300

# ---------------------------------------------------------------
# UPDATE IF column = value: condition matches → update applies.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'dave' WHERE id = 1 IF name = 'carol'
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 dave 300

# ---------------------------------------------------------------
# UPDATE IF column = value: condition does NOT match → no-op.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'eve' WHERE id = 1 IF name = 'alice'
----

# Row is unchanged because the IF condition was false.
query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 dave 300

# ---------------------------------------------------------------
# UPDATE IF column != value: condition matches → update applies.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET val = 999 WHERE id = 1 IF val != 100
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 dave 999

# ---------------------------------------------------------------
# UPDATE IF column != value: condition does NOT match → no-op.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET val = 0 WHERE id = 1 IF val != 999
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 dave 999

# ---------------------------------------------------------------
# UPDATE with multiple IF conditions: all must match.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'frank', val = 500 WHERE id = 1 IF name = 'dave' AND val = 999
----

query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 frank 500

# ---------------------------------------------------------------
# UPDATE with multiple IF conditions: one does not match → no-op.
# ---------------------------------------------------------------

exec
UPDATE lwt_upd SET name = 'ghost' WHERE id = 1 IF name = 'frank' AND val = 100
----

# val is 500, not 100, so the update is a no-op.
query
SELECT id, name, val FROM lwt_upd WHERE id = 1
----
id name val
1 frank 500
