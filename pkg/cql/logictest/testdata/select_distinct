# DISTINCT on partition key.
#
# CQL DISTINCT returns only distinct partition key values, avoiding
# duplicate rows from clustering columns. The parser does not handle
# DISTINCT: it reads "DISTINCT" as a column name in the selector list,
# then fails because the next token is not FROM.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS sel_dist (pk int, ck int, val text, PRIMARY KEY (pk, ck))
----

# DISTINCT on partition key.
error
SELECT DISTINCT pk FROM sel_dist
----
at position 16: expected FROM, got "pk"

# DISTINCT with multiple partition key columns.
error
SELECT DISTINCT pk, ck FROM sel_dist
----
at position 16: expected FROM, got "pk"

# DISTINCT *.
error
SELECT DISTINCT * FROM sel_dist
----
at position 16: expected FROM, got "*"
