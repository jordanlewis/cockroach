# Primary key tests: partition keys.
#
# Covers simple single-column partition keys and composite partition
# keys ((a, b)). Verifies that partition key columns correctly identify
# rows, including edge cases like empty results and multiple partitions.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# Simple partition key (single column)
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_pk_simple (pk int, val text, PRIMARY KEY (pk))
----

exec
INSERT INTO keys_pk_simple (pk, val) VALUES (1, 'one')
----

exec
INSERT INTO keys_pk_simple (pk, val) VALUES (2, 'two')
----

exec
INSERT INTO keys_pk_simple (pk, val) VALUES (3, 'three')
----

# Exact partition key lookup.
query
SELECT pk, val FROM keys_pk_simple WHERE pk = 2
----
pk val
2 two

# Lookup for non-existent partition key returns no rows.
query
SELECT pk, val FROM keys_pk_simple WHERE pk = 999
----
pk val

# Full table scan (no WHERE clause) returns all rows.
query rowsort
SELECT pk, val FROM keys_pk_simple
----
pk val
1 one
2 two
3 three

# Duplicate partition key is an upsert (CQL INSERT = upsert).
exec
INSERT INTO keys_pk_simple (pk, val) VALUES (2, 'updated')
----

query
SELECT pk, val FROM keys_pk_simple WHERE pk = 2
----
pk val
2 updated

