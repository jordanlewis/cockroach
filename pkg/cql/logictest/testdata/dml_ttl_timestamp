# USING TTL and USING TIMESTAMP on individual DML statements.
#
# CQL supports per-row TTL (time-to-live) and explicit write timestamps
# via USING TTL and USING TIMESTAMP clauses on INSERT, UPDATE, and
# DELETE. The parser accepts these clauses for compatibility, but they
# are silently ignored during translation — CockroachDB does not
# support per-row TTL or write timestamps.
#
# See also: batch_ttl_timestamp (USING in BATCH context).

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS ttl_t (id int, ck int, val text, PRIMARY KEY (id, ck))
----

# ---------------------------------------------------------------
# INSERT with USING TTL
# ---------------------------------------------------------------

# USING TTL sets a per-row time-to-live in seconds. Parsed but ignored.
exec
INSERT INTO ttl_t (id, ck, val) VALUES (1, 1, 'ephemeral') USING TTL 3600
----

# ---------------------------------------------------------------
# INSERT with USING TIMESTAMP
# ---------------------------------------------------------------

# USING TIMESTAMP sets an explicit write timestamp in microseconds.
# Parsed but ignored.
exec
INSERT INTO ttl_t (id, ck, val) VALUES (2, 1, 'timed') USING TIMESTAMP 1234567890
----

# ---------------------------------------------------------------
# INSERT with both USING TTL and TIMESTAMP
# ---------------------------------------------------------------

exec
INSERT INTO ttl_t (id, ck, val) VALUES (3, 1, 'both') USING TTL 3600 AND TIMESTAMP 1234567890
----

# ---------------------------------------------------------------
# INSERT IF NOT EXISTS with USING TTL
#
# In CQL, USING can follow IF NOT EXISTS. Parsed but ignored.
# ---------------------------------------------------------------

exec
INSERT INTO ttl_t (id, ck, val) VALUES (4, 1, 'guarded') IF NOT EXISTS USING TTL 3600
----

# INSERT IF NOT EXISTS with both USING TTL AND TIMESTAMP.
exec
INSERT INTO ttl_t (id, ck, val) VALUES (5, 1, 'both_guards') IF NOT EXISTS USING TTL 3600 AND TIMESTAMP 1234567890
----

# ---------------------------------------------------------------
# UPDATE with USING TTL
#
# In CQL, USING TTL appears between the table name and SET:
#   UPDATE t USING TTL n SET col = val WHERE ...
# Parsed but ignored.
# ---------------------------------------------------------------

exec
UPDATE ttl_t USING TTL 3600 SET val = 'updated' WHERE id = 1 AND ck = 1
----

# ---------------------------------------------------------------
# UPDATE with USING TIMESTAMP
# ---------------------------------------------------------------

exec
UPDATE ttl_t USING TIMESTAMP 1234567890 SET val = 'ts' WHERE id = 1 AND ck = 1
----

# UPDATE with both USING TTL AND TIMESTAMP.
exec
UPDATE ttl_t USING TTL 3600 AND TIMESTAMP 1234567890 SET val = 'both' WHERE id = 1 AND ck = 1
----

# ---------------------------------------------------------------
# DELETE with USING TIMESTAMP
#
# In CQL, USING TIMESTAMP appears between the table name and WHERE:
#   DELETE FROM t USING TIMESTAMP n WHERE ...
# Parsed but ignored.
# ---------------------------------------------------------------

exec
DELETE FROM ttl_t USING TIMESTAMP 1234567890 WHERE id = 1 AND ck = 1
----

# DELETE with USING TTL (not valid in Cassandra, but the parser
# accepts it for generality — the clause is silently ignored).
exec
DELETE FROM ttl_t USING TTL 3600 WHERE id = 1 AND ck = 1
----

# ---------------------------------------------------------------
# Verify normal operations still work (no USING).
# ---------------------------------------------------------------

exec
INSERT INTO ttl_t (id, ck, val) VALUES (10, 1, 'normal')
----

query
SELECT id, ck, val FROM ttl_t WHERE id = 10 AND ck = 1
----
id ck val
10 1 normal

exec
UPDATE ttl_t SET val = 'changed' WHERE id = 10 AND ck = 1
----

query
SELECT id, ck, val FROM ttl_t WHERE id = 10 AND ck = 1
----
id ck val
10 1 changed

exec
DELETE FROM ttl_t WHERE id = 10 AND ck = 1
----

query
SELECT id, ck, val FROM ttl_t WHERE id = 10
----
id ck val
