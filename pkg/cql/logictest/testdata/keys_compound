----

exec
INSERT INTO keys_cpk_composite (pk1, pk2, ck, val) VALUES ('us', 1, 100, 'alpha')
----

exec
INSERT INTO keys_cpk_composite (pk1, pk2, ck, val) VALUES ('us', 1, 300, 'gamma')
----

exec
INSERT INTO keys_cpk_composite (pk1, pk2, ck, val) VALUES ('us', 1, 200, 'beta')
----

exec
INSERT INTO keys_cpk_composite (pk1, pk2, ck, val) VALUES ('us', 2, 100, 'delta')
----

exec
INSERT INTO keys_cpk_composite (pk1, pk2, ck, val) VALUES ('eu', 1, 100, 'epsilon')
