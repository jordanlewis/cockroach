exec
CREATE TABLE IF NOT EXISTS keys_cpk_full (pk1 text, pk2 int, ck1 int, ck2 text, val text, PRIMARY KEY ((pk1, pk2), ck1, ck2))
----

exec
INSERT INTO keys_cpk_full (pk1, pk2, ck1, ck2, val) VALUES ('a', 1, 10, 'x', 'v1')
----

exec
INSERT INTO keys_cpk_full (pk1, pk2, ck1, ck2, val) VALUES ('a', 1, 10, 'y', 'v2')
