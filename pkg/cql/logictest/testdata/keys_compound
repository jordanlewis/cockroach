# ---------------------------------------------------------------
# Partition isolation: same clustering key values in different partitions
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS keys_cpk_isolation (pk text, ck int, val text, PRIMARY KEY (pk, ck))
----

exec
INSERT INTO keys_cpk_isolation (pk, ck, val) VALUES ('part-a', 1, 'a1')
----

exec
INSERT INTO keys_cpk_isolation (pk, ck, val) VALUES ('part-a', 2, 'a2')
----

exec
INSERT INTO keys_cpk_isolation (pk, ck, val) VALUES ('part-b', 1, 'b1')
----

exec
INSERT INTO keys_cpk_isolation (pk, ck, val) VALUES ('part-b', 2, 'b2')
----

# Each partition has independent rows.
query
SELECT pk, ck, val FROM keys_cpk_isolation WHERE pk = 'part-a'
----
pk ck val
part-a 1 a1
part-a 2 a2

query
SELECT pk, ck, val FROM keys_cpk_isolation WHERE pk = 'part-b'
----
pk ck val
part-b 1 b1
part-b 2 b2

# Full scan shows all partitions.
query rowsort
SELECT pk, ck, val FROM keys_cpk_isolation
----
pk ck val
part-a 1 a1
part-a 2 a2
part-b 1 b1
part-b 2 b2
