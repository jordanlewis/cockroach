# Tuples and frozen collection types.
#
# The parser accepts tuple<T,...> and frozen<T> type syntax, but the
# translator does not yet map these to CRDB SQL types. These tests
# document the expected errors.

exec
USE defaultdb
----

# Tuple column type.
error
CREATE TABLE tuple_table (id int PRIMARY KEY, coords tuple<int, int>)
----
unsupported CQL type "tuple" for column "coords"

# Frozen tuple column type.
error
CREATE TABLE frozen_tuple_table (id int PRIMARY KEY, coords frozen<tuple<int, int>>)
----
unsupported CQL type "frozen" for column "coords"

# Frozen map column type.
error
CREATE TABLE frozen_map_table (id int PRIMARY KEY, data frozen<map<text, text>>)
----
unsupported CQL type "frozen" for column "data"

# Frozen set column type.
error
CREATE TABLE frozen_set_table (id int PRIMARY KEY, tags frozen<set<text>>)
----
unsupported CQL type "frozen" for column "tags"

# Frozen list column type.
error
CREATE TABLE frozen_list_table (id int PRIMARY KEY, items frozen<list<int>>)
----
unsupported CQL type "frozen" for column "items"
