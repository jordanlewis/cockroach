# JSON operations, CAST, and type conversion syntax.
#
# CQL provides JSON-oriented features: INSERT JSON inserts a row from
# a JSON string, SELECT JSON returns results as JSON, and toJson() /
# fromJson() convert between CQL values and JSON text. CAST(col AS
# type) performs explicit type conversions.
#
# INSERT JSON and SELECT JSON parse successfully but are not yet
# supported at translation time. toJson() maps to CRDB's to_jsonb()
# but JSONB results may not map to a CQL type. fromJson() is not
# supported. CAST maps directly to SQL CAST.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS json_t (id int, name text, age int, active boolean, PRIMARY KEY (id))
----

exec
INSERT INTO json_t (id, name, age, active) VALUES (1, 'alice', 30, true)
----

exec
INSERT INTO json_t (id, name, age, active) VALUES (2, 'bob', 25, false)
----

# ---------------------------------------------------------------
# INSERT JSON
#
# INSERT JSON (bare, without INTO) is not valid CQL syntax.
# INSERT INTO <table> JSON '...' parses but is not yet supported.
# ---------------------------------------------------------------

# INSERT JSON without INTO — invalid CQL syntax.
error
INSERT JSON '{"id": 10, "name": "charlie", "age": 35, "active": true}'
----
at position 7: expected INTO, got "JSON"

# INSERT JSON with DEFAULT UNSET — invalid CQL syntax.
error
INSERT JSON '{"id": 11, "name": "dave"}' DEFAULT UNSET
----
at position 7: expected INTO, got "JSON"

# INSERT JSON with DEFAULT NULL — invalid CQL syntax.
error
INSERT JSON '{"id": 12}' DEFAULT NULL
----
at position 7: expected INTO, got "JSON"

# INSERT INTO <table> JSON — parses but not yet supported.
error
INSERT INTO json_t JSON '{"id": 13, "name": "eve"}'
----
INSERT JSON is not yet supported

# ---------------------------------------------------------------
# SELECT JSON
#
# SELECT JSON parses but is not yet supported at translation time.
# ---------------------------------------------------------------

# SELECT JSON * — not yet supported.
error
SELECT JSON * FROM json_t
----
SELECT JSON is not yet supported

# SELECT JSON with specific columns.
error
SELECT JSON id, name FROM json_t
----
SELECT JSON is not yet supported

# SELECT JSON with WHERE clause.
error
SELECT JSON * FROM json_t WHERE id = 1
----
SELECT JSON is not yet supported

# ---------------------------------------------------------------
# toJson() function
#
# toJson() maps to CRDB's to_jsonb(). The result is JSONB which
# may not map to a CQL wire type.
# ---------------------------------------------------------------

# toJson on a column — translates to to_jsonb() but CRDB returns JSONB,
# which is not mapped to a CQL wire type.
error
SELECT toJson(name) FROM json_t WHERE id = 1
----
mapping column "to_jsonb": no CQL type mapping for CRDB type JSONB (family 18)

# toJson on the entire row via * — not valid SQL.
error
SELECT toJson(*) FROM json_t
----
translating selector: unsupported CQL function "toJson"

# ---------------------------------------------------------------
# fromJson() function
#
# fromJson() is not yet supported.
# ---------------------------------------------------------------

# fromJson in INSERT VALUES.
error
INSERT INTO json_t (id, name) VALUES (20, fromJson('"frank"'))
----
translating INSERT value: unsupported CQL function "fromJson"

# fromJson in SELECT.
error
SELECT fromJson(name) FROM json_t WHERE id = 1
----
translating selector: unsupported CQL function "fromJson"

# ---------------------------------------------------------------
# CAST operations
#
# CAST(column AS type) maps to SQL CAST with CQL-to-CRDB type mapping.
# ---------------------------------------------------------------

# CAST in SELECT list.
exec
SELECT CAST(id AS bigint) FROM json_t
----

# CAST with text type.
exec
SELECT CAST(age AS text) FROM json_t
----

# Multiple CASTs.
exec
SELECT CAST(id AS bigint), CAST(age AS text) FROM json_t
----

# CAST in WHERE clause.
exec
SELECT * FROM json_t WHERE CAST(id AS bigint) > 0
----

# ---------------------------------------------------------------
# Verify normal operations still work.
# ---------------------------------------------------------------

query rowsort
SELECT id, name, age, active FROM json_t
----
id name age active
1 alice 30 true
2 bob 25 false
