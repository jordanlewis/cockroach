# Lightweight transactions: DELETE IF conditions.
#
# CQL DELETE with IF clause performs a conditional delete: the row
# is removed only if the condition evaluates to true. DELETE IF
# EXISTS is supported. DELETE with IF conditions (IF col = val)
# is not yet supported.

exec
USE defaultdb
----

# Create a table and insert test data.
exec
CREATE TABLE IF NOT EXISTS lwt_del (id int, name text, val int, PRIMARY KEY (id))
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (1, 'alice', 100)
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (2, 'bob', 200)
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (3, 'carol', 300)
----

# ---------------------------------------------------------------
# Plain DELETE (without IF).
# ---------------------------------------------------------------

exec
DELETE FROM lwt_del WHERE id = 3
----

# Verify row is deleted.
query rowsort
SELECT id, name FROM lwt_del
----
id name
1 alice
2 bob

# ---------------------------------------------------------------
# DELETE IF EXISTS: row exists → delete succeeds.
# (IF EXISTS is accepted; SQL DELETE WHERE is a no-op for missing
# rows, so the behavior is equivalent.)
# ---------------------------------------------------------------

exec
DELETE FROM lwt_del WHERE id = 2 IF EXISTS
----

query
SELECT id, name FROM lwt_del
----
id name
1 alice

# ---------------------------------------------------------------
# DELETE IF EXISTS on missing row → no-op (SQL DELETE WHERE is
# already a no-op for missing rows).
# ---------------------------------------------------------------

exec
DELETE FROM lwt_del WHERE id = 999 IF EXISTS
----

# ---------------------------------------------------------------
# DELETE IF column = value is not yet supported.
# ---------------------------------------------------------------

error
DELETE FROM lwt_del WHERE id = 1 IF name = 'alice'
----
DELETE with IF conditions is not yet supported

# ---------------------------------------------------------------
# DELETE IF column != value is not yet supported.
# ---------------------------------------------------------------

error
DELETE FROM lwt_del WHERE id = 1 IF name != 'alice'
----
DELETE with IF conditions is not yet supported

# ---------------------------------------------------------------
# DELETE with multiple IF conditions is not yet supported.
# ---------------------------------------------------------------

error
DELETE FROM lwt_del WHERE id = 1 IF name = 'alice' AND val = 100
----
DELETE with IF conditions is not yet supported
