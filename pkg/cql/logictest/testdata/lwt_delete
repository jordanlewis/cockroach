# Lightweight transactions: DELETE IF conditions.
#
# CQL DELETE with IF clause performs a conditional delete: the row
# is removed only if the condition evaluates to true. The result is a
# rows result set with an [applied] column, matching Cassandra's LWT
# semantics.

exec
USE defaultdb
----

# Create a table and insert test data.
exec
CREATE TABLE IF NOT EXISTS lwt_del (id int, name text, val int, PRIMARY KEY (id))
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (1, 'alice', 100)
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (2, 'bob', 200)
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (3, 'carol', 300)
----

# ---------------------------------------------------------------
# Plain DELETE (without IF).
# ---------------------------------------------------------------

exec
DELETE FROM lwt_del WHERE id = 3
----

# Verify row is deleted.
query rowsort
SELECT id, name FROM lwt_del
----
id name
1 alice
2 bob

# ---------------------------------------------------------------
# DELETE IF EXISTS: row exists → delete succeeds, [applied]=true.
# ---------------------------------------------------------------

query
DELETE FROM lwt_del WHERE id = 2 IF EXISTS
----
[applied]
true

query
SELECT id, name FROM lwt_del
----
id name
1 alice

# ---------------------------------------------------------------
# DELETE IF EXISTS on missing row → [applied]=false.
# ---------------------------------------------------------------

query
DELETE FROM lwt_del WHERE id = 999 IF EXISTS
----
[applied]
false

# ---------------------------------------------------------------
# DELETE IF column = value: condition matches → [applied]=true.
# ---------------------------------------------------------------

# Re-insert rows for conditional delete tests.
exec
INSERT INTO lwt_del (id, name, val) VALUES (10, 'dave', 400)
----

exec
INSERT INTO lwt_del (id, name, val) VALUES (11, 'eve', 500)
----

query
DELETE FROM lwt_del WHERE id = 10 IF name = 'dave'
----
[applied]
true

# Verify row was deleted.
query
SELECT id, name FROM lwt_del WHERE id = 10
----
id name

# ---------------------------------------------------------------
# DELETE IF column = value: condition does NOT match →
# [applied]=false with existing row.
# ---------------------------------------------------------------

query
DELETE FROM lwt_del WHERE id = 11 IF name = 'not_eve'
----
[applied] id name val
false 11 eve 500

# Row is still present because the IF condition was false.
query
SELECT id, name, val FROM lwt_del WHERE id = 11
----
id name val
11 eve 500

# ---------------------------------------------------------------
# DELETE IF column != value: condition matches → [applied]=true.
# ---------------------------------------------------------------

query
DELETE FROM lwt_del WHERE id = 11 IF name != 'alice'
----
[applied]
true

query
SELECT id, name FROM lwt_del WHERE id = 11
----
id name

# ---------------------------------------------------------------
# DELETE with multiple IF conditions: all must match.
# ---------------------------------------------------------------

exec
INSERT INTO lwt_del (id, name, val) VALUES (20, 'frank', 600)
----

query
DELETE FROM lwt_del WHERE id = 20 IF name = 'frank' AND val = 600
----
[applied]
true

query
SELECT id, name FROM lwt_del WHERE id = 20
----
id name

# ---------------------------------------------------------------
# DELETE with multiple IF conditions: one does not match →
# [applied]=false with existing row.
# ---------------------------------------------------------------

exec
INSERT INTO lwt_del (id, name, val) VALUES (21, 'grace', 700)
----

query
DELETE FROM lwt_del WHERE id = 21 IF name = 'grace' AND val = 999
----
[applied] id name val
false 21 grace 700

# val is 700, not 999, so the delete is a no-op.
query
SELECT id, name, val FROM lwt_del WHERE id = 21
----
id name val
21 grace 700
