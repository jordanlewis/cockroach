# Collection type: set.
#
# CQL sets are sorted collections of unique elements (e.g.,
# set<text>). They are stored as JSONB arrays in CockroachDB.
# Set literals ({val, ...}) translate to jsonb_build_array() calls;
# add uses JSONB concatenation (||), removal uses JSONB subtraction.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with set columns — maps set<T> to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_set (id int PRIMARY KEY, emails set<text>)
----

# Bare set type (without angle brackets) is still a parser error.
error
CREATE TABLE lt_coll_set2 (id int, data set, PRIMARY KEY (id))
----
at position 40: set type requires type parameters (e.g. set<text>)

# Set of integers.
exec
CREATE TABLE lt_coll_set3 (id int PRIMARY KEY, nums set<int>)
----

# Set of UUIDs.
exec
CREATE TABLE lt_coll_set4 (id int PRIMARY KEY, ids set<uuid>)
----

# ---------------------------------------------------------------
# Frozen set column — frozen<T> also maps to JSONB.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_fset (id int PRIMARY KEY, tags frozen<set<text>>)
----

# ---------------------------------------------------------------
# INSERT with set literal — translates to jsonb_build_array().
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_set (id, emails) VALUES (1, {'a@example.com', 'b@example.com'})
----

query
SELECT id, emails FROM lt_coll_set WHERE id = 1
----
id emails
1 ["a@example.com", "b@example.com"]

# ---------------------------------------------------------------
# UPDATE with set literal — full replacement.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_set SET emails = {'x@test.com'} WHERE id = 1
----

query
SELECT id, emails FROM lt_coll_set WHERE id = 1
----
id emails
1 ["x@test.com"]

# ---------------------------------------------------------------
# Set add (SET col = col + {...}) — JSONB concatenation.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_set SET emails = emails + {'new@test.com'} WHERE id = 1
----

query
SELECT id, emails FROM lt_coll_set WHERE id = 1
----
id emails
1 ["x@test.com", "new@test.com"]

# ---------------------------------------------------------------
# Set removal (SET col = col - {...}) — JSONB text subtraction
# removes matching string elements from the array.
# ---------------------------------------------------------------

exec
UPDATE lt_coll_set SET emails = emails - {'x@test.com'} WHERE id = 1
----

query
SELECT id, emails FROM lt_coll_set WHERE id = 1
----
id emails
1 ["new@test.com"]

# ---------------------------------------------------------------
# Nested set (set<set<int>>) — works via JSONB nesting.
# ---------------------------------------------------------------

exec
CREATE TABLE lt_coll_nested_set (id int PRIMARY KEY, groups set<set<int>>)
----

# ---------------------------------------------------------------
# Empty set literal.
# ---------------------------------------------------------------

exec
INSERT INTO lt_coll_set (id, emails) VALUES (2, {})
----

query
SELECT id, emails FROM lt_coll_set WHERE id = 2
----
id emails
2 {}
