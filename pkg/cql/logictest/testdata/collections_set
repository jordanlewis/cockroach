# Collection type: set.
#
# CQL sets are sorted collections of unique elements (e.g.,
# set<text>). They support add and remove operations. The parser
# accepts set<T> type syntax and set literal syntax ({...}), but
# the translator does not yet map these to CRDB SQL types. These
# tests document the expected errors.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# CREATE TABLE with set column — unsupported type.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_set (id int PRIMARY KEY, emails set<text>)
----
unsupported CQL type "set" for column "emails"

# Bare set type (without angle brackets).
error
CREATE TABLE lt_coll_set2 (id int, data set, PRIMARY KEY (id))
----
at position 40: set type requires type parameters (e.g. set<text>)

# Set of integers.
error
CREATE TABLE lt_coll_set3 (id int PRIMARY KEY, nums set<int>)
----
unsupported CQL type "set" for column "nums"

# Set of UUIDs.
error
CREATE TABLE lt_coll_set4 (id int PRIMARY KEY, ids set<uuid>)
----
unsupported CQL type "set" for column "ids"

# ---------------------------------------------------------------
# Frozen set column — unsupported frozen modifier.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_fset (id int PRIMARY KEY, tags frozen<set<text>>)
----
unsupported CQL type "frozen" for column "tags"

# ---------------------------------------------------------------
# INSERT with set literal — translator rejects set expression.
#
# CQL set literals use braces: {'a', 'b'}. The parser accepts
# this syntax but the translator cannot convert it to SQL.
# ---------------------------------------------------------------

error
INSERT INTO lt_coll_set (id, emails) VALUES (1, {'a@example.com', 'b@example.com'})
----
translating INSERT value: unsupported expression type: *parser.SetLiteral

# ---------------------------------------------------------------
# UPDATE with set literal — translator rejects set expression.
# ---------------------------------------------------------------

error
UPDATE lt_coll_set SET emails = {'x@test.com'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.SetLiteral

# ---------------------------------------------------------------
# Set add (SET col = col + {...}) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_set SET emails = emails + {'new@test.com'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.SetLiteral

# ---------------------------------------------------------------
# Set removal (SET col = col - {...}) — binary expressions unsupported.
# ---------------------------------------------------------------

error
UPDATE lt_coll_set SET emails = emails - {'old@test.com'} WHERE id = 1
----
translating SET value: unsupported expression type: *parser.SetLiteral

# ---------------------------------------------------------------
# Nested set (set<set<int>>) — unsupported.
# ---------------------------------------------------------------

error
CREATE TABLE lt_coll_nested_set (id int PRIMARY KEY, groups set<set<int>>)
----
unsupported CQL type "set" for column "groups"
