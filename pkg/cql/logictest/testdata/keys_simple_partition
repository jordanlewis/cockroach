# Simple partition key: single-column PRIMARY KEY.
#
# Verifies that a table with a single partition key (no clustering columns)
# stores and retrieves rows correctly. Rows are unordered across partitions,
# so we use rowsort for multi-row queries.

exec
USE defaultdb
----

exec
CREATE TABLE IF NOT EXISTS lt_simple_pk (
    user_id int,
    name text,
    email text,
    PRIMARY KEY (user_id)
)
----

# Insert several rows out of order.
exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (3, 'charlie', 'charlie@example.com')
----

exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (1, 'alice', 'alice@example.com')
----

exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (2, 'bob', 'bob@example.com')
----

exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (5, 'eve', 'eve@example.com')
----

exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (4, 'dave', 'dave@example.com')
----

# Point lookup by partition key.
query
SELECT user_id, name, email FROM lt_simple_pk WHERE user_id = 1
----
user_id name email
1 alice alice@example.com

query
SELECT user_id, name, email FROM lt_simple_pk WHERE user_id = 3
----
user_id name email
3 charlie charlie@example.com

# Full table scan returns all rows (use rowsort — partition ordering is
# not defined for queries spanning multiple partitions).
query rowsort
SELECT user_id, name FROM lt_simple_pk
----
user_id name
1 alice
2 bob
3 charlie
4 dave
5 eve

# Upsert semantics: inserting an existing partition key overwrites the row.
exec
INSERT INTO lt_simple_pk (user_id, name, email) VALUES (2, 'bob_updated', 'bob2@example.com')
----

query
SELECT user_id, name, email FROM lt_simple_pk WHERE user_id = 2
----
user_id name email
2 bob_updated bob2@example.com

# Inline PRIMARY KEY syntax (column-level).
exec
CREATE TABLE IF NOT EXISTS lt_inline_pk (
    id int PRIMARY KEY,
    val text
)
----

exec
INSERT INTO lt_inline_pk (id, val) VALUES (10, 'ten')
----

exec
INSERT INTO lt_inline_pk (id, val) VALUES (20, 'twenty')
----

query
SELECT id, val FROM lt_inline_pk WHERE id = 10
----
id val
10 ten
