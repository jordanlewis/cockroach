# Lightweight transactions: various primary key structures.
#
# Cassandra LWT operates at the partition level. Testing INSERT IF
# NOT EXISTS against tables with different primary key layouts
# (single partition key, composite partition key, partition +
# clustering keys) verifies that the conditional insert correctly
# targets the full primary key.

exec
USE defaultdb
----

# ---------------------------------------------------------------
# Single partition key (simplest case).
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS lwt_pk_single (pk int PRIMARY KEY, data text)
----

query
INSERT INTO lwt_pk_single (pk, data) VALUES (1, 'first') IF NOT EXISTS
----
[applied]
true

# Duplicate returns [applied]=false with existing row.
query
INSERT INTO lwt_pk_single (pk, data) VALUES (1, 'duplicate') IF NOT EXISTS
----
[applied] pk data
false 1 first

query
SELECT pk, data FROM lwt_pk_single WHERE pk = 1
----
pk data
1 first

# ---------------------------------------------------------------
# Partition key + clustering key.
# Same partition key with different clustering key → distinct rows.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS lwt_pk_cluster (pk int, ck int, data text, PRIMARY KEY (pk, ck))
----

query
INSERT INTO lwt_pk_cluster (pk, ck, data) VALUES (1, 1, 'row-1-1') IF NOT EXISTS
----
[applied]
true

query
INSERT INTO lwt_pk_cluster (pk, ck, data) VALUES (1, 2, 'row-1-2') IF NOT EXISTS
----
[applied]
true

# Same (pk=1, ck=1) → [applied]=false with existing row.
query
INSERT INTO lwt_pk_cluster (pk, ck, data) VALUES (1, 1, 'conflict') IF NOT EXISTS
----
[applied] pk ck data
false 1 1 row-1-1

# Different pk entirely → succeeds.
query
INSERT INTO lwt_pk_cluster (pk, ck, data) VALUES (2, 1, 'row-2-1') IF NOT EXISTS
----
[applied]
true

query rowsort
SELECT pk, ck, data FROM lwt_pk_cluster
----
pk ck data
1 1 row-1-1
1 2 row-1-2
2 1 row-2-1

# ---------------------------------------------------------------
# Composite partition key: ((pk1, pk2), ck).
# Both partition key columns must match for a conflict.
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS lwt_pk_composite (pk1 int, pk2 int, ck int, data text, PRIMARY KEY ((pk1, pk2), ck))
----

query
INSERT INTO lwt_pk_composite (pk1, pk2, ck, data) VALUES (1, 1, 1, 'a') IF NOT EXISTS
----
[applied]
true

# Same pk1 but different pk2 → different partition → succeeds.
query
INSERT INTO lwt_pk_composite (pk1, pk2, ck, data) VALUES (1, 2, 1, 'b') IF NOT EXISTS
----
[applied]
true

# Same (pk1, pk2, ck) → [applied]=false with existing row.
query
INSERT INTO lwt_pk_composite (pk1, pk2, ck, data) VALUES (1, 1, 1, 'conflict') IF NOT EXISTS
----
[applied] pk1 pk2 ck data
false 1 1 1 a

# Same partition, different clustering key → succeeds.
query
INSERT INTO lwt_pk_composite (pk1, pk2, ck, data) VALUES (1, 1, 2, 'c') IF NOT EXISTS
----
[applied]
true

query rowsort
SELECT pk1, pk2, ck, data FROM lwt_pk_composite
----
pk1 pk2 ck data
1 1 1 a
1 1 2 c
1 2 1 b

# ---------------------------------------------------------------
# Multiple clustering keys: PRIMARY KEY (pk, ck1, ck2).
# ---------------------------------------------------------------

exec
CREATE TABLE IF NOT EXISTS lwt_pk_multi_ck (pk int, ck1 int, ck2 int, data text, PRIMARY KEY (pk, ck1, ck2))
----

query
INSERT INTO lwt_pk_multi_ck (pk, ck1, ck2, data) VALUES (1, 1, 1, 'x') IF NOT EXISTS
----
[applied]
true

query
INSERT INTO lwt_pk_multi_ck (pk, ck1, ck2, data) VALUES (1, 1, 2, 'y') IF NOT EXISTS
----
[applied]
true

query
INSERT INTO lwt_pk_multi_ck (pk, ck1, ck2, data) VALUES (1, 2, 1, 'z') IF NOT EXISTS
----
[applied]
true

# Full PK match → [applied]=false with existing row.
query
INSERT INTO lwt_pk_multi_ck (pk, ck1, ck2, data) VALUES (1, 1, 1, 'conflict') IF NOT EXISTS
----
[applied] pk ck1 ck2 data
false 1 1 1 x

query rowsort
SELECT pk, ck1, ck2, data FROM lwt_pk_multi_ck
----
pk ck1 ck2 data
1 1 1 x
1 1 2 y
1 2 1 z
