# BATCH statements.
#
# CQL BATCH groups multiple DML statements into an atomic unit.
# BEGIN BATCH, UNLOGGED BATCH, and COUNTER BATCH are all
# unsupported by the parser. Individual DELETE and UPDATE
# statements are now supported (tested in lwt_delete/lwt_update).

exec
USE defaultdb
----

# Basic BATCH with multiple INSERTs.
error
BEGIN BATCH INSERT INTO t (a) VALUES (1) INSERT INTO t (a) VALUES (2) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# UNLOGGED BATCH (no Paxos commit log).
error
BEGIN UNLOGGED BATCH INSERT INTO t (a) VALUES (1) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# COUNTER BATCH for counter updates. The lexer rejects '+' before
# the parser even sees BEGIN.
error
BEGIN COUNTER BATCH UPDATE counters SET c = c + 1 WHERE id = 1 APPLY BATCH
----
unexpected character '+' at position 46

# BATCH with USING TIMESTAMP.
error
BEGIN BATCH USING TIMESTAMP 1234567890 INSERT INTO t (a) VALUES (1) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# DELETE is now supported as a standalone statement.
exec
CREATE TABLE IF NOT EXISTS batch_del_test (a int PRIMARY KEY, b text)
----

exec
INSERT INTO batch_del_test (a, b) VALUES (1, 'hello')
----

exec
DELETE FROM batch_del_test WHERE a = 1
----

# UPDATE is now supported as a standalone statement.
exec
CREATE TABLE IF NOT EXISTS batch_upd_test (a int PRIMARY KEY, b text)
----

exec
INSERT INTO batch_upd_test (a, b) VALUES (1, 'old')
----

exec
UPDATE batch_upd_test SET b = 'new' WHERE a = 1
----

query
SELECT a, b FROM batch_upd_test WHERE a = 1
----
a b
1 new
