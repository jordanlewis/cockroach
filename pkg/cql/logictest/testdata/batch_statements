# BATCH statements.
#
# CQL BATCH groups multiple DML statements into an atomic unit.
# BEGIN BATCH ... APPLY BATCH is now parsed and executed as a
# transaction. Individual DELETE and UPDATE are supported.

exec
USE defaultdb
----

# Create test tables for batch operations.
exec
CREATE TABLE IF NOT EXISTS batch_t (a int PRIMARY KEY, b text)
----

# Basic BATCH with multiple INSERTs.
exec
BEGIN BATCH INSERT INTO batch_t (a, b) VALUES (1, 'one') INSERT INTO batch_t (a, b) VALUES (2, 'two') APPLY BATCH
----

query rowsort
SELECT a, b FROM batch_t
----
a b
1 one
2 two

# UNLOGGED BATCH (no Paxos commit log — treated the same as logged).
exec
BEGIN UNLOGGED BATCH INSERT INTO batch_t (a, b) VALUES (3, 'three') APPLY BATCH
----

query
SELECT a, b FROM batch_t WHERE a = 3
----
a b
3 three

# COUNTER BATCH for counter updates.
# Counter UPDATEs have upsert semantics: the row is created if it
# doesn't exist, matching Cassandra's behavior.
exec
CREATE TABLE IF NOT EXISTS counters (id int PRIMARY KEY, c counter)
----

# Counter UPDATE in a batch creates the row (upsert).
exec
BEGIN COUNTER BATCH UPDATE counters SET c = c + 1 WHERE id = 1 APPLY BATCH
----

query
SELECT id, c FROM counters WHERE id = 1
----
id c
1 1

# BATCH with USING TIMESTAMP.
exec
BEGIN BATCH USING TIMESTAMP 1234567890 INSERT INTO batch_t (a, b) VALUES (4, 'ts') APPLY BATCH
----

query
SELECT a, b FROM batch_t WHERE a = 4
----
a b
4 ts

# DELETE is supported as a standalone statement.
exec
CREATE TABLE IF NOT EXISTS batch_del_test (a int PRIMARY KEY, b text)
----

exec
INSERT INTO batch_del_test (a, b) VALUES (1, 'hello')
----

exec
DELETE FROM batch_del_test WHERE a = 1
----

# UPDATE is supported as a standalone statement.
exec
CREATE TABLE IF NOT EXISTS batch_upd_test (a int PRIMARY KEY, b text)
----

exec
INSERT INTO batch_upd_test (a, b) VALUES (1, 'old')
----

exec
UPDATE batch_upd_test SET b = 'new' WHERE a = 1
----

query
SELECT a, b FROM batch_upd_test WHERE a = 1
----
a b
1 new
