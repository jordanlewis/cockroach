# BATCH statements.
#
# CQL BATCH groups multiple DML statements into an atomic unit.
# BEGIN BATCH, UNLOGGED BATCH, and COUNTER BATCH are all
# unsupported by the parser.

exec
USE defaultdb
----

# Basic BATCH with multiple INSERTs.
error
BEGIN BATCH INSERT INTO t (a) VALUES (1) INSERT INTO t (a) VALUES (2) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# UNLOGGED BATCH (no Paxos commit log).
error
BEGIN UNLOGGED BATCH INSERT INTO t (a) VALUES (1) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# COUNTER BATCH for counter updates. The lexer rejects '+' before
# the parser even sees BEGIN.
error
BEGIN COUNTER BATCH UPDATE counters SET c = c + 1 WHERE id = 1 APPLY BATCH
----
unexpected character '+' at position 46

# BATCH with USING TIMESTAMP.
error
BEGIN BATCH USING TIMESTAMP 1234567890 INSERT INTO t (a) VALUES (1) APPLY BATCH
----
at position 0: unsupported statement "BEGIN"

# DELETE is not supported (needed for BATCH).
error
DELETE FROM t WHERE a = 1
----
at position 0: unsupported statement "DELETE"

# UPDATE is not supported (needed for BATCH).
error
UPDATE t SET b = 'x' WHERE a = 1
----
at position 0: unsupported statement "UPDATE"
