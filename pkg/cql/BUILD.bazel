load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cql",
    srcs = [
        "auth.go",
        "conn.go",
        "executor.go",
        "server.go",
    ],
    importpath = "github.com/cockroachdb/cockroach/pkg/cql",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/cql/cqlwire",
        "//pkg/cql/parser",
        "//pkg/cql/translate",
        "//pkg/cql/types",
        "//pkg/security/username",
        "//pkg/sql/catalog/colinfo",
        "//pkg/sql/isql",
        "//pkg/sql/sem/tree",
        "//pkg/sql/sessiondata",
        "//pkg/util/log",
        "//pkg/util/metric",
        "//pkg/util/stop",
        "//pkg/util/syncutil",
        "@com_github_cockroachdb_errors//:errors",
        "@com_github_cockroachdb_redact//:redact",
    ],
)

go_test(
    name = "cql_test",
    srcs = [
        "executor_test.go",
        "integration_test.go",
        "server_test.go",
    ],
    embed = [":cql"],
    deps = [
        "//pkg/cql/cqlwire",
        "//pkg/kv",
        "//pkg/sql/catalog",
        "//pkg/sql/catalog/colinfo",
        "//pkg/sql/isql",
        "//pkg/sql/parser/statements",
        "//pkg/sql/sem/tree",
        "//pkg/sql/sessiondata",
        "//pkg/sql/types",
        "//pkg/util/stop",
        "@com_github_cockroachdb_errors//:errors",
        "@com_github_cockroachdb_redact//:redact",
        "@com_github_gocql_gocql//:gocql",
        "@com_github_stretchr_testify//require",
    ],
)
