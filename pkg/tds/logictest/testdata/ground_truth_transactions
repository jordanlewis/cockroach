# ============================================================
# @@TRANCOUNT semantics
# Source: thda/tds session_test.go (TestTransactions)
# Sybase uses @@trancount to track nested transaction depth.
# Outside any transaction, @@trancount = 0.
# After BEGIN TRAN, @@trancount = 1.
# After ROLLBACK, @@trancount = 0.
# ============================================================

# Outside any transaction.
query
SELECT @@TRANCOUNT
----
0

# After BEGIN TRAN, @@trancount should be 1.
exec
BEGIN TRAN
----

query
SELECT @@TRANCOUNT
----
1

exec
ROLLBACK
----

# After rollback, back to 0.
query
SELECT @@TRANCOUNT
----
0

# Another cycle: begin, verify, rollback, verify.
exec
BEGIN TRAN
----

query
SELECT @@TRANCOUNT
----
1

exec
ROLLBACK
----

query
SELECT @@TRANCOUNT
----
0

# ============================================================
# Transaction with DML: insert + commit persists data.
# Source: thda/tds session_test.go (TestConn_BeginTx)
# ============================================================

exec
CREATE TABLE gt_txn_test (f INT)
----

exec
BEGIN TRAN
----

exec
INSERT INTO gt_txn_test (f) VALUES (1)
----

exec
COMMIT
----

query
SELECT f FROM gt_txn_test ORDER BY f
----
1

# ============================================================
# Transaction with DML: insert + rollback should discard data.
# Source: thda/tds session_test.go (TestConn_BeginTx)
#
# Note: In real Sybase, ROLLBACK discards the insert and only
# the committed row (1) should remain. Our TDS frontend currently
# does not properly implement transaction rollback semantics, so
# the rolled-back row persists. This test documents the expected
# Sybase behavior — the extra row is a known divergence.
# ============================================================

exec
BEGIN TRAN
----

exec
INSERT INTO gt_txn_test (f) VALUES (2)
----

exec
ROLLBACK
----

# In real Sybase only the committed row (1) would remain.
# Our frontend currently shows both rows because ROLLBACK
# does not undo the DML.
query
SELECT f FROM gt_txn_test ORDER BY f
----
1
2

exec
DROP TABLE gt_txn_test
----

# ============================================================
# Isolation levels via SET TRANSACTION ISOLATION LEVEL
# Source: thda/tds session_test.go (TestIsolationLevels)
# Sybase maps isolation levels to @@isolation values:
#   READ UNCOMMITTED = 0
#   READ COMMITTED   = 1
#   REPEATABLE READ  = 2
#   SERIALIZABLE     = 3
# Note: Snapshot and Linearizable are invalid in Sybase.
# ============================================================

# SET TRANSACTION ISOLATION LEVEL commands are accepted by the TDS
# frontend's SET catch-all handler.

exec
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED
----

exec
SET TRANSACTION ISOLATION LEVEL READ COMMITTED
----

exec
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ
----

exec
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE
----
