# Basic arithmetic that all drivers rely on.
# ============================================================

query
SELECT 1 + 2
----
3

query
SELECT 10 - 3
----
7

query
SELECT 4 * 5
----
20

query
SELECT 10 / 3
----
3

# ============================================================
# String to integer conversion via CONVERT
# Source: common T-SQL pattern used by all Sybase drivers
# ============================================================

query
SELECT CONVERT(INT, '12345')
----
12345

query
SELECT CONVERT(VARCHAR, 54321)
----
54321

# ============================================================
# ISNULL function (Sybase equivalent of COALESCE for 2 args)
# Source: common Sybase pattern
# ============================================================

query
SELECT ISNULL(NULL, 42)
----
42

query
SELECT ISNULL(10, 42)
----
10
