# ============================================================
# CONVERT function with various types
# Source: thda/tds TestSelect — "cast(X as TYPE)" patterns
# Note: T-SQL CONVERT(type, expr) is equivalent to CAST(expr AS type).
# ============================================================

# Integer conversions.
query
SELECT CONVERT(INT, 42)
----
42

query
SELECT CONVERT(INT, -42)
----
-42

query
SELECT CONVERT(BIGINT, 9223372036854775807)
----
9223372036854775807

# -9223372036854775808 (min int64) cannot be parsed: the T-SQL parser
# treats it as unary minus applied to 9223372036854775808, which
# overflows int64.
query error=(invalid integer)
SELECT CONVERT(BIGINT, -9223372036854775808)
----

query
SELECT CONVERT(SMALLINT, 32767)
----
32767

query
SELECT CONVERT(SMALLINT, -32768)
----
-32768

query
SELECT CONVERT(TINYINT, 0)
----
0

query
SELECT CONVERT(TINYINT, 255)
----
255

# Float conversions.
# thda/tds: "cast(0.5 as float)" => float64(0.5).
query
SELECT CONVERT(FLOAT, 0.5)
----
0.5

# thda/tds: "cast(0.5 as real)" => float32(0.5).
query
SELECT CONVERT(REAL, 0.5)
----
0.5

# Decimal conversions.
# thda/tds: "cast(0.5 as decimal(18,1))" => 0.5.
query
SELECT CONVERT(DECIMAL(18,1), 0.5)
----
0.5

query
SELECT CONVERT(DECIMAL(18,1), -0.5)
----
-0.5

# thda/tds: "cast(-0.5 as numeric(18,1))".
query
SELECT CONVERT(NUMERIC(18,1), -0.5)
----
-0.5

# thda/tds: "cast(-0.5 as numeric(18,2))".
query
SELECT CONVERT(NUMERIC(18,2), -0.5)
----
-0.5

# thda/tds: "cast(4294967296 as numeric(20,0))".
query
SELECT CONVERT(NUMERIC(20,0), 4294967296)
----
4294967296

# Money conversions.
# thda/tds: "cast(1.2345 as money)".
query
SELECT CONVERT(MONEY, 1.2345)
----
1.2345

# thda/tds: "cast(-1.2345 as money)".
query
SELECT CONVERT(MONEY, -1.2345)
----
-1.2345

# thda/tds: "cast(1.2345 as smallmoney)".
query
SELECT CONVERT(SMALLMONEY, 1.2345)
----
1.2345

# thda/tds: "cast(-1.2345 as smallmoney)".
query
SELECT CONVERT(SMALLMONEY, -1.2345)
----
-1.2345

# String conversions.
query
SELECT CONVERT(VARCHAR(10), 'hello')
----
hello

query
SELECT CONVERT(CHAR(5), 'world')
----
world

# BIT conversions.
# thda/tds: "cast(1 as bit)" => true, "cast(0 as bit)" => false.
query
SELECT CONVERT(BIT, 1)
----
1

query
SELECT CONVERT(BIT, 0)
----
0

# NULL conversions.
query
SELECT CONVERT(INT, NULL)
----
NULL

query
SELECT CONVERT(VARCHAR(10), NULL)
----
NULL

query
SELECT CONVERT(FLOAT, NULL)
----
NULL

query
SELECT CONVERT(DECIMAL(10,2), NULL)
----
NULL

