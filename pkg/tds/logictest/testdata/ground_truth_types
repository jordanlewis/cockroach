# ============================================================
# IDENTITY columns
# Source: jTDS Tds5Test.java (testColMetaData) — numeric identity
# Source: thda/tds stmt_test.go (TestIdentity) — int identity
# ============================================================

# Note: IDENTITY(1,1) without explicit NOT NULL triggers a parser
# conflict ("conflicting NULL/NOT NULL declarations"). Use NOT NULL
# explicitly with IDENTITY.
exec
CREATE TABLE gt_identity (id INT IDENTITY(1,1) NOT NULL, name VARCHAR(50))
----

exec
INSERT INTO gt_identity (name) VALUES ('first')
----

exec
INSERT INTO gt_identity (name) VALUES ('second')
----

query colnames
SELECT id, name FROM gt_identity ORDER BY id
----
id  name
1  first
2  second

exec
DROP TABLE gt_identity
----
