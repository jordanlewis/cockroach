# Signed integer boundary values
# Source: jamdb_sybase sql_query_SUITE.erl (signed_integer_datatypes)
# Source: jTDS Tds5Test.java (testBigint)
# Source: thda/tds stmt_test.go (TestConverters)
# ============================================================

# BIGINT: signed 64-bit range.
# jamdb_sybase tests -9223372036854775808 (min); jTDS tests both max/min.
exec
CREATE TABLE gt_signed_bigint (val BIGINT)
----

exec
INSERT INTO gt_signed_bigint (val) VALUES (9223372036854775807)
----

query
SELECT val FROM gt_signed_bigint
----
9223372036854775807

exec
DELETE FROM gt_signed_bigint
----

# -9223372036854775808 (min int64) cannot be parsed: the T-SQL parser
# treats it as unary minus applied to 9223372036854775808, which
# overflows int64. This is a known parser limitation.
exec error=(invalid integer)
INSERT INTO gt_signed_bigint (val) VALUES (-9223372036854775808)
----

exec
DROP TABLE gt_signed_bigint
----

