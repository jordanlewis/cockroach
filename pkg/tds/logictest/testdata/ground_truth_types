# ============================================================
# Float and real precision
# Source: jamdb_sybase sql_query_SUITE.erl (float_datatypes)
# Source: thda/tds stmt_test.go (TestConverters, TestSelect)
# ============================================================

# FLOAT (double precision).
# jamdb_sybase tests 3.14 and -3.14.
query
SELECT CONVERT(FLOAT, 3.14)
----
3.14

query
SELECT CONVERT(FLOAT, -3.14)
----
-3.14

query
SELECT CONVERT(FLOAT, 0.0)
----
0

# thda/tds tests cast(0.5 as float) = 0.5.
query
SELECT CONVERT(FLOAT, 0.5)
----
0.5

# REAL (single precision).
# thda/tds tests cast(0.5 as real) = 0.5.
query
SELECT CONVERT(REAL, 0.5)
----
0.5

