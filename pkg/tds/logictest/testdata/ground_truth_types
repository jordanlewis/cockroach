# ============================================================
# String types: VARCHAR, CHAR, NVARCHAR, NCHAR
# Source: jamdb_sybase sql_query_SUITE.erl (characters_datatypes)
# Source: thda/tds stmt_test.go (TestSelect)
# ============================================================

# Basic VARCHAR.
query
SELECT CONVERT(VARCHAR(10), 'hello')
----
hello

# Basic CHAR (Sybase right-pads CHAR to declared length).
# Note: our TDS frontend maps CHAR to CHAR, which CockroachDB may or may
# not pad depending on collation. This test checks the basic round-trip.
query
SELECT CONVERT(CHAR(5), 'abc')
----
abc

# NVARCHAR (mapped to VARCHAR in CockroachDB).
query
SELECT CONVERT(NVARCHAR(100), 'hello unicode')
----
hello unicode

# ============================================================
# Unicode strings via UNIVARCHAR
# Source: thda/tds stmt_test.go (TestSelect scan into interface{})
# These are actual strings tested by the Go driver against real Sybase.
# ============================================================

# Note: UNIVARCHAR is a Sybase-specific type. Our TDS frontend does not
# yet support UNIVARCHAR as a column type, so we test the string values
# through VARCHAR which handles UTF-8 natively in CockroachDB.

query
SELECT 'hello'
----
hello

query
SELECT 'abc'
----
abc

