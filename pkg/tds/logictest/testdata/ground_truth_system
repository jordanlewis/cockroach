# ============================================================
# SET ROWCOUNT
# SET ROWCOUNT n limits the number of rows affected by DML.
# Silently acknowledged (no semantic effect in CockroachDB yet).
# ============================================================

exec
SET ROWCOUNT 100
----

exec
SET ROWCOUNT 0
----

# ============================================================
# SET IDENTITY_INSERT
# SET IDENTITY_INSERT table ON/OFF allows explicit identity
# column inserts. Silently acknowledged (CockroachDB uses
# GENERATED BY DEFAULT which already allows explicit inserts).
# ============================================================

exec
SET IDENTITY_INSERT mytable ON
----

exec
SET IDENTITY_INSERT mytable OFF
----

# ============================================================
# RAISERROR (Sybase ASE syntax)
# RAISERROR errnum [, 'message'] — sends an error to the client.
# ============================================================

exec error=(custom error)
RAISERROR 50001, 'custom error'
----

exec error=(error 18001)
RAISERROR 18001
----

# ============================================================
# Error handling: EXEC statement
# Source: thda/tds stmt_test.go (TestError)
# In real Sybase, "exec bad" produces error 2812: "Could not
# find stored procedure 'bad'." EXEC is parsed but stored
# procedures are unsupported.
# ============================================================

exec error=(unsupported)
EXEC bad
----

