# ============================================================
# @@TRANCOUNT system variable
# Source: thda/tds session_test.go (TestTransactions)
# @@trancount returns 0 outside transactions, 1 inside.
# ============================================================

query
SELECT @@TRANCOUNT
----
0

# ============================================================
# @@VERSION system variable
# Source: Commonly used by all Sybase drivers for version detection.
# jTDS uses getDatabaseProductVersion() which parses @@VERSION.
# ============================================================

# @@VERSION should return a non-empty string containing CockroachDB.
# We just verify it returns something (the exact format varies).
query
SELECT @@VERSION
----
Adaptive Server Enterprise/16.0/CockroachDB 24.3.0/SP0/Enterprise Linux/x86_64

# ============================================================
# @@IDENTITY after INSERT
# Source: thda/tds stmt_test.go (TestIdentity) — LastInsertId()
#
# In real Sybase, @@IDENTITY returns the last identity value
# inserted in the current session. Each logictest directive
# runs in the same connection, but CockroachDB's lastval()
# (which @@IDENTITY maps to) requires at least one nextval()
# call in the session. The INSERT with IDENTITY triggers
# nextval() under the hood, but @@IDENTITY may fail if the
# session tracking is not fully wired. We test what we can.
# ============================================================

exec
CREATE TABLE gt_sysvar_identity (id INT IDENTITY(1,1) NOT NULL, val INT)
----

exec
INSERT INTO gt_sysvar_identity (val) VALUES (100)
----

exec
INSERT INTO gt_sysvar_identity (val) VALUES (200)
----

# Verify the identity values were assigned correctly.
query colnames
SELECT id, val FROM gt_sysvar_identity ORDER BY id
----
id  val
1  100
2  200

exec
DROP TABLE gt_sysvar_identity
----

