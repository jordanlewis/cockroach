# Cursor lifecycle tests.
#
# T-SQL cursors: DECLARE CURSOR FOR, OPEN, FETCH NEXT FROM, CLOSE, DEALLOCATE.
# Cursor state persists across batches on the same connection, so each
# operation uses a separate exec or query directive.
#
# IMPORTANT: FETCH NEXT must use `query` (not `exec`) because the logictest
# exec directive always returns empty string — only query returns rows.

# ============================================================
# Basic DECLARE CURSOR (parse only, no output)
# ============================================================

exec
DECLARE c1 CURSOR FOR SELECT 1 AS val
----

# ============================================================
# Full cursor lifecycle: 3 rows
# ============================================================

exec
CREATE TABLE cursor_test (id INT NOT NULL, label VARCHAR(20) NOT NULL)
----

exec
INSERT INTO cursor_test VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma')
----

exec
DECLARE cur1 CURSOR FOR SELECT id, label FROM cursor_test ORDER BY id
----

exec
OPEN cur1
----

query
FETCH NEXT FROM cur1
----
1  alpha

query
FETCH NEXT FROM cur1
----
2  beta

query
FETCH NEXT FROM cur1
----
3  gamma

exec
CLOSE cur1
----

exec
DEALLOCATE cur1
----

# ============================================================
# Cursor with WHERE clause filtering
# ============================================================

exec
DECLARE cur2 CURSOR FOR SELECT id, label FROM cursor_test WHERE id >= 2 ORDER BY id
----

exec
OPEN cur2
----

query
FETCH NEXT FROM cur2
----
2  beta

query
FETCH NEXT FROM cur2
----
3  gamma

exec
CLOSE cur2
----

exec
DEALLOCATE cur2
----

# ============================================================
# Single-row cursor
# ============================================================

exec
DECLARE cur3 CURSOR FOR SELECT label FROM cursor_test WHERE id = 1
----

exec
OPEN cur3
----

query
FETCH NEXT FROM cur3
----
alpha

exec
CLOSE cur3
----

exec
DEALLOCATE cur3
----

# ============================================================
# FETCH past end of result set (returns no rows)
# ============================================================

exec
DECLARE cur4 CURSOR FOR SELECT id FROM cursor_test WHERE id = 1
----

exec
OPEN cur4
----

query
FETCH NEXT FROM cur4
----
1

# Second fetch — past end, no rows returned.
query
FETCH NEXT FROM cur4
----

exec
CLOSE cur4
----

exec
DEALLOCATE cur4
----

# ============================================================
# Cleanup
# ============================================================

exec
DROP TABLE cursor_test
----

# ============================================================
# ERROR CASES
# ============================================================

# --- OPEN a cursor that was never declared ---

exec error=(not declared)
OPEN no_such_cursor
----

# --- FETCH from a cursor that was never declared ---

exec error=(not declared)
FETCH NEXT FROM no_such_cursor
----

# --- CLOSE a cursor that was never declared ---

exec error=(not declared)
CLOSE no_such_cursor
----

# --- DEALLOCATE a cursor that was never declared ---

exec error=(not declared)
DEALLOCATE no_such_cursor
----

# --- FETCH from a declared but unopened cursor ---

exec
DECLARE cur_err CURSOR FOR SELECT 1
----

exec error=(not open)
FETCH NEXT FROM cur_err
----

# --- CLOSE a declared but unopened cursor ---

exec error=(not open)
CLOSE cur_err
----

exec
DEALLOCATE cur_err
----
