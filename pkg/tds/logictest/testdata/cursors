# Cursor support coverage tests.
#
# T-SQL cursors (DECLARE CURSOR, OPEN, FETCH NEXT, CLOSE, DEALLOCATE)
# are implemented by the TDS frontend. The cursor lifecycle:
#   DECLARE cursor_name CURSOR FOR select_statement
#   OPEN cursor_name
#   FETCH NEXT FROM cursor_name [INTO @var1, @var2, ...]
#   CLOSE cursor_name
#   DEALLOCATE cursor_name

# ============================================================
# Setup: create a table for cursor tests
# ============================================================

exec
CREATE TABLE cursor_test (id INT PRIMARY KEY, name VARCHAR(50))
----

exec
INSERT INTO cursor_test VALUES (1, 'alice'), (2, 'bob'), (3, 'charlie')
----

# ============================================================
# DECLARE CURSOR — basic syntax
# ============================================================

exec
DECLARE cur1 CURSOR FOR SELECT id, name FROM cursor_test ORDER BY id
----

# ============================================================
# Full cursor lifecycle: DECLARE, OPEN, FETCH, CLOSE, DEALLOCATE
# ============================================================

exec rowsort
DECLARE cur2 CURSOR FOR SELECT id, name FROM cursor_test ORDER BY id;
OPEN cur2;
FETCH NEXT FROM cur2;
FETCH NEXT FROM cur2;
FETCH NEXT FROM cur2;
FETCH NEXT FROM cur2;
CLOSE cur2;
DEALLOCATE cur2
----
1 alice
2 bob
3 charlie

# ============================================================
# DECLARE CURSOR with WHERE clause
# ============================================================

exec rowsort
DECLARE cur3 CURSOR FOR SELECT id, name FROM cursor_test WHERE id > 1 ORDER BY id;
OPEN cur3;
FETCH NEXT FROM cur3;
FETCH NEXT FROM cur3;
FETCH NEXT FROM cur3;
CLOSE cur3;
DEALLOCATE cur3
----
2 bob
3 charlie

# ============================================================
# FETCH past end returns empty result set
# ============================================================

exec
DECLARE cur4 CURSOR FOR SELECT id FROM cursor_test WHERE id = 1;
OPEN cur4;
FETCH NEXT FROM cur4;
FETCH NEXT FROM cur4
----
1

# ============================================================
# Error: OPEN without DECLARE
# ============================================================

exec error=(not declared)
OPEN nonexistent
----

# ============================================================
# Error: FETCH without OPEN
# ============================================================

exec error=(not open)
DECLARE cur5 CURSOR FOR SELECT 1;
FETCH NEXT FROM cur5
----

# ============================================================
# Error: CLOSE without OPEN
# ============================================================

exec error=(not open)
DECLARE cur6 CURSOR FOR SELECT 1;
CLOSE cur6
----

# ============================================================
# Error: DEALLOCATE non-existent cursor
# ============================================================

exec error=(not declared)
DEALLOCATE nonexistent
----

# ============================================================
# Cleanup
# ============================================================

exec
DROP TABLE cursor_test
----
