# ============================================================
# Basic SELECT expressions
# Source: jamdb_sybase select() — "select 1 one, 2 two, 3 three"
# Source: thda/tds TestSingleValue() — "select 1"
# Source: thda/tds TestSelect() — various expressions
# ============================================================

# jamdb_sybase: "select 1 one, 2 two, 3 three" => [1, 2, 3].
query colnames
SELECT 1 AS one, 2 AS two, 3 AS three
----
one  two  three
1  2  3

# thda/tds: "select 1" => int64(1).
query
SELECT 1
----
1

# thda/tds: select with negative integers.
query
SELECT -1
----
-1

