# ============================================================
# INSERT, UPDATE, DELETE cycle
# Source: thda/tds TestAffectedRows() — full CRUD cycle
# ============================================================

exec
CREATE TABLE gt_crud (bar INT)
----

# Empty table select.
query
SELECT COUNT(*) FROM gt_crud
----
0

# Insert first row.
exec
INSERT INTO gt_crud (bar) VALUES (1)
----

query
SELECT bar FROM gt_crud
----
1

# Insert second row.
exec
INSERT INTO gt_crud (bar) VALUES (2)
----

query
SELECT bar FROM gt_crud ORDER BY bar
----
1
2

# Update all rows.
exec
UPDATE gt_crud SET bar = 2
----

query
SELECT bar FROM gt_crud ORDER BY bar
----
2
2

# Delete all rows.
exec
DELETE FROM gt_crud
----

query
SELECT COUNT(*) FROM gt_crud
----
0

exec
DROP TABLE gt_crud
----

# ============================================================
# Multi-result SELECT (multiple statements in one batch)
# Source: jamdb_sybase multi_select()
# "select 1 one, 2 two, 3 three select 1 one, 2 two, 3 three"
# returns two identical result sets.
#
# Note: Our logictest framework processes one query directive at a
# time, so we test the individual queries that would make up the batch.
# ============================================================

query colnames
SELECT 1 AS one, 2 AS two, 3 AS three
----
one  two  three
1  2  3

query colnames
SELECT 1 AS one, 2 AS two, 3 AS three
----
one  two  three
1  2  3

