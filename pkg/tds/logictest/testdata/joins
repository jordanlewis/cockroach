# --- INNER JOIN ---

query error=(parse error)
SELECT c.name, o.product, o.amount FROM j_customers c INNER JOIN j_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----

# --- LEFT JOIN ---

query error=(parse error)
SELECT c.name, o.product FROM j_customers c LEFT JOIN j_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----

# --- LEFT OUTER JOIN (explicit OUTER keyword) ---

query error=(parse error)
SELECT c.name, o.product FROM j_customers c LEFT OUTER JOIN j_orders o ON c.id = o.customer_id ORDER BY c.name
----

# --- RIGHT JOIN ---

query error=(parse error)
SELECT c.name, o.product FROM j_customers c RIGHT JOIN j_orders o ON c.id = o.customer_id ORDER BY o.id
----

# --- FULL OUTER JOIN ---

query error=(parse error)
SELECT c.name, o.product FROM j_customers c FULL OUTER JOIN j_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----

# --- CROSS JOIN ---

query error=(parse error)
SELECT c.name, o.product FROM j_customers c CROSS JOIN j_orders o WHERE c.id = 1 ORDER BY o.product
----

# --- Self-join ---

query error=(parse error)
SELECT a.name AS emp, b.name AS mgr FROM j_customers a INNER JOIN j_customers b ON a.id = b.id + 1
----

# --- Multi-table JOIN ---

exec
CREATE TABLE j_products (id INT, name VARCHAR(50), category VARCHAR(50))
----

exec
INSERT INTO j_products (id, name, category) VALUES (1, 'widget', 'hardware')
----

exec
INSERT INTO j_products (id, name, category) VALUES (2, 'gadget', 'electronics')
----

query error=(parse error)
SELECT c.name, p.name AS product, p.category, o.amount FROM j_customers c INNER JOIN j_orders o ON c.id = o.customer_id INNER JOIN j_products p ON o.product = p.name ORDER BY c.name, p.name
----

# --- JOIN with aggregate ---

query error=(parse error)
SELECT c.name, COUNT(o.id) AS order_count, SUM(o.amount) AS total FROM j_customers c LEFT JOIN j_orders o ON c.id = o.customer_id GROUP BY c.name ORDER BY c.name
----

