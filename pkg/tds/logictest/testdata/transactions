# Transaction control tests: BEGIN TRAN, COMMIT, ROLLBACK, SAVE TRAN.
# Sources: T-SQL reference documentation, go-mssqldb tests (BSD-3-Clause).

# --- BEGIN TRANSACTION ---

exec
BEGIN TRANSACTION
----

# --- BEGIN TRAN (shorthand) ---

exec
BEGIN TRAN
----

# --- COMMIT TRANSACTION ---

exec
COMMIT TRANSACTION
----

# --- COMMIT (shorthand) ---

exec
COMMIT
----

# --- ROLLBACK TRANSACTION ---

exec
ROLLBACK TRANSACTION
----

# --- ROLLBACK (shorthand) ---

exec
ROLLBACK
----

# --- Named transactions ---

exec
BEGIN TRAN myTran
----

# --- SAVE TRANSACTION (savepoint) ---

exec
SAVE TRANSACTION my_savepoint
----

# --- ROLLBACK to savepoint ---

exec
ROLLBACK TRANSACTION my_savepoint
----

# Close the transaction opened by BEGIN TRAN myTran above.

exec
ROLLBACK
----

# Create table for multi-statement batch tests.

exec
CREATE TABLE txn_test_tbl (id INT, name VARCHAR(100))
----

# --- Transaction with DML (full scenario) ---

exec
BEGIN TRAN; INSERT INTO txn_test_tbl (id, name) VALUES (1, 'test'); COMMIT
----

# --- Transaction with rollback (full scenario) ---

exec
BEGIN TRAN; INSERT INTO txn_test_tbl (id, name) VALUES (2, 'rollback_test'); ROLLBACK
----

# Clean up.

exec
DROP TABLE txn_test_tbl
----

# --- SET TRANSACTION ISOLATION LEVEL ---
# These succeed because the executor catch-all silently acknowledges SET commands.

exec
SET TRANSACTION ISOLATION LEVEL READ COMMITTED
----

exec
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE
----

exec
SET TRANSACTION ISOLATION LEVEL SNAPSHOT
----

# --- @@TRANCOUNT (outside transaction, returns 0) ---

query
SELECT @@TRANCOUNT
----
0

# --- XACT_ABORT (caught by SET catch-all, silently acknowledged) ---

exec
SET XACT_ABORT ON
----
