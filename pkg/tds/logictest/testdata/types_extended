# === CONVERT with various type mappings ===

# INT to VARCHAR.
query
SELECT CONVERT(VARCHAR, 12345)
----
12345

# VARCHAR to INT.
query
SELECT CONVERT(INT, '54321')
----
54321

# FLOAT to INT (truncation).
query
SELECT CONVERT(INT, 3.7)
----
4

# INT to FLOAT.
query
SELECT CONVERT(FLOAT, 42)
----
42

# CONVERT with style parameter (style is dropped in translation).
query
SELECT CONVERT(VARCHAR, 12345, 1)
----
12345

# === IDENTITY columns ===

# IDENTITY(seed, increment) is translated to GENERATED BY DEFAULT AS IDENTITY.
exec
CREATE TABLE identity_test (id INT IDENTITY(1,1), name VARCHAR(50))
----

exec
INSERT INTO identity_test (name) VALUES ('alice')
----

exec
INSERT INTO identity_test (name) VALUES ('bob')
----

query colnames
SELECT id, name FROM identity_test ORDER BY id
----
id  name
1  alice
2  bob

# === DEFAULT values ===

# DEFAULT expressions are parsed and translated. GETDATE() becomes now().
exec
CREATE TABLE default_test (id INT, status INT DEFAULT 0)
----

exec
INSERT INTO default_test (id) VALUES (1)
----

query colnames
SELECT id, status FROM default_test WHERE id = 1
----
id  status
1  0

# === Computed columns ===

# Computed columns (col AS expr) — translated to STORED generated columns
# with inferred type. CockroachDB requires "col_name TYPE AS (expr) STORED".
exec
CREATE TABLE computed_test (price INT, qty INT, total AS price * qty)
