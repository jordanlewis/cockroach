# Extended type system tests: datetime variants, money, special types.
# Sources: T-SQL reference documentation, go-mssqldb tests (BSD-3-Clause).

# === DATETIME types ===

# Create table with all datetime variants.
exec
CREATE TABLE dt_types (id INT, dt DATETIME, dt2 DATETIME2, sdt SMALLDATETIME, d DATE, t TIME, dto DATETIMEOFFSET)
----

# Insert with DATETIME literal.
exec
INSERT INTO dt_types (id, dt) VALUES (1, '2026-06-15 14:30:00')
----

# Note: Querying DATETIME columns directly produces TDS binary-encoded
# datetime values that the logictest framework doesn't yet decode properly.
# Verify the insert succeeded by selecting the id.
query
SELECT id FROM dt_types WHERE id = 1
----
1

# === MONEY types ===

# Create table with money types (mapped to DECIMAL).
exec
CREATE TABLE money_types (id INT, price MONEY, small_price SMALLMONEY)
----

exec
INSERT INTO money_types (id, price, small_price) VALUES (1, 19.99, 5.50)
----

query colnames
SELECT id, price, small_price FROM money_types WHERE id = 1
----
id  price  small_price
1  19.99  5.5

# === BIT type (mapped to BOOL) ===
# BIT maps to BOOL in CockroachDB. T-SQL uses 1/0 for bit values
# but CockroachDB expects boolean literals. Inserting 1/0 fails.

exec
CREATE TABLE bit_test (id INT, flag BIT)
----

exec error=(value type int doesn't match type bool)
INSERT INTO bit_test (id, flag) VALUES (1, 1)
----

# Use CONVERT to explicitly cast INT to BIT (BOOL).
exec
INSERT INTO bit_test (id, flag) VALUES (1, CONVERT(BIT, 1))
----

exec
INSERT INTO bit_test (id, flag) VALUES (2, CONVERT(BIT, 0))
----

query colnames
SELECT id, flag FROM bit_test ORDER BY id
----
id  flag
1  true
2  false

