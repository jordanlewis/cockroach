# Subquery and derived table tests.
# Sources: T-SQL reference documentation, Babelfish test patterns (Apache 2.0).
# Most subqueries require parser support for nested SELECTs.

# Set up test data.
exec
CREATE TABLE sq_emp (id INT, name VARCHAR(50), dept VARCHAR(20), salary INT)
----

exec
INSERT INTO sq_emp (id, name, dept, salary) VALUES (1, 'alice', 'eng', 100)
----

exec
INSERT INTO sq_emp (id, name, dept, salary) VALUES (2, 'bob', 'eng', 120)
----

exec
INSERT INTO sq_emp (id, name, dept, salary) VALUES (3, 'carol', 'sales', 90)
----

exec
INSERT INTO sq_emp (id, name, dept, salary) VALUES (4, 'dave', 'sales', 110)
----

# --- Scalar subquery in SELECT ---

query
SELECT name, (SELECT MAX(salary) FROM sq_emp) AS max_sal FROM sq_emp WHERE id = 1
----
alice  120

# --- Subquery in WHERE with IN ---

query
SELECT name FROM sq_emp WHERE dept IN (SELECT DISTINCT dept FROM sq_emp WHERE salary > 100) ORDER BY name
----
alice
bob
carol
dave

# --- Correlated subquery ---

query
SELECT name, salary FROM sq_emp e WHERE salary = (SELECT MAX(salary) FROM sq_emp WHERE dept = e.dept) ORDER BY name
----
bob  120
dave  110

# --- EXISTS subquery ---

query
SELECT name FROM sq_emp e WHERE EXISTS (SELECT 1 FROM sq_emp WHERE dept = e.dept AND salary > e.salary) ORDER BY name
----
alice
carol

# --- NOT EXISTS subquery ---

query
SELECT name FROM sq_emp e WHERE NOT EXISTS (SELECT 1 FROM sq_emp WHERE dept = e.dept AND salary > e.salary) ORDER BY name
----
bob
dave

# --- Derived table (subquery in FROM) ---

query
SELECT d.dept, d.avg_salary FROM (SELECT dept, AVG(salary) AS avg_salary FROM sq_emp GROUP BY dept) d ORDER BY d.dept
----
eng  110
sales  100

# --- Subquery with comparison operators ---

query
SELECT name FROM sq_emp WHERE salary > (SELECT AVG(salary) FROM sq_emp) ORDER BY name
----
bob
dave

# --- ANY / SOME ---

query
SELECT name FROM sq_emp WHERE salary > ANY (SELECT salary FROM sq_emp WHERE dept = 'sales') ORDER BY name
----
alice
bob
dave

# --- ALL ---

query
SELECT name FROM sq_emp WHERE salary >= ALL (SELECT salary FROM sq_emp WHERE dept = 'sales') ORDER BY name
----
bob
dave
