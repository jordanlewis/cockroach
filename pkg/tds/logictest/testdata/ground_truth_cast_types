# Ground-truth CAST/CONVERT type conversion tests from open-source drivers.
#
# Exercises CAST between type families to verify that the TDS frontend
# correctly maps Sybase/SQL Server types to CockroachDB equivalents.
#
# Sources:
#   - go-mssqldb (BSD-3-Clause, github.com/denisenkom/go-mssqldb)
#     File: queries_test.go — type casting matrix
#   - Babelfish (Apache 2.0, github.com/babelfish-for-postgresql/babelfish_extensions)
#     File: test/JDBC/input/datatypes/

# ============================================================
# Integer CAST round-trip
# Source: go-mssqldb queries_test.go (TestSelect)
# ============================================================

query
SELECT CAST(1 AS INT)
----
1

query
SELECT CAST(1 AS BIGINT)
----
1

query
SELECT CAST(1 AS SMALLINT)
----
1

query
SELECT CAST(1 AS TINYINT)
----
1

query
SELECT CAST(1 AS BIT)
----
1

query
SELECT CAST(0 AS BIT)
----
0

