# ============================================================
# Decimal precision
# Source: Babelfish Numeric_Decimal_tests.sql
# ============================================================

# CockroachDB's TDS wire format does not preserve trailing zeros
# in DECIMAL values. CAST(1.0 AS DECIMAL(38,10)) returns 1, not
# 1.0000000000. This matches CockroachDB's internal behavior.
query
SELECT CAST(1.0 AS DECIMAL(38,10))
----
1

query
SELECT CAST(0 AS DECIMAL(10,2))
----
0

query
SELECT CAST(-1.5 AS DECIMAL(10,2))
----
-1.5
