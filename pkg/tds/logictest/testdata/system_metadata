# System tables, metadata views, and system variables tests.
# Sources: T-SQL reference documentation, Babelfish test patterns (Apache 2.0).

# === System variables (@@variables) ===

# @@VERSION — already tested, works (handled by catalog layer).

# @@ROWCOUNT — returns the number of rows affected by the last DML.
# Initially 0 at the start of a session.
query
SELECT @@ROWCOUNT
----
0

# @@ERROR — unsupported @@variable, translated to NULL.
# Returns NULL since the translator uses NULL fallback for unknown @@ vars.
query
SELECT @@ERROR
----
NULL

# @@IDENTITY — returns the last identity value inserted in the session.
# Returns NULL at session start (no prior INSERT with identity column).
query
SELECT @@IDENTITY
----
NULL

# SCOPE_IDENTITY() — equivalent to @@IDENTITY in CockroachDB's TDS layer
# (no nested scopes). Returns NULL at session start.
query
SELECT SCOPE_IDENTITY()
----
NULL

# @@TRANCOUNT — returns the current transaction nesting level.
query
SELECT @@TRANCOUNT
----
0

# @@SPID — returns the server process ID for this connection.
# The exact value depends on connection order, so we validate it is a
# positive integer rather than checking a specific value.
query
SELECT CASE WHEN @@SPID > 0 THEN 'ok' ELSE 'fail' END
----
ok

# @@SERVERNAME — returns the server's hostname.
query
SELECT CASE WHEN @@SERVERNAME IS NOT NULL THEN 'ok' ELSE 'fail' END
----
ok

# @@LANGUAGE — returns the current language setting.
query
SELECT @@LANGUAGE
----
us_english

# @@MAX_CONNECTIONS — returns the maximum number of simultaneous connections.
query
SELECT @@MAX_CONNECTIONS
----
32767

# === Legacy system tables (sysobjects, syscolumns, sysusers) ===
# These are caught by the catalog layer and translated to pg_catalog queries.

exec
CREATE TABLE sysobj_test (id INT NOT NULL, val VARCHAR(50))
----

# sysobjects query with ORDER BY name — verifies that bare column
# references in ORDER BY are translated correctly. The relname value
# from pg_class comes through as a quoted name type.
query
SELECT name FROM sysobjects WHERE type = 'U' AND sysobjects.name = 'sysobj_test' ORDER BY name
----
'sysobj_test'

exec
DROP TABLE sysobj_test
----

# === sp_ system procedures ===

# sp_help and sp_helpdb are handled by catalog layer.
# EXEC/EXECUTE prefix is optional for sp_ procs in the catalog regex.

# sp_tables — returns table metadata from information_schema.tables.
# Uses exec (not query) because the result set depends on tables
# created by prior tests when running the full suite.
exec
EXEC sp_tables
----

# sp_columns — returns column metadata for a specific table.
# Uses exec because the column list depends on runtime state.
exec
EXEC sp_columns 'test_tbl'
----

# sp_helptext — returns the source text of a view or routine.
# 'sp_help' is not an actual view or routine in CockroachDB, so this
# returns an empty result set.
exec
EXEC sp_helptext 'sp_help'
----

# === Dynamic SQL ===

# sp_executesql — executes the given SQL string dynamically.
query
EXEC sp_executesql N'SELECT 1'
----
1
