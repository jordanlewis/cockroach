# Extended DML tests: INSERT...SELECT, multi-row INSERT, MERGE, OUTPUT.
# Sources: T-SQL reference documentation, go-mssqldb test patterns (BSD-3).

# Set up test data for DML operations.
exec
CREATE TABLE src_tbl (id INT, val VARCHAR(50))
----

exec
INSERT INTO src_tbl (id, val) VALUES (1, 'alpha')
----

exec
INSERT INTO src_tbl (id, val) VALUES (2, 'beta')
----

exec
INSERT INTO src_tbl (id, val) VALUES (3, 'gamma')
----

# dst_tbl needs a PRIMARY KEY on id for MERGE (ON CONFLICT) support.
exec
CREATE TABLE dst_tbl (id INT NOT NULL, val VARCHAR(50))
----

exec
ALTER TABLE dst_tbl ADD CONSTRAINT pk_dst PRIMARY KEY (id)
----

# --- Multi-row INSERT (single VALUES with multiple rows) ---

exec
CREATE TABLE multi_ins (id INT, name VARCHAR(50))
----

exec
INSERT INTO multi_ins (id, name) VALUES (1, 'one'), (2, 'two'), (3, 'three')
----

query colnames
SELECT id, name FROM multi_ins ORDER BY id
----
id  name
1  one
2  two
3  three

# --- INSERT ... SELECT ---

exec
INSERT INTO dst_tbl (id, val) SELECT id, val FROM src_tbl WHERE id <= 2
----

query colnames
SELECT id, val FROM dst_tbl ORDER BY id
----
id  val
1  alpha
2  beta

# --- MERGE statement ---
# MERGE translates to INSERT ... ON CONFLICT DO UPDATE SET ...
# This requires a unique constraint on the conflict columns (id has PK).

exec
MERGE INTO dst_tbl AS target USING src_tbl AS source ON target.id = source.id WHEN MATCHED THEN UPDATE SET val = source.val WHEN NOT MATCHED THEN INSERT (id, val) VALUES (source.id, source.val)
----

# After MERGE: id=1,2 updated (same vals), id=3 inserted.
query colnames
SELECT id, val FROM dst_tbl ORDER BY id
----
id  val
1  alpha
2  beta
3  gamma

# --- OUTPUT clause on INSERT ---
# OUTPUT inserted.col translates to RETURNING col.

exec
INSERT INTO dst_tbl (id, val) OUTPUT inserted.id, inserted.val VALUES (10, 'test')
----

# --- OUTPUT clause on DELETE ---

exec
DELETE FROM src_tbl OUTPUT deleted.id, deleted.val WHERE id = 3
----

# --- OUTPUT clause on UPDATE ---

exec
UPDATE src_tbl SET val = 'updated' OUTPUT inserted.id, inserted.val WHERE id = 1
----

# --- UPDATE with FROM/JOIN (T-SQL extension) ---
# UPDATE target SET col = expr FROM target alias JOIN other ON ...

exec
UPDATE dst_tbl SET val = s.val FROM dst_tbl d INNER JOIN src_tbl s ON d.id = s.id
----

# --- DELETE with JOIN (T-SQL extension) ---
# DELETE alias FROM target alias JOIN other ON ... WHERE ...
# src_tbl currently has (1, 'updated'), (2, 'beta').

exec
DELETE d FROM dst_tbl d INNER JOIN src_tbl s ON d.id = s.id WHERE s.val = 'beta'
----

# After DELETE...JOIN: dst_tbl id=2 was deleted (matched s.val = 'beta').
query colnames
SELECT COUNT(*) AS cnt FROM dst_tbl WHERE id = 2
----
cnt
0
