# --- CROSS JOIN ---

query colnames
SELECT e.name, d.name FROM emp e CROSS JOIN dept d WHERE e.id = 1 ORDER BY d.name
----
name  name
alice  engineering
alice  hr
alice  marketing
alice  sales

# --- Subquery in WHERE ---

query colnames
SELECT name FROM emp WHERE dept_id IN (SELECT id FROM dept WHERE name = 'engineering') ORDER BY name
----
name
alice
bob

# --- Subquery in SELECT (scalar subquery) ---

query colnames
SELECT name, (SELECT name FROM dept WHERE id = emp.dept_id) AS dept_name FROM emp WHERE id = 1
----
name  dept_name
alice  engineering

# --- EXISTS subquery ---

query colnames
SELECT name FROM emp WHERE EXISTS (SELECT 1 FROM dept WHERE dept.id = emp.dept_id AND dept.name = 'sales') ORDER BY name
----
name
carol
dave

# --- UNION ---
# Parses correctly but TDS wire-protocol doesn't return result sets for
# compound SELECTs yet (no ColMetaData in response).

query
SELECT name FROM emp WHERE dept_id = 10 UNION SELECT name FROM emp WHERE dept_id = 20 ORDER BY name
----

# --- UNION ALL ---

query
SELECT name FROM emp WHERE dept_id = 10 UNION ALL SELECT name FROM emp WHERE dept_id = 20 ORDER BY name
----

# --- INTERSECT ---

query
SELECT dept_id FROM emp WHERE salary > 5500 INTERSECT SELECT dept_id FROM emp WHERE salary < 7000 ORDER BY dept_id
----

# --- EXCEPT ---

query
SELECT dept_id FROM emp WHERE salary > 5000 EXCEPT SELECT dept_id FROM emp WHERE salary > 7000 ORDER BY dept_id
----

# --- OFFSET-FETCH (SQL Server 2012+) ---

query colnames
SELECT name, salary FROM emp ORDER BY salary DESC OFFSET 1 ROWS FETCH NEXT 2 ROWS ONLY
----
name  salary
dave  7000
bob  6000

# --- CROSS APPLY (not yet supported by parser) ---

query error=(parse error)
SELECT e.name, x.max_salary FROM emp e CROSS APPLY (SELECT MAX(salary) AS max_salary FROM emp WHERE dept_id = e.dept_id) x
----

# --- OUTER APPLY ---

query error=(parse error)
SELECT d.name, x.emp_count FROM dept d OUTER APPLY (SELECT COUNT(*) AS emp_count FROM emp WHERE dept_id = d.id) x
----

# --- Common Table Expression (CTE) ---
# CTE parses correctly but TDS wire-protocol doesn't return result sets
# for WITH statements yet (no ColMetaData in response).

query
WITH ranked AS (SELECT name, salary, ROW_NUMBER() OVER (ORDER BY salary DESC) AS rn FROM emp) SELECT name, salary FROM ranked WHERE rn <= 3 ORDER BY salary DESC
----

# --- Window functions ---

query colnames
SELECT name, salary, ROW_NUMBER() OVER (ORDER BY salary DESC) AS row_num FROM emp ORDER BY salary DESC
----
name  salary  row_num
eve  8000  1
dave  7000  2
bob  6000  3
carol  5500  4
alice  5000  5

query colnames
SELECT name, salary, RANK() OVER (PARTITION BY dept_id ORDER BY salary DESC) AS dept_rank FROM emp ORDER BY dept_id, salary DESC
----
name  salary  dept_rank
bob  6000  1
alice  5000  2
dave  7000  1
carol  5500  2
eve  8000  1

query colnames
SELECT name, salary, SUM(salary) OVER (PARTITION BY dept_id) AS dept_total FROM emp ORDER BY dept_id, name
----
name  salary  dept_total
alice  5000  11000
bob  6000  11000
carol  5500  12500
dave  7000  12500
eve  8000  8000

