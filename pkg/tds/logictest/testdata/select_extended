# --- INNER JOIN ---

query colnames
SELECT e.name, d.name AS dept FROM emp e INNER JOIN dept d ON e.dept_id = d.id ORDER BY e.name
----
name  dept
alice  engineering
bob  engineering
carol  sales
dave  sales
eve  marketing

# --- LEFT JOIN ---

query colnames
SELECT d.name, e.name FROM dept d LEFT JOIN emp e ON d.id = e.dept_id ORDER BY d.name, e.name
----
name  name
engineering  alice
engineering  bob
hr  NULL
marketing  eve
sales  carol
sales  dave

# --- RIGHT JOIN ---

query colnames
SELECT e.name, d.name FROM emp e RIGHT JOIN dept d ON e.dept_id = d.id ORDER BY d.name, e.name
