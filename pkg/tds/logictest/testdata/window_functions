# ============================================================
# SUM() OVER — running total
# ============================================================

query colnames
SELECT name, salary, SUM(salary) OVER (ORDER BY salary) AS running_total FROM wf_data ORDER BY salary
----
name  salary  running_total
frank  65000  65000
dave  70000  135000
eve  75000  210000
alice  80000  290000
carol  85000  375000
bob  90000  465000

# ============================================================
# SUM() OVER with PARTITION BY — per-department totals
# ============================================================

query colnames
SELECT dept, name, salary, SUM(salary) OVER (PARTITION BY dept) AS dept_total FROM wf_data ORDER BY dept, name
----
dept  name  salary  dept_total
eng  alice  80000  255000
eng  bob  90000  255000
eng  carol  85000  255000
hr  frank  65000  65000
sales  dave  70000  145000
sales  eve  75000  145000

