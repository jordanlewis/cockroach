# ============================================================
# Basic table creation with integer types
# Source: jamdb_sybase table_desc() — all integer column defs
# ============================================================

exec
CREATE TABLE gt_int_types (
  c_bigint BIGINT NOT NULL,
  c_int INT NOT NULL,
  c_smallint SMALLINT NOT NULL,
  c_tinyint TINYINT NOT NULL
)
----

exec
INSERT INTO gt_int_types VALUES (9223372036854775807, 2147483647, 32767, 255)
----

query colnames
SELECT c_bigint, c_int, c_smallint, c_tinyint FROM gt_int_types
----
c_bigint  c_int  c_smallint  c_tinyint
9223372036854775807  2147483647  32767  255

exec
DROP TABLE gt_int_types
----

