# Aggregates with GROUP BY.
query colnames
SELECT user_id, COUNT(*) AS order_count, SUM(quantity * price) AS total_spend FROM orders GROUP BY user_id ORDER BY user_id
----
user_id  order_count  total_spend
1  2  55
2  2  80

# HAVING filter.
query colnames
SELECT user_id, SUM(quantity * price) AS total FROM orders GROUP BY user_id HAVING SUM(quantity * price) > 60
----
user_id  total
2  80

# CASE expression.
query colnames
