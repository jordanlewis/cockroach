# === Math functions ===

# CEILING (should pass through).
query
SELECT CEILING(4.2)
----
5

# FLOOR (should pass through).
query
SELECT FLOOR(4.8)
----
4

# ROUND — pass-through. Note: T-SQL float literals pass through as
# CRDB floats; ROUND on floats may produce different precision than
# T-SQL. Use integer-result ROUND to verify the function works.
query
SELECT ROUND(4.5, 0)
----
5

# POWER (should pass through).
query
SELECT POWER(2, 10)
----
1024

# SQRT (pass through, needs explicit float for CRDB).
# Note: T-SQL float literal 144.0 becomes "144" via %g formatting,
# causing ambiguous call. Use CONVERT to explicitly cast.
query
SELECT SQRT(CONVERT(FLOAT, 144))
----
12

# SIGN (should pass through).
query
SELECT SIGN(-5)
----
-1

# LOG — T-SQL LOG() is natural log, but CRDB's log() is base-10.
# This semantic mismatch means LOG passes through but returns wrong
# results. Needs translation to ln(). Also needs explicit DECIMAL
# cast because CRDB's log() is ambiguous on int.
query error=(ambiguous call)
SELECT LOG(10)
----

# LOG10 — base-10 log (unknown function in CRDB).
query error=(unknown function)
SELECT LOG10(1000)
----

