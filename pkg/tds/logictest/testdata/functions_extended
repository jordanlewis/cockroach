# Extended T-SQL function tests.
# Sources: T-SQL reference documentation, go-mssqldb tests (BSD-3-Clause),
# Babelfish test patterns (Apache 2.0).

# === Functions that currently work (pass-through to CockroachDB) ===

# UPPER / LOWER (pass-through, already tested in functions file).

# COUNT, SUM, MIN, MAX, AVG (pass-through, already tested in aggregates file).

# COALESCE (standard SQL, should pass through).
query
SELECT COALESCE(NULL, NULL, 'third')
----
third

# ABS (pass-through).
query
SELECT ABS(-42)
----
42

# === String functions — need translation or pass-through ===

# LEN (T-SQL) — not yet translated to length().
query error=(unknown function)
SELECT LEN('hello')
----

# CHARINDEX — T-SQL string search function.
query error=(unknown function)
SELECT CHARINDEX('world', 'hello world')
----

# PATINDEX — pattern index search.
query error=(unknown function)
SELECT PATINDEX('%world%', 'hello world')
----

# STUFF — insert string at position.
query error=(unknown function)
SELECT STUFF('hello world', 6, 5, 'there')
----

# LEFT — left substring (passes through to CockroachDB).
query
SELECT LEFT('hello', 3)
----
hel

# RIGHT — right substring (passes through to CockroachDB).
query
SELECT RIGHT('hello', 3)
----
llo

# SUBSTRING (standard SQL, should work in CockroachDB).
query
SELECT SUBSTRING('hello world', 7, 5)
----
world

# REPLACE (should pass through to CockroachDB).
query
SELECT REPLACE('hello world', 'world', 'there')
----
hello there

# LTRIM / RTRIM (should pass through).
query
SELECT LTRIM('  hello')
----
hello

query
SELECT RTRIM('hello  ')
----
hello

# REPLICATE — repeat string N times.
query error=(unknown function)
SELECT REPLICATE('ab', 3)
----

# REVERSE — reverse string.
query
SELECT REVERSE('hello')
----
olleh

# SPACE — generate N spaces.
query error=(unknown function)
SELECT SPACE(5)
----

# STRING_AGG (SQL Server 2017+) — aggregate concatenation.
# Parser doesn't support subqueries in FROM (UNION ALL).
query error=(parse error)
SELECT STRING_AGG(name, ', ') FROM (SELECT 'alice' AS name UNION ALL SELECT 'bob') t
----

# CONCAT — standard string concat.
query
SELECT CONCAT('hello', ' ', 'world')
----
hello world

