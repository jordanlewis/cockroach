# Extended T-SQL function tests.
# Sources: T-SQL reference documentation, go-mssqldb tests (BSD-3-Clause),
# Babelfish test patterns (Apache 2.0).

# === Functions that currently work (pass-through to CockroachDB) ===

# UPPER / LOWER (pass-through, already tested in functions file).

# COUNT, SUM, MIN, MAX, AVG (pass-through, already tested in aggregates file).

# COALESCE (standard SQL, should pass through).
query
SELECT COALESCE(NULL, NULL, 'third')
----
third

# ABS (pass-through).
query
SELECT ABS(-42)
----
42

# === String functions — need translation or pass-through ===

# LEN (T-SQL) → length().
query
SELECT LEN('hello')
----
5

# CHARINDEX — T-SQL string search function.
# CHARINDEX(substr, str) → strpos(str, substr) (args swapped).
query
SELECT CHARINDEX('world', 'hello world')
----
7

# PATINDEX — pattern index search → strpos approximation.
# This is a lossy translation: SQL wildcards in the pattern are passed
# literally to strpos, so '%world%' searches for the literal string.
# Returns 0 (not found) because of the wildcards.
query
SELECT PATINDEX('%world%', 'hello world')
----
0

# STUFF — insert string at position → overlay(). STUFF(str, start, len, insert)
# replaces len chars from start with insert. Here: chars 6-10 (' worl') → 'there'.
query
SELECT STUFF('hello world', 6, 5, 'there')
----
hellothered

# LEFT — left substring (passes through to CockroachDB).
query
SELECT LEFT('hello', 3)
----
hel

# RIGHT — right substring (passes through to CockroachDB).
query
SELECT RIGHT('hello', 3)
----
llo

# SUBSTRING (standard SQL, should work in CockroachDB).
query
SELECT SUBSTRING('hello world', 7, 5)
----
world

# REPLACE (should pass through to CockroachDB).
query
SELECT REPLACE('hello world', 'world', 'there')
----
hello there

# LTRIM / RTRIM (should pass through).
query
SELECT LTRIM('  hello')
----
hello

query
SELECT RTRIM('hello  ')
----
hello

# REPLICATE — repeat string N times → repeat().
query
SELECT REPLICATE('ab', 3)
----
ababab

# REVERSE — reverse string.
query
SELECT REVERSE('hello')
----
olleh

# SPACE — generate N spaces → repeat(' ', n).
# Verify via LEN since bare spaces are hard to assert in test output.
query
SELECT LEN(SPACE(5))
----
5

# STRING_AGG (SQL Server 2017+) — aggregate concatenation with
# derived table using UNION ALL.
query
SELECT STRING_AGG(name, ', ') FROM (SELECT 'alice' AS name UNION ALL SELECT 'bob') t
----
alice, bob

# CONCAT — standard string concat.
query
SELECT CONCAT('hello', ' ', 'world')
----
hello world

# === Date/time functions ===

# GETDATE() — already works, tested in functions file.

# DATEADD — add interval to date → timestamptz arithmetic.
query
SELECT DATEADD(day, 1, '2026-01-01')
----
2026-01-02 00:00:00+00

# DATEDIFF — difference between dates → epoch extraction.
query
SELECT DATEDIFF(day, '2026-01-01', '2026-01-31')
----
30

# DATEPART — extract part of date → EXTRACT().
query
SELECT DATEPART(year, '2026-06-15')
----
2026

# DATENAME — name of date part → to_char().
query
SELECT DATENAME(month, '2026-06-15')
----
June

# YEAR / MONTH / DAY — shorthand date part extraction → EXTRACT().
query
SELECT YEAR('2026-06-15')
----
2026

query
SELECT MONTH('2026-06-15')
----
6

query
SELECT DAY('2026-06-15')
----
15

# SYSDATETIME (SQL Server 2008+) → now().
# Verify translation produces valid SQL (can't assert exact value).
query
SELECT DATEPART(year, SYSDATETIME())
----
2026

# GETUTCDATE — UTC version of GETDATE → now() AT TIME ZONE 'UTC'.
# Verify translation produces valid SQL (can't assert exact value).
query
SELECT DATEPART(year, GETUTCDATE())
----
2026

# EOMONTH — end of month → date_trunc arithmetic.
query
SELECT EOMONTH('2026-02-15')
----
2026-02-28

# FORMAT — T-SQL FORMAT(value, fmt) → to_char(value, fmt).
# CRDB's to_char doesn't support .NET-style format strings like 'N2',
# so the format string passes through literally. Lossy translation.
query
SELECT FORMAT(1234567, 'N2')
----
N2

# === Math functions ===

# CEILING (should pass through).
query
SELECT CEILING(4.2)
----
5

# FLOOR (should pass through).
query
SELECT FLOOR(4.8)
----
4

# ROUND — pass-through. Note: T-SQL float literals pass through as
# CRDB floats; ROUND on floats may produce different precision than
# T-SQL. Use integer-result ROUND to verify the function works.
query
SELECT ROUND(4.5, 0)
----
5

# POWER (should pass through).
query
SELECT POWER(2, 10)
----
1024

# SQRT (pass through, needs explicit float for CRDB).
# Note: T-SQL float literal 144.0 becomes "144" via %g formatting,
# causing ambiguous call. Use CONVERT to explicitly cast.
query
SELECT SQRT(CONVERT(FLOAT, 144))
----
12

# SIGN (should pass through).
query
SELECT SIGN(-5)
----
-1

# LOG — T-SQL LOG(x) is natural log → ln(x).
query
SELECT LOG(CONVERT(FLOAT, 1))
----
0

# LOG10 — base-10 log → log(x) in CRDB.
query
SELECT LOG10(CONVERT(FLOAT, 1000))
----
3

# === Conditional functions ===

# IIF (SQL Server 2012+) — inline IF → CASE WHEN.
query
SELECT IIF(1 = 1, 'yes', 'no')
----
yes

# CHOOSE (SQL Server 2012+) — index-based choice → CASE.
query
SELECT CHOOSE(2, 'first', 'second', 'third')
----
second

# NULLIF (standard SQL, should work).
query
SELECT NULLIF(1, 1)
----
NULL

query
SELECT NULLIF(1, 2)
----
1

# === Type conversion ===

# CAST — standard SQL syntax: CAST(expr AS type).
query
SELECT CAST(42 AS VARCHAR)
----
42

# TRY_CONVERT (SQL Server 2012+) — translates to try_cast(), but
# CockroachDB does not support try_cast syntax.
query error=(syntax error)
SELECT TRY_CONVERT(INT, 'not_a_number')
----

# TRY_CAST (SQL Server 2012+) — safe conversion, returns NULL on failure.
query
SELECT TRY_CAST('not_a_number' AS INT)
----
NULL

# === System functions ===

# NEWID — generate UUID → gen_random_uuid().
# Can't assert exact value; verify it returns a non-null UUID.
query
SELECT LEN(CONVERT(VARCHAR(36), NEWID()))
----
36

# OBJECT_ID — get object ID by name → NULL stub.
query
SELECT OBJECT_ID('users')
----
NULL

# DB_NAME — current database name → current_database().
query
SELECT DB_NAME()
----
defaultdb

# SCHEMA_NAME — current schema name → current_schema().
query
SELECT SCHEMA_NAME()
----
public

# USER_NAME — current user → current_user.
query
SELECT USER_NAME()
----
node

# HOST_NAME — client host → NULL stub (no CRDB equivalent).
query
SELECT HOST_NAME()
----
NULL

# APP_NAME — application name → current_setting('application_name').
# The TDS executor uses internal SQL execution, so the app name is
# the internal executor prefix, not a client-set value.
query
SELECT APP_NAME()
----
$ internal-tds-select

# === Aggregate functions (extended) ===

# COUNT_BIG — 64-bit count → count().
exec
CREATE TABLE count_big_test (id INT NOT NULL)
----

exec
INSERT INTO count_big_test (id) VALUES (1), (2), (3)
----

query
SELECT COUNT_BIG(*) FROM count_big_test
----
3

exec
DROP TABLE count_big_test
----

# STDEV — standard deviation → stddev().
# stddev on a single value returns NULL.
exec
CREATE TABLE stdev_test (val INT NOT NULL)
----

exec
INSERT INTO stdev_test (val) VALUES (1), (2), (3)
----

query
SELECT STDEV(val) FROM stdev_test
----
1

exec
DROP TABLE stdev_test
