# === Type conversion ===

# CAST — standard SQL (parser treats CAST as a function call, but
# the AS keyword inside the parens causes a parse error).
query error=(parse error)
SELECT CAST(42 AS VARCHAR)
----

# TRY_CONVERT (SQL Server 2012+) — safe conversion.
# Parser treats TRY_CONVERT as a function call with two args.
# Passes through to CRDB which doesn't have TRY_CONVERT.
query error=(unknown function)
SELECT TRY_CONVERT(INT, 'not_a_number')
----

# TRY_CAST (SQL Server 2012+).
# Parser treats TRY_CAST as a function call but AS inside parens
# causes a parse error (AS is a keyword, not valid in expression).
query error=(parse error)
SELECT TRY_CAST('not_a_number' AS INT)
----

