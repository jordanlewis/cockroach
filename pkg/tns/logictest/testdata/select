# -- ROWNUM (→ LIMIT) --

query
SELECT first_name FROM lt_sel WHERE ROWNUM <= 3 ORDER BY id
----
FIRST_NAME
Alice
Bob
Carol

query
SELECT first_name FROM lt_sel WHERE ROWNUM < 3 ORDER BY id
----
FIRST_NAME
Alice
Bob

# -- ROWNUM with AND --
# Bug: ROWNUM limit extraction with AND produces wrong results because
# LIMIT is applied after WHERE filtering in CockroachDB, but the
# extraction removes ROWNUM from WHERE, keeping only "age > 25".
# The LIMIT 2 then applies to the ORDER BY result, giving Alice and Carol
# (first two by id with age>25), not the first two Oracle-style.

query
SELECT first_name FROM lt_sel WHERE age > 25 AND ROWNUM <= 2 ORDER BY id
----
FIRST_NAME
Alice
Carol

# -- SELECT * --

query
SELECT * FROM lt_sel WHERE id = 1
----
ID FIRST_NAME LAST_NAME AGE
1 Alice Smith 30

# -- WHERE with string comparison --

query
SELECT id, first_name FROM lt_sel WHERE first_name = 'Bob'
----
ID FIRST_NAME
2 Bob

# -- WHERE with OR --
# Bob(25): 25<28=T, Carol(35): 35>33=T. Dave(28): 28<28=F, 28>33=F.

query
SELECT id FROM lt_sel WHERE age < 28 OR age > 33 ORDER BY id
----
ID
2
3

