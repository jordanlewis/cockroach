# Expression tests for Oracle SQL through TNS.
# Arithmetic, comparisons, string concatenation, BETWEEN, IN, LIKE.

# -- Arithmetic --

query
SELECT 1 + 2 FROM DUAL
----
?COLUMN?
3

query
SELECT 10 - 3 FROM DUAL
----
?COLUMN?
7

query
SELECT 4 * 5 FROM DUAL
----
?COLUMN?
20

# Bug(co-4ov): NUMBER → DECIMAL means integer division returns full precision.
query
SELECT 10 / 2 FROM DUAL
----
?COLUMN?
5.0000000000000000000

# -- String concatenation (Oracle uses ||) --

query
SELECT 'foo' || 'bar' FROM DUAL
----
?COLUMN?
foobar

# Bug(co-0w4): multi-word string results get quotes.
query
SELECT 'hello' || ' ' || 'world' FROM DUAL
----
?COLUMN?
'hello world'

