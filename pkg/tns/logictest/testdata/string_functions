# String function tests for Oracle SQL through TNS.
# Tests Oracle-specific function mappings (LENGTHB, INSTR) and
# passthrough functions (LPAD, RPAD, LTRIM, RTRIM, INITCAP, CHR, ASCII).
#
# LENGTHB → octet_length (explicit mapFuncName mapping)
# INSTR   → strpos (explicit mapFuncName mapping)
# Others  → lowercase passthrough (CockroachDB has native equivalents)

# -- LENGTHB (byte length) → octet_length --

query
SELECT LENGTHB('hello') FROM DUAL
----
LENGTHB
5

query
SELECT LENGTHB('') FROM DUAL
----
LENGTHB
0

query
SELECT LENGTHB('a') FROM DUAL
----
LENGTHB
1

# -- INSTR (find position) → strpos --
# Note: Oracle INSTR returns 1-based position; strpos also returns 1-based.

query
SELECT INSTR('hello world', 'world') FROM DUAL
----
INSTR
7

query
SELECT INSTR('hello', 'xyz') FROM DUAL
----
INSTR
0

query
SELECT INSTR('abcabc', 'bc') FROM DUAL
----
INSTR
2

# -- LPAD (left-pad) --

query
SELECT LPAD('5', 3, '0') FROM DUAL
----
LPAD
005

query
SELECT LPAD('hello', 10, '*') FROM DUAL
----
LPAD
*****hello

query
SELECT LPAD('hello', 3, '*') FROM DUAL
----
LPAD
hel

# -- RPAD (right-pad) --

query
SELECT RPAD('5', 3, '0') FROM DUAL
----
RPAD
500

query
SELECT RPAD('hello', 10, '.') FROM DUAL
----
RPAD
hello.....

# -- LTRIM / RTRIM --

query
SELECT LTRIM('   hello') FROM DUAL
----
LTRIM
hello

query
SELECT RTRIM('hello   ') FROM DUAL
----
RTRIM
hello

# -- INITCAP --

query
SELECT INITCAP('hello world') FROM DUAL
----
INITCAP
Hello World

query
SELECT INITCAP('HELLO WORLD') FROM DUAL
----
INITCAP
Hello World

# -- CHR (character from code point) --

query
SELECT CHR(65) FROM DUAL
----
CHR
A

query
SELECT CHR(97) FROM DUAL
----
CHR
a

query
SELECT CHR(48) FROM DUAL
----
CHR
0

# -- ASCII (code point from character) --

query
SELECT ASCII('A') FROM DUAL
----
ASCII
65

query
SELECT ASCII('a') FROM DUAL
----
ASCII
97

query
SELECT ASCII('0') FROM DUAL
----
ASCII
48

# -- String functions with table data --

exec
CREATE TABLE lt_sfunc (id NUMBER, name VARCHAR2(50))
----

exec
INSERT INTO lt_sfunc (id, name) VALUES (1, 'alice')
----

exec
INSERT INTO lt_sfunc (id, name) VALUES (2, 'bob')
----

exec
INSERT INTO lt_sfunc (id, name) VALUES (3, 'carol')
----

query
SELECT id, LPAD(name, 10, '-') FROM lt_sfunc ORDER BY id
----
ID LPAD
1 -----alice
2 -------bob
3 -----carol

query
SELECT id, INITCAP(name) FROM lt_sfunc ORDER BY id
----
ID INITCAP
1 Alice
2 Bob
3 Carol

query
SELECT id, INSTR(name, 'o') FROM lt_sfunc ORDER BY id
----
ID INSTR
1 0
2 2
3 4

query
SELECT id, LENGTHB(name) FROM lt_sfunc ORDER BY id
----
ID LENGTHB
1 5
2 3
3 5

