# Aggregate function tests for Oracle SQL through TNS.
# COUNT, SUM, MIN, MAX, AVG, GROUP BY, HAVING, DISTINCT.

exec
CREATE TABLE lt_sales (id NUMBER, region VARCHAR2(20), product VARCHAR2(20), amount NUMBER)
----

exec
INSERT INTO lt_sales (id, region, product, amount) VALUES (1, 'east', 'widget', 100)
----

exec
INSERT INTO lt_sales (id, region, product, amount) VALUES (2, 'east', 'gadget', 200)
----

exec
INSERT INTO lt_sales (id, region, product, amount) VALUES (3, 'west', 'widget', 150)
----

exec
INSERT INTO lt_sales (id, region, product, amount) VALUES (4, 'west', 'gadget', 300)
----

exec
INSERT INTO lt_sales (id, region, product, amount) VALUES (5, 'east', 'widget', 120)
