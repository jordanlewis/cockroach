# -- COUNT --

query
SELECT COUNT(*) FROM lt_sales
----
COUNT
5

query
SELECT COUNT(*) FROM lt_sales WHERE region = 'east'
----
COUNT
3

# -- SUM --

query
SELECT SUM(amount) FROM lt_sales
----
SUM
870

# -- MIN and MAX --

query
SELECT MIN(amount), MAX(amount) FROM lt_sales
----
MIN MAX
100 300

# -- AVG --
# Bug(co-4ov): NUMBER → DECIMAL means AVG returns full precision.
# Correct Oracle behavior: AVG returns reasonable precision (e.g. 174).

query
SELECT AVG(amount) FROM lt_sales
----
AVG
174

# -- GROUP BY --

query
SELECT region, COUNT(*) FROM lt_sales GROUP BY region ORDER BY region
----
REGION COUNT
east 3
west 2

query
SELECT region, SUM(amount) FROM lt_sales GROUP BY region ORDER BY region
----
REGION SUM
east 420
west 450

# -- GROUP BY multiple columns --

query
SELECT region, product, SUM(amount) FROM lt_sales GROUP BY region, product ORDER BY region, product
----
REGION PRODUCT SUM
east gadget 200
east widget 220
west gadget 300
west widget 150

# -- HAVING --

query
SELECT region, SUM(amount) FROM lt_sales GROUP BY region HAVING SUM(amount) > 430 ORDER BY region
----
REGION SUM
west 450

query
SELECT product, COUNT(*) FROM lt_sales GROUP BY product HAVING COUNT(*) > 2
----
PRODUCT COUNT
widget 3

