# -- INNER JOIN --

query
SELECT c.name, o.product, o.amount FROM lt_customers c INNER JOIN lt_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----
NAME PRODUCT AMOUNT
alice gadget 200
alice widget 100
bob widget 150

# -- LEFT JOIN --

query
SELECT c.name, o.product FROM lt_customers c LEFT JOIN lt_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----
NAME PRODUCT
alice gadget
alice widget
bob widget
carol NULL

# -- RIGHT JOIN --

query
SELECT c.name, o.product FROM lt_customers c RIGHT JOIN lt_orders o ON c.id = o.customer_id ORDER BY o.product, c.name
----
NAME PRODUCT
alice gadget
NULL gizmo
alice widget
bob widget

# -- FULL JOIN --

query
SELECT c.name, o.product FROM lt_customers c FULL JOIN lt_orders o ON c.id = o.customer_id ORDER BY c.name, o.product
----
NAME PRODUCT
NULL gizmo
alice gadget
alice widget
bob widget
carol NULL

