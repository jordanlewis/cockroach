# -- Scalar subquery in SELECT --

query
SELECT name, (SELECT MAX(salary) FROM lt_sub_emp) FROM lt_sub_emp WHERE id = 1
----
NAME MAX
alice 90000

# -- IN subquery --

query
SELECT name FROM lt_sub_dept WHERE id IN (SELECT dept_id FROM lt_sub_emp WHERE salary > 80000) ORDER BY name
----
NAME
engineering

# -- NOT IN subquery --
# Bug(co-an5): NOT IN with subquery returns empty result due to NULL semantics.
# Correct Oracle behavior: all departments with employees exist (depts 1,2,3),
# so no dept is NOT IN the employee dept_id list. This is actually correct behavior
# when all dept_ids are non-NULL. The real Oracle would also return empty here.
# Keeping expected output as empty (correct).

query
SELECT name FROM lt_sub_dept WHERE id NOT IN (SELECT DISTINCT dept_id FROM lt_sub_emp) ORDER BY name
----
NAME

# -- EXISTS subquery --

query
SELECT d.name FROM lt_sub_dept d WHERE EXISTS (SELECT 1 FROM lt_sub_emp e WHERE e.dept_id = d.id AND e.salary > 80000) ORDER BY d.name
----
NAME
engineering

# -- Subquery in FROM clause --
# Bug(co-4ov): DECIMAL precision from AVG.
# Correct Oracle behavior: AVG returns reasonable precision.

query
SELECT sub.dept_id, sub.avg_sal FROM (SELECT dept_id, AVG(salary) AS avg_sal FROM lt_sub_emp GROUP BY dept_id) sub ORDER BY sub.dept_id
----
DEPT_ID AVG_SAL
1 87500
2 72500
3 65000

# -- Correlated subquery --

query
SELECT e.name, e.salary FROM lt_sub_emp e WHERE e.salary > (SELECT AVG(salary) FROM lt_sub_emp e2 WHERE e2.dept_id = e.dept_id) ORDER BY e.name
----
NAME SALARY
alice 90000
dave 75000

