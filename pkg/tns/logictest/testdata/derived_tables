# -- Basic derived table --

query
SELECT sub.id, sub.name FROM (SELECT id, name FROM lt_emp2 WHERE salary > 75000) sub ORDER BY sub.id
----
ID NAME
1 alice
2 bob

# -- Derived table with alias and aggregation --

query
SELECT stats.dept_id, stats.cnt, stats.avg_sal FROM (SELECT dept_id, COUNT(*) AS cnt, AVG(salary) AS avg_sal FROM lt_emp2 GROUP BY dept_id) stats ORDER BY stats.dept_id
----
DEPT_ID CNT AVG_SAL
10 2 85000
20 2 65000

# -- Derived table joined with a regular table --

query
SELECT d.dname, sub.cnt FROM lt_dept2 d INNER JOIN (SELECT dept_id, COUNT(*) AS cnt FROM lt_emp2 GROUP BY dept_id) sub ON d.id = sub.dept_id ORDER BY d.dname
----
DNAME CNT
engineering 2
marketing 2

