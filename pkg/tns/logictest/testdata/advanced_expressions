# Advanced expression tests for Oracle SQL through TNS.
# COALESCE, GREATEST, LEAST, NULLIF, unary negation, NOT EXISTS.
# These functions pass through the translator via default lowercasing
# and are natively supported by CockroachDB.

# -- COALESCE (directly, not via NVL) --

query
SELECT COALESCE(NULL, NULL, 'third') FROM DUAL
----
COALESCE
third

query
SELECT COALESCE('first', 'second', 'third') FROM DUAL
----
COALESCE
first

query
SELECT COALESCE(NULL, 42) FROM DUAL
----
COALESCE
42

# -- GREATEST --

query
SELECT GREATEST(1, 5, 3) FROM DUAL
----
GREATEST
5

query
SELECT GREATEST(10, 20, 30) FROM DUAL
----
GREATEST
30

query
SELECT GREATEST(-1, -5, -3) FROM DUAL
----
GREATEST
-1

# -- LEAST --

query
SELECT LEAST(1, 5, 3) FROM DUAL
----
LEAST
1

query
SELECT LEAST(10, 20, 30) FROM DUAL
----
LEAST
10

query
SELECT LEAST(-1, -5, -3) FROM DUAL
----
LEAST
-5

# -- NULLIF --

query
SELECT NULLIF(1, 1) FROM DUAL
----
NULLIF
NULL

query
SELECT NULLIF(1, 2) FROM DUAL
----
NULLIF
1

query
SELECT NULLIF('same', 'same') FROM DUAL
----
NULLIF
NULL

query
SELECT NULLIF('a', 'b') FROM DUAL
----
NULLIF
a

# -- Unary negation --

query
SELECT -5 FROM DUAL
----
?COLUMN?
-5

query
SELECT -(3 + 2) FROM DUAL
----
?COLUMN?
-5

