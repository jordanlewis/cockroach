# NOT EXISTS: find rows in lt_adv that have no reference in lt_adv2

query
SELECT a.id FROM lt_adv a WHERE NOT EXISTS (SELECT 1 FROM lt_adv2 b WHERE b.ref_id = a.id)
----
ID
2

